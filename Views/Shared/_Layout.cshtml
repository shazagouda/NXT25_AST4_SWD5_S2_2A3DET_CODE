@* =========================================================
   _Layout.cshtml — MASTER LAYOUT
   ========================================================= *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - A3DET CODE</title>
    <meta name="description" content="@(ViewData["Description"] ?? "A3DET CODE — From Learning to Earning. A unified educational and career platform.")" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="icon" type="image/png" href="~/images/favicon.png" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    @* FOUC prevention — apply saved theme before CSS renders *@
    <script>
        (function () {
            var t = localStorage.getItem('a3det-theme');
            if (t) document.documentElement.setAttribute('data-theme', t);
        })();
    </script>

    <link rel="stylesheet" href="~/css/global.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
</head>
<body>

    <!-- ============ NAVBAR ============ -->
    <header class="navbar" id="siteNavbar">
        <div class="navbar-inner">
            <a href="@Url.Action("Index", "Home")" class="brand">
                <span class="brand-mark">A3</span>
                A3DET <span style="color:var(--color-blue-600)">CODE</span>
            </a>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <!-- ====== DESKTOP NAV (Authenticated) ====== -->
                <nav class="nav-links">
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="Admin" asp-action="Dashboard" class="nav-link">Admin Dashboard</a>
                        <a asp-controller="Admin" asp-action="Bookings" class="nav-link">Bookings</a>
                        <a asp-controller="Admin" asp-action="Reports" class="nav-link">Reports</a>
                        <a asp-controller="Admin" asp-action="Users" class="nav-link">Users</a>
                        <a asp-controller="Wallet" asp-action="AdminTransfers" class="nav-link" style="color:var(--color-purple-600); font-weight:600;">Escrow</a>
                    }
                    else
                    {
                        <a asp-controller="Home" asp-action="Projects" class="nav-link">Home</a>
                        <a asp-controller="Dashboard" asp-action="Index" class="nav-link">Dashboard</a>
                        <a asp-controller="Profile" asp-action="Index" class="nav-link">Profile</a>
                        <a asp-controller="Students" asp-action="Index" class="nav-link"><i class="bi bi-people-fill"></i> Students</a>
                        <a asp-controller="Companies" asp-action="Index" class="nav-link">Companies</a>
                        @if (!User.IsInRole("Mentor") && !User.IsInRole("Company"))
                        {
                            <a asp-controller="Assessment" asp-action="Index" class="nav-link">Assessment</a>
                            <a asp-controller="Roadmaps" asp-action="Index" class="nav-link">Tracks</a>
                        }
                       
                        @if (User.IsInRole("Company"))
                        {
                            <a asp-controller="Booking" asp-action="Index" class="nav-link" style="color:var(--color-blue-600); font-weight:600;">Bookings</a>
                        }
                        else if (!User.IsInRole("Mentor"))
                        {
                            <a asp-controller="Mentor" asp-action="Index" class="nav-link" style="color:var(--color-blue-600); font-weight:600;">Book Mentors</a>
                        }
                    }
                </nav>
                <div class="nav-actions">
                    <div class="notif-dropdown-container" style="position: relative;">
                        <button class="nav-icon-btn" id="notifDropdownBtn" aria-label="Notifications" onclick="toggleNotifDropdown(event)">
                            <span class="notif-badge" style="display: none;"></span>
                            <i class="bi bi-bell"></i>
                        </button>
                        <div id="notifDropdownMenu" class="notif-dropdown-menu glass-panel shadow-lg" style="display:none; position:absolute; top:54px; right:-20px; width:340px; z-index:1050;">
                            <div class="p-4 text-center text-muted">
                                <span class="spinner-border spinner-border-sm text-primary" role="status" aria-hidden="true"></span>
                                <div class="mt-2" style="font-size: 13px;">Loading notifications...</div>
                            </div>
                        </div>
                    </div>
                    <!-- Dark mode toggle -->
                    <button class="nav-icon-btn theme-toggle" id="themeToggleBtn" aria-label="Toggle theme">
                        <i class="bi bi-moon-stars-fill"></i>
                    </button>
                    <div class="avatar" title="@User.Identity.Name" onclick="location.href='@Url.Action("Index", "Profile")'">
                        @(User.Identity.Name?.Substring(0, 1).ToUpper() ?? "U")
                    </div>
                    <a asp-controller="Account" asp-action="Logout" class="btn btn-ghost btn-sm">Logout</a>
                </div>
            }
            else
            {
                <!-- ====== DESKTOP NAV (Guest) ====== -->
                <nav class="nav-links">
                    <a asp-controller="Home" asp-action="Index" class="nav-link">Home</a>
                    <a asp-controller="Roadmaps" asp-action="Index" class="nav-link">Tracks</a>
                    <a asp-controller="Mentor" asp-action="Index" class="nav-link">Mentors</a>
                    <a asp-controller="Companies" asp-action="Index" class="nav-link">Companies</a>
                    <a asp-controller="About" asp-action="Index" class="nav-link">About</a>
                    <a asp-controller="ContactUs" asp-action="Index" class="nav-link">Contact Us</a>
                </nav>
                <div class="nav-actions">
                    <!-- Dark mode toggle -->
                    <button class="nav-icon-btn theme-toggle" id="themeToggleBtn" aria-label="Toggle theme">
                        <i class="bi bi-moon-stars-fill"></i>
                    </button>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-ghost btn-sm">Login</a>
                    <a asp-controller="Account" asp-action="SignUp" class="btn btn-primary btn-sm">Sign Up</a>
                </div>
            }

            <button class="mobile-toggle" id="mobileToggle" aria-label="Toggle menu" aria-expanded="false">
                <span></span><span></span><span></span>
            </button>
        </div>

        <!-- ============ MOBILE MENU ============ -->
        <div class="mobile-menu" id="mobileMenu">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <!-- ====== MOBILE NAV (Authenticated) ====== -->
                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Admin" asp-action="Dashboard" class="nav-link">Admin Dashboard</a>
                    <a asp-controller="Admin" asp-action="Bookings" class="nav-link">Bookings</a>
                    <a asp-controller="Admin" asp-action="Reports" class="nav-link">Reports</a>
                    <a asp-controller="Admin" asp-action="Users" class="nav-link">Users</a>
                    <a asp-controller="Wallet" asp-action="AdminTransfers" class="nav-link">Escrow Transfers</a>
                }
                else
                {
                    <a asp-controller="Home" asp-action="Projects" class="nav-link">Home</a>
                    <a asp-controller="Dashboard" asp-action="Index" class="nav-link">Dashboard</a>
                    <a asp-controller="Profile" asp-action="Index" class="nav-link">Profile</a>
                    @if (!User.IsInRole("Mentor") && !User.IsInRole("Company"))
                    {
                        <a asp-controller="Assessment" asp-action="Index" class="nav-link">Assessment</a>
                        <a asp-controller="Roadmaps" asp-action="Index" class="nav-link">Tracks</a>
                    }
                    @if (User.IsInRole("Student"))
                    {
                        <a asp-controller="Students" asp-action="Index" class="nav-link"><i class="bi bi-people-fill"></i> Students</a>
                    }
                }
                <a asp-controller="Account" asp-action="Logout" class="nav-link">Logout</a>
            }
            else
            {
                <!-- ====== MOBILE NAV (Guest) ====== -->
                <a asp-controller="Home" asp-action="Index" class="nav-link">Home</a>
                <a asp-controller="Roadmaps" asp-action="Index" class="nav-link">Tracks</a>
                <a asp-controller="Mentor" asp-action="Index" class="nav-link">Mentors</a>
                <a asp-controller="Companies" asp-action="Index" class="nav-link">Companies</a>
                <a asp-controller="About" asp-action="Index" class="nav-link">About</a>
                <a asp-controller="ContactUs" asp-action="Index" class="nav-link">Contact Us</a>
                <a asp-controller="Account" asp-action="Login" class="nav-link">Login</a>
                <a asp-controller="Account" asp-action="SignUp" class="nav-link">Sign Up</a>
            }
        </div>
    </header>

    <!-- ============ PAGE CONTENT ============ -->
    <main>
        @RenderBody()
    </main>

    <!-- ============ FOOTER ============ -->
    <footer class="footer">
        <div class="container">
            <div class="footer-grid">
                <div class="footer-brand">
                    <a href="@Url.Action("Index", "Home")" class="brand" style="color:#fff;">
                        <span class="brand-mark">A3</span>
                        A3DET CODE
                    </a>
                    <p>From Learning to Earning. A unified educational and career platform turning learners into job-ready professionals through real projects, teams, and industry simulation.</p>
                </div>
                <div>
                    <h4>Platform</h4>
                    <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Roadmaps" ? "active" : "")" asp-controller="Roadmaps" asp-action="Index">Tracks</a>
                    <a asp-controller="Assessment" asp-action="Index">Assessment</a>
                    <a asp-controller="Mentor" asp-action="Index">Mentors</a>
                </div>
                <div>
                    <h4>Company</h4>
                    <a asp-controller="About" asp-action="Index">About Us</a>
                    <a asp-controller="Companies" asp-action="Index">For Companies</a>
                    <a asp-controller="ContactUs" asp-action="Index">Contact Us</a>
                </div>
                <div>
                    <h4>Support</h4>
                    <a href="#">Help Center</a>
                    <a href="#">Privacy Policy</a>
                    <a href="#">Terms of Use</a>
                </div>
            </div>
            <div class="footer-bottom">
                <span>&copy; @DateTime.Now.Year A3DET CODE Platform. All rights reserved.</span>
                <span>Confidential &middot; Built for learners who ship.</span>
            </div>
        </div>
    </footer>

    <script src="~/js/global.js" asp-append-version="true"></script>
    <script>
      // Set is-active on the correct nav link based on current path
      (function () {
        var path = window.location.pathname.toLowerCase();
        document.querySelectorAll('.nav-links .nav-link').forEach(function (a) {
          var href = (a.getAttribute('href') || '').toLowerCase();
          if (!href || href === '#') return;
          // exact match or starts-with (for sub-pages)
          if (path === href || (href !== '/' && path.startsWith(href))) {
            a.classList.add('is-active');
          }
        });
      })();
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>