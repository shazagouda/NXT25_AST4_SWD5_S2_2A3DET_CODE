@model A3DET_CODE.ViewModels.Student.StudentPagedViewModel
@{
    ViewData["Title"] = "Student Directory";
}

@section Styles {
    <link rel="stylesheet" href="~/css/mentors.css" asp-append-version="true" />
    <style>
        /* ── Hero ── */
        .students-hero {
            padding: var(--space-10) 0 var(--space-8);
            background: linear-gradient(135deg, var(--color-navy-900) 0%, var(--color-navy-700) 100%);
            color: #fff;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

            .students-hero::before {
                content: '';
                position: absolute;
                top: -50%;
                right: -20%;
                width: 500px;
                height: 500px;
                border-radius: 50%;
                background: radial-gradient(circle, rgba(47, 111, 237, 0.15) 0%, transparent 70%);
                animation: heroGlow 8s ease-in-out infinite alternate;
            }

        [data-theme="dark"] .students-hero {
            background: linear-gradient(135deg, var(--color-navy-900) 0%, #0a0a0d 100%);
        }

        [data-theme="light"] .students-hero {
            background: linear-gradient(135deg, var(--color-bg) 0%, var(--color-blue-100) 100%);
        }

            [data-theme="light"] .students-hero h1 {
                color: var(--color-text-900);
            }

            [data-theme="light"] .students-hero p {
                color: var(--color-text-600);
            }

        .students-hero-content {
            position: relative;
            z-index: 2;
            max-width: 720px;
            margin: 0 auto;
        }

        .students-hero h1 {
            font-size: var(--fs-h1);
            font-weight: 800;
            margin-bottom: var(--space-4);
        }

            .students-hero h1 .highlight {
                color: var(--color-blue-600);
                position: relative;
            }

                .students-hero h1 .highlight::after {
                    content: '';
                    position: absolute;
                    bottom: -4px;
                    left: 0;
                    right: 0;
                    height: 3px;
                    background: var(--color-blue-600);
                    opacity: 0.4;
                }

        .students-hero p {
            font-size: var(--fs-body-lg);
            color: var(--color-text-400);
            max-width: 560px;
            margin: 0 auto var(--space-6);
            line-height: 1.8;
        }

        .hero-badge {
            display: inline-flex;
            align-items: center;
            gap: var(--space-2);
            font-family: var(--font-mono);
            font-size: var(--fs-xs);
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--color-blue-600);
            background: var(--color-blue-100);
            padding: var(--space-1) var(--space-3);
            border-radius: var(--radius-pill);
            margin-bottom: var(--space-4);
        }

        .students-stats {
            display: flex;
            justify-content: center;
            gap: var(--space-8);
            flex-wrap: wrap;
            position: relative;
            z-index: 2;
            margin-top: var(--space-6);
        }

            .students-stats .stat-number {
                display: block;
                font-size: 1.75rem;
                font-weight: 800;
                color: var(--color-blue-600);
            }

            .students-stats .stat-label {
                font-size: var(--fs-xs);
                opacity: .8;
                color: var(--color-text-500);
            }

        /* ── Filters ── */
        .students-filters {
            background: var(--color-surface);
            border-bottom: 1px solid var(--color-border);
            padding: var(--space-5) 0;
            position: sticky;
            top: 64px;
            z-index: 50;
            box-shadow: var(--shadow-sm);
        }

        .filters-wrapper {
            display: flex;
            gap: var(--space-4);
            align-items: flex-end;
            flex-wrap: wrap;
        }

        .search-box {
            position: relative;
            flex: 1 1 260px;
        }

            .search-box i {
                position: absolute;
                left: 14px;
                top: 50%;
                transform: translateY(-50%);
                color: var(--color-text-400);
                pointer-events: none;
            }

            .search-box input {
                width: 100%;
                padding: var(--space-3) var(--space-4) var(--space-3) 40px;
                border: 1px solid var(--color-border);
                border-radius: var(--radius-pill);
                background: var(--color-bg);
                color: var(--color-text-900);
                font-size: var(--fs-small);
                transition: var(--transition-fast);
            }

                .search-box input:focus {
                    outline: none;
                    border-color: var(--color-blue-600);
                    box-shadow: 0 0 0 3px rgba(47,111,237,.12);
                }

        .filters-dropdowns {
            display: flex;
            gap: var(--space-3);
            flex-wrap: wrap;
            align-items: flex-end;
        }

        .filter-group {
            display: flex;
            flex-direction: column;
            gap: 4px;
            min-width: 160px;
        }

            .filter-group label {
                font-size: var(--fs-xs);
                font-weight: 600;
                color: var(--color-text-400);
                text-transform: uppercase;
                letter-spacing: .04em;
            }

            .filter-group select {
                padding: var(--space-3) var(--space-4);
                border: 1px solid var(--color-border);
                border-radius: var(--radius-md);
                background: var(--color-bg);
                color: var(--color-text-900);
                font-size: var(--fs-small);
                cursor: pointer;
                transition: var(--transition-fast);
            }

                .filter-group select:focus {
                    outline: none;
                    border-color: var(--color-blue-600);
                }

                .filter-group select:disabled {
                    opacity: .4;
                    cursor: not-allowed;
                }

        /* ── Grid ── */
        .students-grid-section {
            padding: var(--space-8) 0;
        }

        .results-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: var(--space-5);
            flex-wrap: wrap;
            gap: var(--space-3);
        }

            .results-bar .results-count {
                font-size: var(--fs-small);
                color: var(--color-text-400);
            }

        .active-filters {
            display: flex;
            gap: var(--space-2);
            flex-wrap: wrap;
        }

        .filter-chip {
            display: inline-flex;
            align-items: center;
            gap: var(--space-2);
            background: var(--color-blue-100);
            color: var(--color-blue-600);
            border: 1px solid rgba(47,111,237,.2);
            border-radius: var(--radius-pill);
            padding: var(--space-1) var(--space-3);
            font-size: var(--fs-xs);
            font-weight: 600;
        }

            .filter-chip a {
                color: inherit;
                text-decoration: none;
                opacity: .7;
            }

                .filter-chip a:hover {
                    opacity: 1;
                }

        .students-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: var(--space-5);
        }

        /* ── Student Card ── */
        .student-card {
            background: var(--color-surface);
            border: 1px solid var(--color-border);
            border-radius: var(--radius-lg);
            padding: var(--space-5);
            transition: var(--transition-base);
            cursor: pointer;
            position: relative;
            overflow: hidden;
        }

            .student-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 4px;
                background: linear-gradient(90deg, var(--color-blue-600), var(--color-teal-600));
                opacity: 0;
                transition: var(--transition-fast);
            }

            .student-card:hover {
                transform: translateY(-4px);
                box-shadow: var(--shadow-lg);
            }

                .student-card:hover::before {
                    opacity: 1;
                }

        .student-top {
            display: flex;
            align-items: center;
            gap: var(--space-3);
            margin-bottom: var(--space-4);
        }

        .student-avatar {
            width: 54px;
            height: 54px;
            border-radius: 50%;
            flex-shrink: 0;
            overflow: hidden;
            background: linear-gradient(135deg, var(--color-blue-600), var(--color-teal-600));
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 1.2rem;
            color: #fff;
        }

            .student-avatar img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .student-name {
            font-weight: 700;
            font-size: 1rem;
            color: var(--color-text-900);
            margin: 0 0 2px;
        }

        .student-username {
            font-size: var(--fs-xs);
            color: var(--color-blue-600);
            font-weight: 600;
        }

        .student-meta {
            display: flex;
            flex-direction: column;
            gap: var(--space-2);
            margin-bottom: var(--space-4);
        }

        .meta-row {
            display: flex;
            align-items: center;
            gap: var(--space-2);
            font-size: var(--fs-xs);
            color: var(--color-text-500);
        }

            .meta-row i {
                color: var(--color-blue-600);
                font-size: .85rem;
            }

        .track-badge {
            display: inline-flex;
            align-items: center;
            gap: var(--space-2);
            background: var(--color-blue-100);
            color: var(--color-blue-600);
            border-radius: var(--radius-pill);
            padding: var(--space-1) var(--space-3);
            font-size: var(--fs-xs);
            font-weight: 600;
            margin-bottom: var(--space-3);
        }

        .student-skills {
            display: flex;
            flex-wrap: wrap;
            gap: var(--space-2);
            margin-bottom: var(--space-4);
        }

        .skill-tag {
            background: var(--color-bg);
            color: var(--color-text-600);
            border: 1px solid var(--color-border);
            border-radius: var(--radius-pill);
            padding: 2px 10px;
            font-size: var(--fs-xs);
        }

        .student-footer {
            border-top: 1px solid var(--color-border);
            padding-top: var(--space-3);
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: var(--space-2);
            flex-wrap: wrap;
        }

        .btn-view-profile {
            background: var(--color-blue-600);
            color: #fff;
            border: none;
            border-radius: var(--radius-pill);
            padding: var(--space-2) var(--space-4);
            font-size: var(--fs-xs);
            font-weight: 600;
            text-decoration: none;
            transition: var(--transition-fast);
            display: inline-flex;
            align-items: center;
            gap: var(--space-2);
        }

            .btn-view-profile:hover {
                background: #265fd1;
                transform: translateY(-1px);
                color: #fff;
            }

        /* ✅ زر Message */
        .btn-message {
            background: linear-gradient(135deg, #0d9488, #2563eb);
            color: #fff;
            border: none;
            border-radius: var(--radius-pill);
            padding: var(--space-2) var(--space-4);
            font-size: var(--fs-xs);
            font-weight: 600;
            text-decoration: none;
            transition: var(--transition-fast);
            display: inline-flex;
            align-items: center;
            gap: var(--space-2);
        }

            .btn-message:hover {
                transform: translateY(-1px);
                box-shadow: 0 4px 12px rgba(13, 148, 136, 0.3);
                color: #fff;
            }

        /* ── Empty ── */
        .empty-state {
            text-align: center;
            padding: var(--space-12) var(--space-6);
        }

        .empty-icon {
            font-size: 3rem;
            color: var(--color-border);
            margin-bottom: var(--space-4);
        }

        .empty-state h3 {
            color: var(--color-text-900);
            margin-bottom: var(--space-2);
        }

        .empty-state p {
            color: var(--color-text-400);
            font-size: var(--fs-small);
        }

        /* ── Pagination ── */
        .pagination-wrapper {
            margin-top: var(--space-8);
            display: flex;
            justify-content: center;
        }

        .pagination {
            display: flex;
            gap: var(--space-2);
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .page-item .page-link {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 38px;
            height: 38px;
            border-radius: var(--radius-sm);
            border: 1px solid var(--color-border);
            color: var(--color-text-600);
            text-decoration: none;
            font-size: var(--fs-small);
            font-weight: 600;
            transition: var(--transition-fast);
        }

            .page-item.active .page-link,
            .page-item .page-link:hover {
                background: var(--color-blue-600);
                color: #fff;
                border-color: var(--color-blue-600);
            }
    </style>
}

<!-- ── Hero ── -->
<div class="students-hero">
    <div class="container">
        <div class="students-hero-content">
            <span class="hero-badge"><i class="bi bi-people-fill"></i> Student Community</span>
            <h1>Find Your <span class="highlight">Fellow Students</span></h1>
            <p>Browse and connect with students across all tracks, universities, and academic years.</p>
        </div>
        <div class="students-stats">
            <div>
                <span class="stat-number">@Model.TotalCount</span>
                <span class="stat-label">Students</span>
            </div>
            <div>
                <span class="stat-number">@Model.UniversityList.Count</span>
                <span class="stat-label">Universities</span>
            </div>
            <div>
                <span class="stat-number">@Model.TrackList.Count</span>
                <span class="stat-label">Tracks</span>
            </div>
        </div>
    </div>
</div>

<!-- ── Filters ── -->
<section class="students-filters">
    <div class="container">
        <form method="get" id="filterForm">
            <div class="filters-wrapper">

                <!-- Search -->
                <div class="search-box">
                    <i class="bi bi-search"></i>
                    <input type="text" name="search" id="searchInput"
                           placeholder="Search by username or full name…"
                           value="@Model.SearchTerm" />
                </div>

                <!-- Cascading Dropdowns -->
                <div class="filters-dropdowns">

                    <!-- 1. University -->
                    <div class="filter-group">
                        <label><i class="bi bi-building"></i> University</label>
                        <select name="university" id="ddlUniversity">
                            <option value="all">All Universities</option>
                            @foreach (var u in Model.UniversityList)
                            {
                                <option value="@u" selected="@(Model.University == u)">@u</option>
                            }
                        </select>
                    </div>

                    <!-- 2. Track (enabled after University chosen) -->
                    <div class="filter-group">
                        <label><i class="bi bi-diagram-3"></i> Track</label>
                        <select name="track" id="ddlTrack"
                            @(string.IsNullOrEmpty(Model.University) || Model.University == "all" ? "disabled" : "")>
                            <option value="all">All Tracks</option>
                            @foreach (var t in Model.TrackList)
                            {
                                <option value="@t" selected="@(Model.Track == t)">@t</option>
                            }
                        </select>
                    </div>

                    <!-- 3. Academic Year (enabled after Track chosen) -->
                    <div class="filter-group">
                        <label><i class="bi bi-calendar3"></i> Academic Year</label>
                        <select name="academicYear" id="ddlYear"
                            @(string.IsNullOrEmpty(Model.Track) || Model.Track == "all" ? "disabled" : "")>
                            <option value="all">All Years</option>
                            @foreach (var y in Model.AcademicYearList)
                            {
                                <option value="@y" selected="@(Model.AcademicYear == y)">@y</option>
                            }
                        </select>
                    </div>

                    <button type="submit" class="btn btn-primary btn-sm" style="align-self:flex-end;">
                        <i class="bi bi-funnel-fill"></i> Apply
                    </button>
                </div>
            </div>
        </form>
    </div>
</section>

<!-- ── Grid ── -->
<section class="students-grid-section">
    <div class="container">

        <!-- Results bar -->
        <div class="results-bar">
            <span class="results-count">
                Showing <strong>@Model.Students.Count</strong> of <strong>@Model.TotalCount</strong> students
                @if (Model.TotalPages > 1)
                {
                    <span> — Page @Model.CurrentPage of @Model.TotalPages</span>
                }
            </span>

            <!-- Active filter chips -->
            <div class="active-filters">
                @if (!string.IsNullOrEmpty(Model.SearchTerm))
                {
                    <span class="filter-chip">
                        <i class="bi bi-search"></i> "@Model.SearchTerm"
                        <a href="@Url.Action("Index", new { university = Model.University, track = Model.Track, academicYear = Model.AcademicYear })">×</a>
                    </span>
                }
                @if (!string.IsNullOrEmpty(Model.University) && Model.University != "all")
                {
                    <span class="filter-chip">
                        <i class="bi bi-building"></i> @Model.University
                        <a href="@Url.Action("Index", new { search = Model.SearchTerm })">×</a>
                    </span>
                }
                @if (!string.IsNullOrEmpty(Model.Track) && Model.Track != "all")
                {
                    <span class="filter-chip">
                        <i class="bi bi-diagram-3"></i> @Model.Track
                        <a href="@Url.Action("Index", new { search = Model.SearchTerm, university = Model.University })">×</a>
                    </span>
                }
                @if (!string.IsNullOrEmpty(Model.AcademicYear) && Model.AcademicYear != "all")
                {
                    <span class="filter-chip">
                        <i class="bi bi-calendar3"></i> Year @Model.AcademicYear
                        <a href="@Url.Action("Index", new { search = Model.SearchTerm, university = Model.University, track = Model.Track })">×</a>
                    </span>
                }
                @if (!string.IsNullOrEmpty(Model.SearchTerm) || (!string.IsNullOrEmpty(Model.University) && Model.University != "all"))
                {
                    <a href="@Url.Action("Index")" class="filter-chip" style="background:var(--color-danger);color:#fff;border-color:var(--color-danger);text-decoration:none;">
                        <i class="bi bi-x-circle"></i> Clear All
                    </a>
                }
            </div>
        </div>

        @if (!Model.Students.Any())
        {
            <div class="empty-state">
                <div class="empty-icon"><i class="bi bi-people"></i></div>
                <h3>No students found</h3>
                <p>Try adjusting your search or filters to find students.</p>
                <a href="@Url.Action("Index")" class="btn btn-secondary mt-3">
                    <i class="bi bi-arrow-counterclockwise"></i> Clear Filters
                </a>
            </div>
        }
        else
        {
            <div class="students-grid">
                @foreach (var student in Model.Students)
                {
                    var imgUrl = string.IsNullOrWhiteSpace(student.ProfileImageUrl)
                        ? "/images/default-avatar.png"
                        : student.ProfileImageUrl;

                    <div class="student-card"
                         onclick="location.href='@Url.Action("Index", "Profile", new { id = student.Id })'">

                        <div class="student-top">
                            <div class="student-avatar">
                                <img src="@imgUrl" alt="@student.FullName"
                                     onerror="this.onerror=null;this.src='/images/default-avatar.png';" />
                            </div>
                            <div>
                                <p class="student-name">@student.FullName</p>
                                <p class="student-username">@@student.Username</p>
                            </div>
                        </div>

                        <span class="track-badge">
                            <i class="bi bi-diagram-3-fill"></i> @student.EnrolledTrack
                        </span>

                        <div class="student-meta">
                            @if (student.University != "Not specified")
                            {
                                <div class="meta-row">
                                    <i class="bi bi-building"></i>
                                    <span>@student.University</span>
                                </div>
                            }
                            @if (student.Faculty != "Not specified")
                            {
                                <div class="meta-row">
                                    <i class="bi bi-book"></i>
                                    <span>@student.Faculty</span>
                                </div>
                            }
                            @if (student.AcademicYear != "Not specified")
                            {
                                <div class="meta-row">
                                    <i class="bi bi-calendar3"></i>
                                    <span>Year @student.AcademicYear</span>
                                </div>
                            }
                        </div>

                        @if (student.SkillList.Any())
                        {
                            <div class="student-skills">
                                @foreach (var skill in student.SkillList)
                                {
                                    <span class="skill-tag">@skill</span>
                                }
                            </div>
                        }

                        <div class="student-footer">
                            <a href="@Url.Action("Index", "Profile", new { id = student.Id })"
                               class="btn-view-profile"
                               onclick="event.stopPropagation();">
                                <i class="bi bi-person-circle"></i> View Profile
                            </a>
                            <!-- ✅ زر Message -->
                            <a asp-controller="Chat" asp-action="CreatePrivate" asp-route-userId="@student.Id"
                               class="btn-message"
                               onclick="event.stopPropagation();"
                               title="Send message to @student.FullName">
                                <i class="fa-regular fa-comment-dots"></i> Message
                            </a>
                        </div>
                    </div>
                }
            </div>

            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                <nav class="pagination-wrapper">
                    <ul class="pagination">
                        @if (Model.HasPreviousPage)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("Index", new { page = Model.CurrentPage - 1, search = Model.SearchTerm, university = Model.University, track = Model.Track, academicYear = Model.AcademicYear })">
                                    <i class="bi bi-chevron-left"></i>
                                </a>
                            </li>
                        }
                        @foreach (var p in Model.GetPageNumbers())
                        {
                            <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" href="@Url.Action("Index", new { page = p, search = Model.SearchTerm, university = Model.University, track = Model.Track, academicYear = Model.AcademicYear })">@p</a>
                            </li>
                        }
                        @if (Model.HasNextPage)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("Index", new { page = Model.CurrentPage + 1, search = Model.SearchTerm, university = Model.University, track = Model.Track, academicYear = Model.AcademicYear })">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            }
        }
    </div>
</section>

@section Scripts {
    <script>
        // ── Cascading filter logic ──────────────────────────────────
        const ddlUniversity = document.getElementById('ddlUniversity');
        const ddlTrack      = document.getElementById('ddlTrack');
        const ddlYear       = document.getElementById('ddlYear');
        const filterForm    = document.getElementById('filterForm');
        const searchInput   = document.getElementById('searchInput');

        ddlUniversity.addEventListener('change', function () {
            const hasUniversity = this.value && this.value !== 'all';
            ddlTrack.disabled = !hasUniversity;
            ddlYear.disabled  = true;
            if (!hasUniversity) {
                ddlTrack.value = 'all';
                ddlYear.value  = 'all';
            }
            triggerAjaxSubmit();
        });

        ddlTrack.addEventListener('change', function () {
            const hasTrack = this.value && this.value !== 'all';
            ddlYear.disabled = !hasTrack;
            if (!hasTrack) ddlYear.value = 'all';
            triggerAjaxSubmit();
        });

        ddlYear.addEventListener('change', function () {
            triggerAjaxSubmit();
        });

        // ── Search: submit on Enter key ──
        searchInput.addEventListener('keydown', function (e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                triggerAjaxSubmit();
            }
        });

        // Prevent full page reload on form submit
        filterForm.addEventListener('submit', function (e) {
            e.preventDefault();
            triggerAjaxSubmit();
        });

        // Sync HTML Form controls (inputs/dropdowns) with a given URL
        function syncFormToUrl(url) {
            try {
                const urlObj = new URL(url, window.location.origin);
                const search = urlObj.searchParams.get('search') || '';
                const university = urlObj.searchParams.get('university') || 'all';
                const track = urlObj.searchParams.get('track') || 'all';
                const academicYear = urlObj.searchParams.get('academicYear') || 'all';

                searchInput.value = search;
                ddlUniversity.value = university;

                const hasUniversity = university !== 'all';
                ddlTrack.disabled = !hasUniversity;
                ddlTrack.value = track;

                const hasTrack = track !== 'all';
                ddlYear.disabled = !hasTrack;
                ddlYear.value = academicYear;
            } catch (err) {
                console.error('Error syncing form to URL:', err);
            }
        }

        // ── AJAX Content Loading ──
        function triggerAjaxSubmit() {
            // Build the query string from form
            const formData = new FormData(filterForm);
            const params = new URLSearchParams();

            for (const [key, value] of formData.entries()) {
                if (value && value !== 'all') {
                    params.append(key, value);
                }
            }

            const url = `${window.location.pathname}?${params.toString()}`;
            loadAjaxPage(url);
        }

        function loadAjaxPage(url) {
            const gridSection = document.querySelector('.students-grid-section');
            if (gridSection) {
                gridSection.style.opacity = '0.5';
                gridSection.style.transition = 'opacity 0.2s ease';
            }

            fetch(url, {
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then(response => response.text())
            .then(html => {
                const parser = new DOMParser();
                const doc = parser.parseFromString(html, 'text/html');

                // Replace grid section
                const newGrid = doc.querySelector('.students-grid-section');
                if (newGrid && gridSection) {
                    gridSection.outerHTML = newGrid.outerHTML;
                }

                // Update stats in hero if they changed
                const statsContainer = document.querySelector('.students-stats');
                const newStats = doc.querySelector('.students-stats');
                if (statsContainer && newStats) {
                    statsContainer.innerHTML = newStats.innerHTML;
                }

                // Update address bar URL without reloading
                window.history.pushState(null, '', url);

                // Update form controls to match the new filters
                syncFormToUrl(url);

                // Re-bind all dynamic elements in the replaced HTML
                bindAllDynamicEvents();
            })
            .catch(err => {
                console.error('Error loading results:', err);
                if (gridSection) {
                    gridSection.style.opacity = '1';
                }
            });
        }

        // Bind click events to pagination links, filter chips, clear buttons
        function bindAllDynamicEvents() {
            // 1. Pagination links
            const paginationLinks = document.querySelectorAll('.pagination-wrapper a');
            paginationLinks.forEach(link => {
                link.addEventListener('click', function (e) {
                    e.preventDefault();
                    const targetUrl = this.getAttribute('href');
                    loadAjaxPage(targetUrl);
                });
            });

            // 2. Filter chip links (removing single filters or Clear All)
            const activeFilterLinks = document.querySelectorAll('.active-filters a, .filter-chip a');
            activeFilterLinks.forEach(link => {
                link.addEventListener('click', function (e) {
                    e.preventDefault();
                    const targetUrl = this.getAttribute('href');
                    loadAjaxPage(targetUrl);
                });
            });

            // 3. Clear Filters button in empty state
            const emptyStateClearBtn = document.querySelector('.empty-state .btn-secondary');
            if (emptyStateClearBtn) {
                emptyStateClearBtn.addEventListener('click', function (e) {
                    e.preventDefault();
                    const targetUrl = this.getAttribute('href');
                    loadAjaxPage(targetUrl);
                });
            }
        }

        // Initial event binding
        document.addEventListener('DOMContentLoaded', bindAllDynamicEvents);
    </script>
}