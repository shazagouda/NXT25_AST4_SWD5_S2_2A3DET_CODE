@model A3DET_CODE.Models.Portfolio
@{
    ViewData["Title"] = "Portfolio Details";
}

<div class="container py-4">
    <div class="card shadow-sm border-0">
        <div class="card-body">
            <h2 class="mb-3">@Model.User?.FullName</h2>
            <p>@Model.Bio</p>
            <p><strong>Skills:</strong> @Model.Skills</p>
            <p><strong>GitHub:</strong> @Model.GitHubUrl</p>
            <p><strong>LinkedIn:</strong> @Model.LinkedInUrl</p>
            @if (User.IsInRole("Company"))
            {
                <div class="mt-4">
                    <a asp-controller="Booking" asp-action="Create" asp-route-targetType="Student" asp-route-targetId="@Model.UserId" class="btn btn-primary">
                        <i class="fa-solid fa-handshake"></i> Hire Student
                    </a>
                </div>
            }
        </div>
    </div>
</div>
