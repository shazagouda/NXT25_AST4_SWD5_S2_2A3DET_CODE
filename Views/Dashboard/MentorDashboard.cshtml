@model A3DET_CODE.ViewModels.Dashboard.MentorDashboardViewModel
@{
    ViewData["Title"] = "Mentor Dashboard";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<div class="dashboard-container">

    <div class="dashboard-header">
        <div class="dashboard-welcome">
            <h1>Welcome back, @Model.UserName 👨‍🏫</h1>
            <p class="dashboard-subtitle">Guide students and review their progress</p>
        </div>
        <div class="dashboard-actions">
            <a asp-controller="MentorSessions" asp-action="Create" class="btn btn-primary">Schedule Session</a>
            <a asp-controller="Projects" asp-action="Index" class="btn btn-secondary">Review Projects</a>
        </div>
    </div>

    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon blue">👨‍🎓</div>
            <div class="stat-content">
                <div class="stat-number">@Model.TotalStudents</div>
                <div class="stat-label">Total Students</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon green">🟢</div>
            <div class="stat-content">
                <div class="stat-number">@Model.ActiveStudents</div>
                <div class="stat-label">Active Students</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon purple">📝</div>
            <div class="stat-content">
                <div class="stat-number">@Model.TotalProjectsReviewed</div>
                <div class="stat-label">Projects Reviewed</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon amber">📅</div>
            <div class="stat-content">
                <div class="stat-number">@Model.TotalSessions</div>
                <div class="stat-label">Total Sessions</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon gold">⭐</div>
            <div class="stat-content">
                <div class="stat-number">@Model.AverageRating.ToString("F1")</div>
                <div class="stat-label">Average Rating</div>
            </div>
        </div>
    </div>

    <div class="dashboard-grid">
        <div class="card">
            <div class="card-header">
                <h3>Student Progress</h3>
            </div>
            <div class="mentor-list">
                @foreach (var student in Model.StudentsProgress)
                {
                    <div class="mentor-item">
                        <div class="mentor-avatar" style="background:linear-gradient(135deg, #2F6FED, #15C6AE);">
                            @student.Name.Substring(0, 1).ToUpper()
                        </div>
                        <div class="mentor-info">
                            <div class="mentor-name">@student.Name</div>
                            <div class="mentor-role">@student.Track · @student.Status</div>
                        </div>
                        <div class="mentor-rating">
                            @student.Progress% <span>complete</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h3>Pending Reviews</h3>
            </div>
            <div class="task-list">
                @foreach (var review in Model.PendingReviews)
                {
                    <div class="task-item">
                        <div class="task-check"></div>
                        <div class="task-content">
                            <div class="task-title">@review.ProjectTitle</div>
                            <div class="task-meta">
                                <span>By @review.StudentName</span>
                                <span class="task-due">@review.SubmittedAt.ToString("MMM dd")</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="card" style="grid-column: 1 / -1;">
            <div class="card-header">
                <h3>Upcoming Sessions</h3>
            </div>
            <div class="activity-list">
                @foreach (var session in Model.UpcomingSessions)
                {
                    <div class="activity-item">
                        <span class="activity-icon blue">📅</span>
                        <div class="activity-content">
                            <div class="activity-title">@session.Topic</div>
                            <div class="activity-description">with @session.StudentName · @session.ScheduledAt.ToString("MMM dd, h:mm tt")</div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}