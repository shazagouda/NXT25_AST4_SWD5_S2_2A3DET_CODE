@model A3DET_CODE.ViewModels.Dashboard.CompanyDashboardViewModel
@{
    ViewData["Title"] = "Company Dashboard";
    Layout = "_Layout";
    var profileImageUrl = string.IsNullOrWhiteSpace(Model.ProfileImageUrl) ? "/images/default-avatar.png" : Model.ProfileImageUrl;
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<div class="dashboard-container">

    <div class="dashboard-header">
        <div class="dashboard-avatar">
            <img src="@profileImageUrl" alt="@Model.UserName logo" onerror="this.onerror=null;this.src='/images/default-avatar.png';" />
        </div>
        <div class="dashboard-welcome">
            <h1>Welcome back, @Model.UserName</h1>
            <p class="dashboard-subtitle">Find and hire top talent</p>
        </div>
        <div class="dashboard-actions">
            <a asp-controller="Booking" asp-action="MyBookings" class="btn btn-primary" style="background-color: var(--color-teal-600); border-color: var(--color-teal-600);">My Bookings</a>
            <a asp-controller="Contract" asp-action="MyContracts" class="btn btn-secondary">My Contracts</a>
        </div>
    </div>

    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon blue"><i class="bi bi-card-list"></i></div>
            <div class="stat-content">
                <div class="stat-number">@Model.TotalBookings</div>
                <div class="stat-label">Total Bookings</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon green"><i class="bi bi-check-circle-fill"></i></div>
            <div class="stat-content">
                <div class="stat-number">@Model.ActiveContracts</div>
                <div class="stat-label">Active Contracts</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon purple"><i class="bi bi-envelope-fill"></i></div>
            <div class="stat-content">
                <div class="stat-number">@Model.PendingBookings</div>
                <div class="stat-label">Pending Bookings</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon amber"><i class="bi bi-star-fill"></i></div>
            <div class="stat-content">
                <div class="stat-number">@Model.CompletedContracts</div>
                <div class="stat-label">Completed Contracts</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon gold"><i class="bi bi-currency-dollar"></i></div>
            <div class="stat-content">
                <div class="stat-number">$@Model.TotalSpent.ToString("0.##")</div>
                <div class="stat-label">Total Spent</div>
            </div>
        </div>
    </div>

    <div class="dashboard-grid">
        <div class="card">
            <div class="card-header">
                <h3>Recent Bookings</h3>
            </div>
            <div class="task-list">
                @foreach (var booking in Model.RecentBookings)
                {
                    <div class="task-item">
                        <div class="task-check"></div>
                        <div class="task-content">
                            <div class="task-title">@booking.TargetName</div>
                            <div class="task-meta">
                                <span>@booking.TargetType</span>
                                <span class="task-due">$@booking.TotalPrice</span>
                                <span class="task-priority @(booking.Status == "Paid" ? "low" : "medium")">@booking.Status</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h3>Top Candidates</h3>
            </div>
            <div class="mentor-list">
                @foreach (var candidate in Model.TopCandidates)
                {
                    <div class="mentor-item">
                        <div class="mentor-avatar" style="background:linear-gradient(135deg, #8B5CF6, #EC4899);">
                            @candidate.Name.Substring(0, 1).ToUpper()
                        </div>
                        <div class="mentor-info">
                            <div class="mentor-name">@candidate.Name</div>
                            <div class="mentor-role">@candidate.Track · @candidate.ProjectsCount projects</div>
                        </div>
                        <div class="mentor-rating">
                            @candidate.MatchScore% <span>match</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}
