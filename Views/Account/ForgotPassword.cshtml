
@model A3DET_CODE.ViewModels.Account.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_AccountLayout";
}

<div class="auth-header">
    <h2>Forgot Password</h2>
    <p class="auth-subtitle">Enter your email address and we'll send you a reset link</p>
</div>

@if (ViewData["Success"] != null)
{
    <div class="alert alert-success">
        @ViewData["Success"]
        <p style="margin-top: 10px;">
            <a asp-action="Login" class="btn btn-secondary btn-sm">Return to Login</a>
        </p>
    </div>
}
else
{
    <form asp-action="ForgotPassword" method="post" class="auth-form" id="forgotPasswordForm">
        @Html.AntiForgeryToken()

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                @Html.ValidationSummary(false, "", new { @class = "text-danger" })
            </div>
        }

        <div class="form-field">
            <label asp-for="Email">Email Address</label>
            <input asp-for="Email" type="email" class="form-control" placeholder="you@example.com" autocomplete="email" required />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary btn-block" id="resetButton">
            <span class="btn-text">Send Reset Link</span>
            <span class="btn-loader" style="display:none;">
                <span class="spinner"></span>
            </span>
        </button>

        <div class="auth-footer">
            <p><a asp-action="Login">Back to Login</a></p>
        </div>
    </form>
}
