
@{
    ViewData["Title"] = "Password Reset Successful";
    Layout = "_AccountLayout";
}

<div class="auth-header">
    <h2>Password Reset Successful</h2>
    <p class="auth-subtitle">Your password has been updated</p>
</div>

<div class="alert alert-success">
    <div style="text-align: center;">
        <div style="font-size: 4rem; margin-bottom: 1rem;">🔐</div>
        <h3 style="color: #0E8C79;">Password Updated!</h3>
        <p>Your password has been successfully reset.</p>
        <p style="margin-top: 1rem;">
            <a asp-action="Login" class="btn btn-primary">Login Now</a>
        </p>
    </div>
</div>

<div class="auth-footer">
    <p><a asp-action="Login">Return to Login</a></p>
</div>