@model IEnumerable<A3DET_CODE.ViewModels.Team.TeamViewModel>
@{
    ViewData["Title"] = "Teams";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Teams</h1>
        <a asp-action="Create" class="btn btn-primary">+ Create Team</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">
        @foreach (var team in Model)
        {
            <div class="col-md-4">
                <div class="card h-100 shadow-sm hover-shadow">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge" style="background-color: @team.TrackColor; color: #fff;">
                                @team.TrackName
                            </span>
                            <span class="badge @(team.Status == "Open" ? "bg-success" : "bg-warning")">
                                @team.Status
                            </span>
                        </div>
                        <h5 class="card-title">@team.Name</h5>
                        <p class="card-text text-muted small">@team.Description</p>
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <div>
                                <span class="text-muted small">@team.CurrentMembers / @team.MaxMembers members</span>
                            </div>
                            <div>
                                <span class="text-muted small">Lead: @team.LeaderName</span>
                            </div>
                        </div>
                        <div class="mt-3">
                            <a asp-action="Details" asp-route-id="@team.Id" class="btn btn-outline-primary btn-sm w-100">
                                View Team
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>