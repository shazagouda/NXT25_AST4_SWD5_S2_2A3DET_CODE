@model IEnumerable<A3DET_CODE.ViewModels.Team.TeamViewModel>
@{
    ViewData["Title"] = "Teams";
}

<div class="teams-page">
    <!-- Header -->
    <div class="teams-header">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="teams-title">Teams</h1>
                    <p class="teams-subtitle">Join a team or create your own to start building projects</p>
                </div>
                <a asp-action="Create" class="btn btn-primary btn-lg">
                    <i class="fa-solid fa-plus me-2"></i>Create Team
                </a>
            </div>
        </div>
    </div>

    <div class="container py-4">
        <!-- Alerts -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                <i class="fa-solid fa-check-circle me-2"></i>@TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">
                <i class="fa-solid fa-exclamation-circle me-2"></i>@TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- Teams Grid -->
        @if (Model != null && Model.Any())
        {
            <div class="row g-4">
                @foreach (var team in Model)
                {
                    <div class="col-lg-4 col-md-6">
                        <div class="team-card">
                            <!-- Track Badge -->
                            <div class="team-card-track" style="background-color: @team.TrackColor;">
                                <span>@team.TrackName</span>
                            </div>

                            <!-- Status Badge -->
                            <span class="team-card-status @(team.Status == "Open" ? "status-open" : "status-full")">
                                @team.Status
                            </span>

                            <!-- Content -->
                            <div class="team-card-body">
                                <h3 class="team-card-title">@team.Name</h3>
                                <p class="team-card-desc">@team.Description</p>

                                <!-- Members -->
                                <div class="team-card-members">
                                    <div class="member-avatars">
                                        @foreach (var member in team.Members.Take(3))
                                        {
                                            <span class="member-avatar" style="background: @(member.Role == "Leader" ? "#2F6FED" : "#15C6AE");">
                                                @member.Initials
                                            </span>
                                        }
                                        @if (team.Members.Count > 3)
                                        {
                                            <span class="member-avatar more">+@(team.Members.Count - 3)</span>
                                        }
                                    </div>
                                    <span class="member-count">@team.CurrentMembers / @team.MaxMembers</span>
                                </div>

                                <!-- Leader -->
                                <div class="team-card-leader">
                                    <i class="fa-solid fa-crown text-warning"></i>
                                    <span>@team.LeaderName</span>
                                </div>

                                <!-- Actions -->
                                <div class="team-card-actions">
                                    <a asp-action="Details" asp-route-id="@team.Id" class="btn btn-outline-primary w-100">
                                        View Team <i class="fa-solid fa-arrow-right ms-2"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <div class="empty-state">
                    <i class="fa-solid fa-users empty-icon"></i>
                    <h3>No Teams Yet</h3>
                    <p class="text-muted">Be the first to create a team and start building!</p>
                    <a asp-action="Create" class="btn btn-primary mt-3">Create a Team</a>
                </div>
            </div>
        }
    </div>
</div>

@section Styles {
    <style>
        .teams-page {
            background: var(--color-bg, #F6F7FB);
            min-height: 100vh;
        }

        .teams-header {
            background: var(--color-surface, #FFFFFF);
            border-bottom: 1px solid var(--color-border, #E4E7EF);
            padding: var(--space-6, 2rem) 0;
            box-shadow: var(--shadow-sm, 0 2px 8px rgba(10, 22, 40, 0.06));
        }

        .teams-title {
            font-family: var(--font-display, 'Sora', sans-serif);
            font-size: 1.75rem;
            font-weight: 700;
            color: var(--color-text-900, #0A1628);
            margin: 0;
        }

        .teams-subtitle {
            color: var(--color-text-600, #5B6478);
            margin: var(--space-1, 0.25rem) 0 0;
            font-size: 0.95rem;
        }

        .team-card {
            background: var(--color-surface, #FFFFFF);
            border-radius: var(--radius-lg, 20px);
            border: 1px solid var(--color-border, #E4E7EF);
            overflow: hidden;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            position: relative;
            height: 100%;
            display: flex;
            flex-direction: column;
        }

        .team-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-md, 0 8px 24px rgba(10, 22, 40, 0.08));
        }

        .team-card-track {
            padding: var(--space-2, 0.5rem) var(--space-4, 1rem);
            color: #fff;
            font-size: 0.75rem;
            font-weight: 600;
            display: inline-block;
            width: fit-content;
            border-radius: 0 0 var(--radius-sm, 8px) 0;
        }

        .team-card-status {
            position: absolute;
            top: var(--space-4, 1rem);
            right: var(--space-4, 1rem);
            padding: var(--space-1, 0.25rem) var(--space-3, 0.75rem);
            border-radius: var(--radius-pill, 999px);
            font-size: 0.7rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        .status-open {
            background: var(--color-teal-100, #E2FAF5);
            color: var(--color-teal-600, #15C6AE);
        }

        .status-full {
            background: var(--color-amber-100, #FDF1DE);
            color: var(--color-amber-500, #F2A33C);
        }

        .team-card-body {
            padding: var(--space-5, 1.5rem);
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: var(--space-3, 0.75rem);
        }

        .team-card-title {
            font-family: var(--font-display, 'Sora', sans-serif);
            font-size: 1.15rem;
            font-weight: 700;
            color: var(--color-text-900, #0A1628);
            margin: 0;
        }

        .team-card-desc {
            color: var(--color-text-600, #5B6478);
            font-size: 0.9rem;
            line-height: 1.6;
            margin: 0;
            flex: 1;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .team-card-members {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-top: var(--space-3, 0.75rem);
            border-top: 1px solid var(--color-border, #E4E7EF);
        }

        .member-avatars {
            display: flex;
            align-items: center;
        }

        .member-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 0.7rem;
            font-weight: 600;
            font-family: var(--font-mono, 'JetBrains Mono', monospace);
            border: 2px solid var(--color-surface, #FFFFFF);
            margin-left: -6px;
        }

        .member-avatar:first-child {
            margin-left: 0;
        }

        .member-avatar.more {
            background: var(--color-border, #E4E7EF);
            color: var(--color-text-600, #5B6478);
            font-size: 0.6rem;
        }

        .member-count {
            font-size: 0.85rem;
            color: var(--color-text-600, #5B6478);
            font-weight: 500;
        }

        .team-card-leader {
            display: flex;
            align-items: center;
            gap: var(--space-2, 0.5rem);
            font-size: 0.85rem;
            color: var(--color-text-600, #5B6478);
        }

        .team-card-actions {
            margin-top: var(--space-2, 0.5rem);
        }

        .team-card-actions .btn {
            padding: var(--space-2, 0.5rem) var(--space-4, 1rem);
            font-weight: 600;
            font-size: 0.85rem;
            border-radius: var(--radius-pill, 999px);
        }

        .empty-state {
            padding: var(--space-12, 6rem) var(--space-4, 1rem);
        }

        .empty-icon {
            font-size: 4rem;
            color: var(--color-text-400, #94A0B8);
            margin-bottom: var(--space-4, 1rem);
        }

        @@media (max-width: 640px) {
            .teams-header .d-flex {
                flex-direction: column;
                align-items: flex-start;
                gap: var(--space-4, 1rem);
            }
            .teams-title {
                font-size: 1.5rem;
            }
        }
    </style>
}