@model IEnumerable<A3DET_CODE.ViewModels.Project.ProjectViewModel>
@{
    ViewData["Title"] = "Projects";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Projects</h1>
        <a asp-action="Create" class="btn btn-primary">+ Create Project</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">
        @foreach (var project in Model)
        {
            <div class="col-md-4">
                <div class="card h-100 shadow-sm hover-shadow">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge bg-secondary">@project.Type</span>
                            <span class="badge @(project.Status == "Open" ? "bg-success" : project.Status == "InProgress" ? "bg-warning" : "bg-primary")">
                                @project.Status
                            </span>
                        </div>
                        <h5 class="card-title">@project.Title</h5>
                        <p class="card-text text-muted small">@project.Description</p>
                        <div class="mb-2">
                            <span class="badge bg-light text-dark">@project.TechStack</span>
                        </div>
                        <div class="mb-2">
                            <small class="text-muted">Track: @project.TrackName</small>
                        </div>
                        @if (project.IsAssigned)
                        {
                            <div class="progress mb-2" style="height: 6px;">
                                <div class="progress-bar" role="progressbar" style="width: @project.Progress%;"
                                     aria-valuenow="@project.Progress" aria-valuemin="0" aria-valuemax="100">
                                </div>
                            </div>
                            <small class="text-muted">Progress: @project.Progress%</small>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Available</span>
                        }
                        <div class="mt-3">
                            <a asp-action="Details" asp-route-id="@project.Id" class="btn btn-outline-primary btn-sm w-100">
                                View Project
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>