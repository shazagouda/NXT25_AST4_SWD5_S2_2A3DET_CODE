@model IEnumerable<A3DET_CODE.ViewModels.Project.ProjectViewModel>
@{
    ViewData["Title"] = "Projects";
}

<div class="projects-page">
    <!-- Header -->
    <div class="projects-header">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center flex-wrap">
                <div>
                    <h1 class="projects-title">Projects</h1>
                    <p class="projects-subtitle">Browse and manage your projects</p>
                </div>
                <a asp-action="Create" class="btn btn-primary btn-lg">
                    <i class="fa-solid fa-plus me-2"></i>Create Project
                </a>
            </div>
        </div>
    </div>

    <div class="container py-4">
        <!-- Alerts -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                <i class="fa-solid fa-check-circle me-2"></i>@TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">
                <i class="fa-solid fa-exclamation-circle me-2"></i>@TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (Model != null && Model.Any())
        {
            <div class="row g-4">
                @foreach (var project in Model)
                {
                    <div class="col-lg-4 col-md-6">
                        <div class="project-card">
                            <!-- Status Badge -->
                            <div class="project-card-status @(project.Status == "Open" ? "status-open" : project.Status == "InProgress" ? "status-progress" : "status-completed")">
                                @project.Status
                            </div>

                            <div class="project-card-body">
                                <!-- Type -->
                                <span class="project-card-type">@project.Type</span>

                                <!-- Title -->
                                <h3 class="project-card-title">@project.Title</h3>

                                <!-- Description -->
                                <p class="project-card-desc">@project.Description</p>

                                <!-- Tech Stack -->
                                <div class="project-card-tech">
                                    @foreach (var tech in project.TechStack.Split(',').Select(s => s.Trim()))
                                    {
                                        <span class="tech-badge">@tech</span>
                                    }
                                </div>

                                <!-- Footer -->
                                <div class="project-card-footer">
                                    <span class="project-card-track">
                                        <i class="fa-solid fa-route"></i> @project.TrackName
                                    </span>
                                    @if (project.IsAssigned)
                                    {
                                        <span class="project-card-team">
                                            <i class="fa-solid fa-users"></i> @project.TeamName
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="project-card-team text-muted">
                                            <i class="fa-solid fa-user-plus"></i> Available
                                        </span>
                                    }
                                </div>

                                <!-- Progress -->
                                @if (project.IsAssigned)
                                {
                                    <div class="project-progress">
                                        <span class="progress-label">Progress</span>
                                        <span class="progress-value">@project.Progress%</span>
                                    </div>
                                    <div class="progress" style="height: 6px;">
                                        <div class="progress-bar" role="progressbar"
                                             style="width: @project.Progress%; background: linear-gradient(90deg, #2F6FED, #15C6AE);"
                                             aria-valuenow="@project.Progress" aria-valuemin="0" aria-valuemax="100">
                                        </div>
                                    </div>
                                }

                                <!-- Actions -->
                                <a asp-action="Details" asp-route-id="@project.Id" class="btn btn-outline-primary w-100 mt-3">
                                    View Details <i class="fa-solid fa-arrow-right ms-2"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <div class="empty-state">
                    <i class="fa-solid fa-code empty-icon"></i>
                    <h3>No Projects Yet</h3>
                    <p class="text-muted">Create your first project and start building!</p>
                    <a asp-action="Create" class="btn btn-primary mt-3">Create a Project</a>
                </div>
            </div>
        }
    </div>
</div>

@section Styles {
    <style>
        .projects-page {
            background: var(--color-bg, #F6F7FB);
            min-height: 100vh;
        }

        .projects-header {
            background: var(--color-surface, #FFFFFF);
            border-bottom: 1px solid var(--color-border, #E4E7EF);
            padding: 2rem 0;
            box-shadow: 0 2px 8px rgba(10, 22, 40, 0.06);
        }

        .projects-title {
            font-family: var(--font-display, 'Sora', sans-serif);
            font-size: 1.75rem;
            font-weight: 700;
            color: var(--color-text-900, #0A1628);
            margin: 0;
        }

        .projects-subtitle {
            color: var(--color-text-600, #5B6478);
            margin: 0.25rem 0 0;
            font-size: 0.95rem;
        }

        .project-card {
            background: var(--color-surface, #FFFFFF);
            border-radius: 20px;
            border: 1px solid var(--color-border, #E4E7EF);
            overflow: hidden;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            height: 100%;
            position: relative;
        }

            .project-card:hover {
                transform: translateY(-4px);
                box-shadow: 0 8px 24px rgba(10, 22, 40, 0.08);
            }

        .project-card-status {
            position: absolute;
            top: 1rem;
            right: 1rem;
            padding: 0.25rem 0.75rem;
            border-radius: 999px;
            font-size: 0.7rem;
            font-weight: 700;
            text-transform: uppercase;
        }

        .status-open {
            background: var(--color-teal-100, #E2FAF5);
            color: var(--color-teal-600, #15C6AE);
        }

        .status-progress {
            background: var(--color-amber-100, #FDF1DE);
            color: var(--color-amber-500, #F2A33C);
        }

        .status-completed {
            background: var(--color-blue-100, #E8EFFE);
            color: var(--color-blue-600, #2F6FED);
        }

        .project-card-body {
            padding: 1.5rem;
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
        }

        .project-card-type {
            font-size: 0.75rem;
            font-weight: 600;
            color: var(--color-text-400, #94A0B8);
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        .project-card-title {
            font-family: var(--font-display, 'Sora', sans-serif);
            font-size: 1.15rem;
            font-weight: 700;
            color: var(--color-text-900, #0A1628);
            margin: 0;
        }

        .project-card-desc {
            color: var(--color-text-600, #5B6478);
            font-size: 0.9rem;
            line-height: 1.6;
            margin: 0;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .project-card-tech {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
        }

        .tech-badge {
            padding: 0.2rem 0.6rem;
            background: var(--color-bg, #F6F7FB);
            border: 1px solid var(--color-border, #E4E7EF);
            border-radius: 4px;
            font-size: 0.7rem;
            color: var(--color-text-600, #5B6478);
            font-weight: 500;
        }

        .project-card-footer {
            display: flex;
            justify-content: space-between;
            font-size: 0.8rem;
            color: var(--color-text-400, #94A0B8);
            padding-top: 0.75rem;
            border-top: 1px solid var(--color-border, #E4E7EF);
        }

            .project-card-footer i {
                margin-right: 0.25rem;
            }

        .project-progress {
            display: flex;
            justify-content: space-between;
            font-size: 0.8rem;
            color: var(--color-text-400, #94A0B8);
            margin-top: 0.25rem;
        }

        .progress-label {
            font-weight: 500;
        }

        .progress-value {
            font-weight: 600;
            color: var(--color-blue-600, #2F6FED);
        }

        .empty-state {
            padding: 6rem 1rem;
        }

        .empty-icon {
            font-size: 4rem;
            color: var(--color-text-400, #94A0B8);
            margin-bottom: 1rem;
        }

        @@media (max-width: 640px) {
            .projects-header .d-flex {
                flex-direction: column;
                align-items: flex-start;
                gap: 1rem;
            }

            .projects-title {
                font-size: 1.5rem;
            }

            .project-card-footer {
                flex-direction: column;
                gap: 0.25rem;
            }
        }
    </style>
}