@model A3DET_CODE.ViewModels.Project.ProjectViewModel
@{
    ViewData["Title"] = "Create Project";
}

<div class="create-project-page">
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="create-project-card">
                    <div class="create-project-header">
                        <div class="create-project-icon">
                            <i class="fa-solid fa-code"></i>
                        </div>
                        <div>
                            <h1 class="create-project-title">Create a Project</h1>
                            <p class="create-project-subtitle">Start a new project and build something amazing</p>
                        </div>
                    </div>

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            <i class="fa-solid fa-exclamation-circle me-2"></i>@TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form asp-action="Create" method="post" class="create-project-form">
                        @Html.AntiForgeryToken()

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger">
                                <strong>Please fix the following errors:</strong>
                                <ul class="mb-0 mt-2">
                                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                    {
                                        <li>@error.ErrorMessage</li>
                                    }
                                </ul>
                            </div>
                        }

                        <div class="form-group">
                            <label asp-for="Title" class="form-label">
                                Project Title <span class="text-danger">*</span>
                            </label>
                            <div class="input-wrapper">
                                <i class="fa-solid fa-tag input-icon"></i>
                                <input asp-for="Title" class="form-control" placeholder="Enter a project title" />
                            </div>
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Description" class="form-label">
                                Description <span class="text-danger">*</span>
                            </label>
                            <div class="input-wrapper">
                                <i class="fa-solid fa-align-left input-icon"></i>
                                <textarea asp-for="Description" class="form-control" rows="4" placeholder="Describe your project in detail"></textarea>
                            </div>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="TechStack" class="form-label">
                                Tech Stack <span class="text-danger">*</span>
                            </label>
                            <div class="input-wrapper">
                                <i class="fa-solid fa-code input-icon"></i>
                                <input asp-for="TechStack" class="form-control" placeholder="e.g., React, .NET, SQL, Docker" />
                            </div>
                            <span asp-validation-for="TechStack" class="text-danger"></span>
                            <small class="form-hint">List the technologies you'll use, separated by commas</small>
                        </div>

                        <div class="form-group">
                            <label asp-for="Type" class="form-label">
                                Project Type <span class="text-danger">*</span>
                            </label>
                            <div class="input-wrapper">
                                <i class="fa-solid fa-layer-group input-icon"></i>
                                <select asp-for="Type" class="form-control">
                                    <option value="">— Select Type —</option>
                                    <option value="Web">Web Application</option>
                                    <option value="Mobile">Mobile Application</option>
                                    <option value="Full-stack">Full-stack Application</option>
                                    <option value="DevOps">DevOps / Infrastructure</option>
                                    <option value="AI/ML">AI / Machine Learning</option>
                                    <option value="Data Science">Data Science</option>
                                    <option value="Game">Game Development</option>
                                    <option value="Embedded">Embedded Systems</option>
                                    <option value="Testing">Testing / QA</option>
                                </select>
                            </div>
                            <span asp-validation-for="Type" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="TrackId" class="form-label">
                                Track <span class="text-danger">*</span>
                            </label>
                            <div class="input-wrapper">
                                <i class="fa-solid fa-route input-icon"></i>
                                <select asp-for="TrackId" class="form-control">
                                    <option value="">— Select Track —</option>
                                    @if (ViewBag.Tracks != null)
                                    {
                                        foreach (var track in ViewBag.Tracks)
                                        {
                                            <option value="@track.Id">@track.Name</option>
                                        }
                                    }
                                    else
                                    {
                                        <option value="" disabled>No tracks available</option>
                                    }
                                </select>
                            </div>
                            <span asp-validation-for="TrackId" class="text-danger"></span>
                            <small class="form-hint">Choose the technical track for your project</small>
                        </div>

                        <div class="form-group">
                            <label asp-for="Deadline" class="form-label">Deadline (Optional)</label>
                            <div class="input-wrapper">
                                <i class="fa-regular fa-calendar input-icon"></i>
                                <input asp-for="Deadline" type="date" class="form-control" />
                            </div>
                            <span asp-validation-for="Deadline" class="text-danger"></span>
                            <small class="form-hint">When do you plan to complete this project?</small>
                        </div>

                        <div class="form-group">
                            <label asp-for="RepositoryUrl" class="form-label">Repository URL (Optional)</label>
                            <div class="input-wrapper">
                                <i class="fa-brands fa-github input-icon"></i>
                                <input asp-for="RepositoryUrl" class="form-control" placeholder="https://github.com/your-repo" />
                            </div>
                            <span asp-validation-for="RepositoryUrl" class="text-danger"></span>
                        </div>

                        <div class="form-actions">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="fa-solid fa-plus me-2"></i>Create Project
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                                <i class="fa-solid fa-arrow-left me-2"></i>Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .create-project-page {
            background: var(--color-bg, #F6F7FB);
            min-height: 100vh;
        }

        .create-project-card {
            background: var(--color-surface, #FFFFFF);
            border-radius: var(--radius-lg, 20px);
            border: 1px solid var(--color-border, #E4E7EF);
            padding: var(--space-8, 3rem);
            box-shadow: var(--shadow-sm, 0 2px 8px rgba(10, 22, 40, 0.06));
        }

        .create-project-header {
            display: flex;
            align-items: center;
            gap: var(--space-5, 1.5rem);
            margin-bottom: var(--space-6, 2rem);
            padding-bottom: var(--space-6, 2rem);
            border-bottom: 1px solid var(--color-border, #E4E7EF);
        }

        .create-project-icon {
            width: 60px;
            height: 60px;
            border-radius: var(--radius-md, 14px);
            background: var(--color-blue-100, #E8EFFE);
            color: var(--color-blue-600, #2F6FED);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.8rem;
            flex-shrink: 0;
        }

        .create-project-title {
            font-family: var(--font-display, 'Sora', sans-serif);
            font-size: 1.8rem;
            font-weight: 800;
            color: var(--color-text-900, #0A1628);
            margin: 0;
        }

        .create-project-subtitle {
            color: var(--color-text-600, #5B6478);
            margin: var(--space-1, 0.25rem) 0 0;
        }

        .create-project-form {
            display: flex;
            flex-direction: column;
            gap: var(--space-5, 1.5rem);
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: var(--space-2, 0.5rem);
        }

        .form-label {
            font-weight: 600;
            font-size: 0.9rem;
            color: var(--color-text-900, #0A1628);
        }

        .input-wrapper {
            position: relative;
        }

        .input-icon {
            position: absolute;
            left: var(--space-4, 1rem);
            top: 50%;
            transform: translateY(-50%);
            color: var(--color-text-400, #94A0B8);
            font-size: 0.9rem;
        }

        .input-wrapper textarea + .input-icon {
            top: var(--space-4, 1rem);
            transform: none;
        }

        .input-wrapper .form-control {
            padding-left: var(--space-8, 3rem);
            border: 1.5px solid var(--color-border, #E4E7EF);
            border-radius: var(--radius-sm, 8px);
            padding: var(--space-3, 0.75rem) var(--space-4, 1rem) var(--space-3, 0.75rem) var(--space-8, 3rem);
            font-size: 1rem;
            transition: all 0.2s;
            background: var(--color-surface, #FFFFFF);
            width: 100%;
        }

            .input-wrapper .form-control:focus {
                border-color: var(--color-blue-600, #2F6FED);
                box-shadow: 0 0 0 3px rgba(47, 111, 237, 0.1);
                outline: none;
            }

        .input-wrapper select.form-control {
            appearance: none;
            cursor: pointer;
        }

            .input-wrapper select.form-control + .input-icon {
                pointer-events: none;
            }

        textarea.form-control {
            min-height: 120px;
            resize: vertical;
        }

        .form-hint {
            font-size: 0.8rem;
            color: var(--color-text-400, #94A0B8);
        }

        .form-actions {
            display: flex;
            gap: var(--space-4, 1rem);
            padding-top: var(--space-5, 1.5rem);
            border-top: 1px solid var(--color-border, #E4E7EF);
            margin-top: var(--space-2, 0.5rem);
        }

            .form-actions .btn {
                padding: var(--space-3, 0.75rem) var(--space-6, 2rem);
                border-radius: var(--radius-pill, 999px);
                font-weight: 600;
                font-size: 1rem;
                min-width: 150px;
                justify-content: center;
            }

            .form-actions .btn-primary {
                background: var(--color-blue-600, #2F6FED);
                border: none;
                color: #fff;
            }

                .form-actions .btn-primary:hover {
                    background: #265fd1;
                }

            .form-actions .btn-outline-secondary {
                border: 1.5px solid var(--color-border, #E4E7EF);
                color: var(--color-text-600, #5B6478);
            }

                .form-actions .btn-outline-secondary:hover {
                    border-color: var(--color-blue-600, #2F6FED);
                    color: var(--color-blue-600, #2F6FED);
                }

        /* Responsive */
        .create-project-card {
            padding: var(--space-5, 1.5rem);
        }

        .create-project-header {
            flex-direction: column;
            text-align: center;
        }

        .form-actions {
            flex-direction: column;
        }

            .form-actions .btn {
                width: 100%;
            }
    </style>
}