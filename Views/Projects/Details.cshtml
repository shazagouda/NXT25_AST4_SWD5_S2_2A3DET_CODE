@model A3DET_CODE.ViewModels.Project.ProjectViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="container py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Projects</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
        </ol>
    </nav>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <h2>@Model.Title</h2>
                        <span class="badge @(Model.Status == "Open" ? "bg-success" : Model.Status == "InProgress" ? "bg-warning" : "bg-primary")" style="font-size: 1rem; padding: 0.5rem 1rem;">
                            @Model.Status
                        </span>
                    </div>
                    <p class="text-muted">@Model.Description</p>
                    <div class="row mt-3">
                        <div class="col-md-6">
                            <small class="text-muted">Track:</small>
                            <span class="badge bg-light text-dark">@Model.TrackName</span>
                        </div>
                        <div class="col-md-6">
                            <small class="text-muted">Type:</small>
                            <span class="badge bg-secondary">@Model.Type</span>
                        </div>
                    </div>
                    <div class="mt-3">
                        <small class="text-muted">Tech Stack:</small>
                        <div class="mt-1">
                            @foreach (var tech in Model.TechStack.Split(',').Select(s => s.Trim()))
                            {
                                <span class="badge bg-light text-dark me-1">@tech</span>
                            }
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.RepositoryUrl))
                    {
                        <div class="mt-2">
                            <a href="@Model.RepositoryUrl" target="_blank" class="btn btn-outline-secondary btn-sm">
                                <i class="bi bi-github"></i> Repository
                            </a>
                        </div>
                    }
                </div>
            </div>

            @if (Model.IsAssigned)
            {
                <div class="card shadow-sm mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Progress</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-1">
                            <span>Completion</span>
                            <span>@Model.Progress%</span>
                        </div>
                        <div class="progress" style="height: 20px;">
                            <div class="progress-bar progress-bar-striped progress-bar-animated"
                                 role="progressbar" style="width: @Model.Progress%;"
                                 aria-valuenow="@Model.Progress" aria-valuemin="0" aria-valuemax="100">
                                @Model.Progress%
                            </div>
                        </div>
                        <div class="row mt-3 text-center">
                            <div class="col-3">
                                <h5>@Model.TotalTasks</h5>
                                <small class="text-muted">Total Tasks</small>
                            </div>
                            <div class="col-3">
                                <h5 class="text-success">@Model.CompletedTasks</h5>
                                <small class="text-muted">Completed</small>
                            </div>
                            <div class="col-3">
                                <h5 class="text-warning">@Model.PendingTasks</h5>
                                <small class="text-muted">Pending</small>
                            </div>
                            <div class="col-3">
                                <h5>@Model.TotalSubmissions</h5>
                                <small class="text-muted">Submissions</small>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card shadow-sm">
                    <div class="card-header">
                        <h5 class="mb-0">Quick Actions</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex gap-2 flex-wrap">
                            <a asp-controller="Tasks" asp-action="ProjectTasks" asp-route-projectId="@Model.Id" class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-list-task"></i> View Tasks
                            </a>
                            <a asp-controller="Tasks" asp-action="Create" asp-route-projectId="@Model.Id" class="btn btn-outline-success btn-sm">
                                <i class="bi bi-plus-circle"></i> Add Task
                            </a>
                            <a asp-controller="Submissions" asp-action="ProjectSubmissions" asp-route-projectId="@Model.Id" class="btn btn-outline-info btn-sm">
                                <i class="bi bi-file-earmark-text"></i> View Submissions
                            </a>
                            <a asp-controller="Submissions" asp-action="Create" asp-route-projectId="@Model.Id" class="btn btn-outline-warning btn-sm">
                                <i class="bi bi-upload"></i> Submit Project
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Team</h5>
                </div>
                <div class="card-body">
                    @if (Model.IsAssigned)
                    {
                        <h6>@Model.TeamName</h6>
                        <small class="text-muted">Team ID: @Model.TeamId</small>
                    }
                    else
                    {
                        <p class="text-muted">No team assigned yet.</p>
                    }
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header">
                    <h5 class="mb-0">Details</h5>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-6">Created</dt>
                        <dd class="col-6">@Model.CreatedAt.ToString("MMM dd, yyyy")</dd>
                        @if (Model.StartedAt.HasValue)
                        {
                            <dt class="col-6">Started</dt>
                            <dd class="col-6">@Model.StartedAt.Value.ToString("MMM dd, yyyy")</dd>
                        }
                        @if (Model.CompletedAt.HasValue)
                        {
                            <dt class="col-6">Completed</dt>
                            <dd class="col-6">@Model.CompletedAt.Value.ToString("MMM dd, yyyy")</dd>
                        }
                        @if (Model.Deadline.HasValue)
                        {
                            <dt class="col-6">Deadline</dt>
                            <dd class="col-6">@Model.Deadline.Value.ToString("MMM dd, yyyy")</dd>
                        }
                    </dl>
                </div>
            </div>
        </div>
    </div>
</div>