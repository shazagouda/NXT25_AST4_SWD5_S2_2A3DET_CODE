@model A3DET_CODE.ViewModels.Project.ProjectViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="project-details-page">
    <div class="container py-4">
        <!-- Breadcrumb -->
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">Projects</a></li>
                <li class="breadcrumb-item active">@Model.Title</li>
            </ol>
        </nav>

        <!-- Alerts -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                <i class="fa-solid fa-check-circle me-2"></i>@TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">
                <i class="fa-solid fa-exclamation-circle me-2"></i>@TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="row g-4">
            <!-- Main Content -->
            <div class="col-lg-8">
                <!-- Project Info -->
                <div class="project-detail-card">
                    <div class="project-detail-header">
                        <div>
                            <div class="project-detail-badges">
                                <span class="badge-type">@Model.Type</span>
                                <span class="status-badge @(Model.Status == "Open" ? "status-open" : Model.Status == "InProgress" ? "status-progress" : "status-completed")">
                                    @Model.Status
                                </span>
                                <span class="badge-track" style="background-color: @(Model.TrackName == "Frontend Development" ? "#2F6FED" : Model.TrackName == "Backend Development" ? "#22C55E" : "#A78BFA")">
                                    @Model.TrackName
                                </span>
                            </div>
                            <h1 class="project-detail-title">@Model.Title</h1>
                            <p class="project-detail-desc">@Model.Description</p>
                        </div>
                    </div>

                    <!-- Meta Info -->
                    <div class="project-detail-meta">
                        <div class="meta-item">
                            <span class="meta-label">Created</span>
                            <span class="meta-value">@Model.CreatedAt.ToString("MMM dd, yyyy")</span>
                        </div>
                        @if (Model.StartedAt.HasValue)
                        {
                            <div class="meta-item">
                                <span class="meta-label">Started</span>
                                <span class="meta-value">@Model.StartedAt.Value.ToString("MMM dd, yyyy")</span>
                            </div>
                        }
                        @if (Model.CompletedAt.HasValue)
                        {
                            <div class="meta-item">
                                <span class="meta-label">Completed</span>
                                <span class="meta-value">@Model.CompletedAt.Value.ToString("MMM dd, yyyy")</span>
                            </div>
                        }
                        @if (Model.Deadline.HasValue)
                        {
                            <div class="meta-item">
                                <span class="meta-label">Deadline</span>
                                <span class="meta-value @(Model.Deadline.Value < DateTime.Now && Model.Status != "Completed" ? "text-danger" : "")">
                                    @Model.Deadline.Value.ToString("MMM dd, yyyy")
                                    @if (Model.Deadline.Value < DateTime.Now && Model.Status != "Completed")
                                    {
                                        <span class="badge bg-danger ms-2">Overdue</span>
                                    }
                                </span>
                            </div>
                        }
                        <div class="meta-item">
                            <span class="meta-label">Tech Stack</span>
                            <span class="meta-value">
                                @foreach (var tech in Model.TechStack.Split(',').Select(s => s.Trim()))
                                {
                                    <span class="tech-badge-sm">@tech</span>
                                }
                            </span>
                        </div>
                    </div>

                    <!-- Links -->
                    @if (!string.IsNullOrEmpty(Model.RepositoryUrl) || !string.IsNullOrEmpty(Model.DemoUrl))
                    {
                        <div class="project-detail-links">
                            @if (!string.IsNullOrEmpty(Model.RepositoryUrl))
                            {
                                <a href="@Model.RepositoryUrl" target="_blank" class="btn btn-outline-secondary btn-sm">
                                    <i class="fa-brands fa-github me-2"></i>Repository
                                </a>
                            }
                            @if (!string.IsNullOrEmpty(Model.DemoUrl))
                            {
                                <a href="@Model.DemoUrl" target="_blank" class="btn btn-outline-secondary btn-sm">
                                    <i class="fa-solid fa-link me-2"></i>Live Demo
                                </a>
                            }
                        </div>
                    }
                </div>

                <!-- Progress Section -->
                @if (Model.IsAssigned)
                {
                    <div class="progress-card">
                        <div class="progress-card-header">
                            <h5 class="mb-0">
                                <i class="fa-solid fa-chart-line me-2"></i>Progress
                            </h5>
                            <span class="progress-percentage">@Model.Progress%</span>
                        </div>
                        <div class="progress-card-body">
                            <div class="progress" style="height: 8px;">
                                <div class="progress-bar" role="progressbar"
                                     style="width: @Model.Progress%; background: linear-gradient(90deg, #2F6FED, #15C6AE);"
                                     aria-valuenow="@Model.Progress" aria-valuemin="0" aria-valuemax="100">
                                </div>
                            </div>
                            <div class="progress-stats">
                                <div class="stat-item">
                                    <span class="stat-label">Tasks</span>
                                    <span class="stat-value">@Model.TotalTasks</span>
                                </div>
                                <div class="stat-item">
                                    <span class="stat-label">Completed</span>
                                    <span class="stat-value text-success">@Model.CompletedTasks</span>
                                </div>
                                <div class="stat-item">
                                    <span class="stat-label">Pending</span>
                                    <span class="stat-value text-warning">@Model.PendingTasks</span>
                                </div>
                                <div class="stat-item">
                                    <span class="stat-label">Submissions</span>
                                    <span class="stat-value">@Model.TotalSubmissions</span>
                                </div>
                                @if (Model.AverageScore > 0)
                                {
                                    <div class="stat-item">
                                        <span class="stat-label">Avg Score</span>
                                        <span class="stat-value text-info">@Model.AverageScore%</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }

                <!-- Quick Actions -->
                <div class="actions-card">
                    <div class="actions-card-header">
                        <h5 class="mb-0"><i class="fa-solid fa-bolt me-2"></i>Quick Actions</h5>
                    </div>
                    <div class="actions-card-body">
                        <div class="d-flex gap-2 flex-wrap">
                            @if (Model.IsLeader)
                            {
                                <a asp-controller="Tasks" asp-action="ProjectTasks" asp-route-projectId="@Model.Id" class="btn btn-outline-primary btn-sm">
                                    <i class="fa-solid fa-list-check me-2"></i>View Tasks
                                </a>
                                <a asp-controller="Tasks" asp-action="Create" asp-route-projectId="@Model.Id" class="btn btn-outline-success btn-sm">
                                    <i class="fa-solid fa-plus me-2"></i>Add Task
                                </a>
                                <a asp-controller="Submissions" asp-action="ProjectSubmissions" asp-route-projectId="@Model.Id" class="btn btn-outline-info btn-sm">
                                    <i class="fa-solid fa-file-lines me-2"></i>View Submissions
                                </a>
                                <!-- ✅ زر Team Chat (يظهر للقائد إذا كانت المجموعة موجودة) -->
                                if (Model.ChatGroupId.HasValue)
                                {
                                    <a asp-controller="Chat" asp-action="Details" asp-route-id="@Model.ChatGroupId.Value" class="btn btn-primary btn-sm" style="background: linear-gradient(135deg, #0d9488, #2563eb); border: none;">
                                        <i class="fa-regular fa-comment-dots me-2"></i>Team Chat
                                    </a>
                                }
                            }
                            else if (Model.IsMember)
                            {
                                <a asp-controller="Tasks" asp-action="ProjectTasks" asp-route-projectId="@Model.Id" class="btn btn-outline-primary btn-sm">
                                    <i class="fa-solid fa-list-check me-2"></i>View Tasks
                                </a>
                                <a asp-controller="Submissions" asp-action="Create" asp-route-projectId="@Model.Id" class="btn btn-outline-warning btn-sm">
                                    <i class="fa-solid fa-upload me-2"></i>Submit Project
                                </a>
                                <a asp-controller="Submissions" asp-action="ProjectSubmissions" asp-route-projectId="@Model.Id" class="btn btn-outline-info btn-sm">
                                    <i class="fa-solid fa-file-lines me-2"></i>View Submissions
                                </a>
                                <!-- ✅ زر Team Chat (يظهر للعضو إذا كانت المجموعة موجودة) -->
                                if (Model.ChatGroupId.HasValue)
                                {
                                    <a asp-controller="Chat" asp-action="Details" asp-route-id="@Model.ChatGroupId.Value" class="btn btn-primary btn-sm" style="background: linear-gradient(135deg, #0d9488, #2563eb); border: none;">
                                        <i class="fa-regular fa-comment-dots me-2"></i>Team Chat
                                    </a>
                                }
                            }
                            else
                            {
                                if (User.IsInRole("Company"))
                                {
                                    if (Model.IsAssigned && string.IsNullOrEmpty(Model.ClientId) && Model.Price.HasValue)
                                    {
                                        <a asp-controller="Booking" asp-action="Create" asp-route-targetType="Project" asp-route-targetId="@Model.Id" class="btn btn-primary btn-sm">
                                            <i class="fa-solid fa-handshake me-2"></i>Book Project ($@Model.Price)
                                        </a>
                                    }
                                    else if (Model.IsAssigned && string.IsNullOrEmpty(Model.ClientId) && !Model.Price.HasValue)
                                    {
                                        <a asp-controller="Booking" asp-action="Create" asp-route-targetType="Project" asp-route-targetId="@Model.Id" class="btn btn-primary btn-sm">
                                            <i class="fa-solid fa-handshake me-2"></i>Book Team
                                        </a>
                                    }
                                }
                                else if (Model.HasPendingJoinRequest)
                                {
                                    <button class="btn btn-secondary btn-sm" disabled>
                                        <i class="fa-solid fa-clock-rotate-left me-2"></i>Pending Request
                                    </button>
                                }
                                else
                                {
                                    <form asp-action="RequestToJoin" asp-controller="Projects" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@Model.Id" />
                                        <input type="hidden" name="returnUrl" value="@Url.Action("Details", "Projects", new { id = Model.Id })" />
                                        <button type="submit" class="btn btn-primary btn-sm">
                                            <i class="fa-solid fa-paper-plane me-2"></i>Request to Join
                                        </button>
                                    </form>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sidebar -->
            <div class="col-lg-4">
                <!-- Team Info -->
                <div class="sidebar-card">
                    <div class="sidebar-card-header">
                        <h5 class="mb-0"><i class="fa-solid fa-users me-2"></i>Team</h5>
                    </div>
                    <div class="sidebar-card-body">
                        @if (Model.IsAssigned && Model.TeamMembers.Any())
                        {
                            <div class="team-info mb-3">
                                <div class="team-name mb-1">
                                    <i class="fa-solid fa-users me-2"></i>
                                    <span class="fw-bold">@Model.TeamName</span>
                                </div>
                            </div>
                            <div class="team-members-list d-flex flex-column gap-2">
                                @foreach (var member in Model.TeamMembers)
                                {
                                    <div class="d-flex align-items-center p-2 rounded" style="background-color: var(--bg-secondary); border: 1px solid var(--border-color);">
                                        <div class="avatar-circle d-flex align-items-center justify-content-center me-3"
                                             style="width: 36px; height: 36px; border-radius: 50%; background: linear-gradient(135deg, var(--primary-color), var(--primary-dark)); color: white; font-weight: bold; font-size: 14px; box-shadow: 0 2px 4px rgba(47, 111, 237, 0.2);">
                                            @member.Initials
                                        </div>
                                        <div class="flex-grow-1">
                                            <div class="fw-bold" style="font-size: 14px; color: var(--text-primary);">@member.Name</div>
                                            <div style="font-size: 12px; color: var(--text-secondary);">
                                                @if (member.Role == "Leader")
                                                {
                                                    <i class="fa-solid fa-crown text-warning me-1"></i>
                                                }
                                                @member.Role
                                            </div>
                                        </div>
                                        <!-- ✅ زر Message (يظهر للجميع، بما فيهم المالك) -->
                                        @if (member.Id != Model.ClientId)
                                        {
                                            <a asp-controller="Chat" asp-action="CreatePrivate" asp-route-userId="@member.Id" class="btn btn-outline-primary btn-sm ms-2" title="Send message to @member.Name">
                                                <i class="fa-regular fa-comment-dots"></i> Message
                                            </a>
                                        }
                                        else
                                        {
                                            <!-- إذا كان العضو هو نفس المستخدم، يمكن عرض زر "Chat" لكن لا داعي لظهور رسالة لنفسه -->
                                            <span class="text-muted ms-2" style="font-size: 11px;">(You)</span>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-3">
                                <div class="empty-team">
                                    <i class="fa-solid fa-user-plus empty-icon-small"></i>
                                    <p class="text-muted mb-0">No team assigned yet</p>
                                    <small class="text-muted">This project is available for teams</small>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Pending Join Requests (Leader Only) -->
                    @if (Model.IsLeader && Model.PendingJoinRequests.Any())
                    {
                        <div class="sidebar-card">
                            <div class="sidebar-card-header d-flex justify-content-between align-items-center">
                                <h5 class="mb-0 text-warning"><i class="fa-solid fa-bell me-2"></i>Requests</h5>
                                <span class="badge bg-warning text-dark rounded-pill">@Model.PendingJoinRequests.Count</span>
                            </div>
                            <div class="sidebar-card-body">
                                <div class="d-flex flex-column gap-3">
                                    @foreach (var req in Model.PendingJoinRequests)
                                    {
                                        <div class="request-card p-3 rounded" style="background-color: var(--bg-secondary); border: 1px solid var(--border-color);">
                                            <div class="d-flex align-items-center mb-2">
                                                <div class="avatar-circle d-flex align-items-center justify-content-center me-2"
                                                     style="width: 32px; height: 32px; border-radius: 50%; background: var(--bg-tertiary); color: var(--text-primary); font-size: 12px; font-weight: bold;">
                                                    @req.UserInitials
                                                </div>
                                                <div>
                                                    <div class="fw-bold" style="font-size: 14px; color: var(--text-primary);">@req.UserName</div>
                                                    <div style="font-size: 11px; color: var(--text-secondary);">@req.RequestedAt.ToString("MMM dd, yyyy")</div>
                                                </div>
                                            </div>
                                            <div class="d-flex gap-2 mt-2">
                                                <form asp-controller="Teams" asp-action="AcceptMember" method="post" class="flex-grow-1">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@Model.TeamId" />
                                                    <input type="hidden" name="userId" value="@req.UserId" />
                                                    <input type="hidden" name="returnUrl" value="@Url.Action("Details", "Projects", new { id = Model.Id })" />
                                                    <button type="submit" class="btn btn-success btn-sm w-100 py-1" style="font-size: 12px;">
                                                        <i class="fa-solid fa-check me-1"></i> Accept
                                                    </button>
                                                </form>
                                                <form asp-controller="Teams" asp-action="RejectMember" method="post" class="flex-grow-1">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@Model.TeamId" />
                                                    <input type="hidden" name="userId" value="@req.UserId" />
                                                    <input type="hidden" name="returnUrl" value="@Url.Action("Details", "Projects", new { id = Model.Id })" />
                                                    <button type="submit" class="btn btn-outline-danger btn-sm w-100 py-1" style="font-size: 12px;">
                                                        <i class="fa-solid fa-xmark me-1"></i> Reject
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Quick Stats -->
                    <div class="sidebar-card">
                        <div class="sidebar-card-header">
                            <h5 class="mb-0"><i class="fa-solid fa-chart-simple me-2"></i>Stats</h5>
                        </div>
                        <div class="sidebar-card-body">
                            <div class="stat-item">
                                <span class="stat-label">Status</span>
                                <span class="stat-value">
                                    <span class="status-badge-sm @(Model.Status == "Open" ? "status-open" : Model.Status == "InProgress" ? "status-progress" : "status-completed")">
                                        @Model.Status
                                    </span>
                                </span>
                            </div>
                            <div class="stat-item">
                                <span class="stat-label">Type</span>
                                <span class="stat-value">@Model.Type</span>
                            </div>
                            <div class="stat-item">
                                <span class="stat-label">Track</span>
                                <span class="stat-value">@Model.TrackName</span>
                            </div>
                            <div class="stat-item">
                                <span class="stat-label">Progress</span>
                                <span class="stat-value">@Model.Progress%</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .project-details-page {
            background: var(--color-bg, #F6F7FB);
            min-height: 100vh;
            padding-bottom: 2rem;
        }

        .project-detail-card,
        .progress-card,
        .actions-card,
        .sidebar-card {
            background: var(--color-surface, #FFFFFF);
            border-radius: 20px;
            border: 1px solid var(--color-border, #E4E7EF);
            overflow: hidden;
            margin-bottom: 1.5rem;
            box-shadow: 0 2px 8px rgba(10, 22, 40, 0.06);
        }

        .project-detail-card {
            padding: 2rem;
        }

        .project-detail-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            flex-wrap: wrap;
            gap: 1rem;
            margin-bottom: 1.5rem;
        }

        .project-detail-badges {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
            margin-bottom: 0.75rem;
        }

        .badge-type {
            padding: 0.25rem 0.75rem;
            border-radius: 999px;
            background: var(--color-bg, #F6F7FB);
            color: var(--color-text-600, #5B6478);
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
        }

        .badge-track {
            padding: 0.25rem 0.75rem;
            border-radius: 999px;
            color: #fff;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .status-badge {
            padding: 0.25rem 0.75rem;
            border-radius: 999px;
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
        }

        .project-detail-title {
            font-family: var(--font-display, 'Sora', sans-serif);
            font-size: 1.75rem;
            font-weight: 800;
            color: var(--color-text-900, #0A1628);
            margin: 0 0 0.5rem;
        }

        .project-detail-desc {
            color: var(--color-text-600, #5B6478);
            font-size: 1rem;
            line-height: 1.7;
            margin: 0;
            max-width: 650px;
        }

        .project-detail-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 1.5rem 2.5rem;
            padding-top: 1.5rem;
            border-top: 1px solid var(--color-border, #E4E7EF);
        }

        .meta-item {
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
        }

        .meta-label {
            font-size: 0.75rem;
            color: var(--color-text-400, #94A0B8);
            text-transform: uppercase;
            letter-spacing: 0.05em;
            font-weight: 600;
        }

        .meta-value {
            font-weight: 500;
            color: var(--color-text-900, #0A1628);
        }

        .tech-badge-sm {
            padding: 0.15rem 0.5rem;
            background: var(--color-bg, #F6F7FB);
            border: 1px solid var(--color-border, #E4E7EF);
            border-radius: 4px;
            font-size: 0.7rem;
            color: var(--color-text-600, #5B6478);
            display: inline-block;
            margin-right: 0.25rem;
        }

        .project-detail-links {
            display: flex;
            gap: 0.75rem;
            padding-top: 1.5rem;
            border-top: 1px solid var(--color-border, #E4E7EF);
            margin-top: 1.5rem;
        }

        .progress-card-header {
            padding: 1rem 1.5rem;
            border-bottom: 1px solid var(--color-border, #E4E7EF);
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: var(--color-bg, #F6F7FB);
        }

        .progress-percentage {
            font-family: var(--font-mono, 'JetBrains Mono', monospace);
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--color-blue-600, #2F6FED);
        }

        .progress-card-body {
            padding: 1.5rem;
        }

        .progress-stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
            gap: 1rem;
            margin-top: 1rem;
            padding-top: 1rem;
            border-top: 1px solid var(--color-border, #E4E7EF);
        }

            .progress-stats .stat-item {
                text-align: center;
            }

            .progress-stats .stat-label {
                display: block;
                font-size: 0.7rem;
                color: var(--color-text-400, #94A0B8);
                text-transform: uppercase;
                letter-spacing: 0.04em;
            }

            .progress-stats .stat-value {
                display: block;
                font-size: 1.25rem;
                font-weight: 700;
                margin-top: 0.25rem;
            }

        .actions-card-header {
            padding: 0.75rem 1.5rem;
            border-bottom: 1px solid var(--color-border, #E4E7EF);
            background: var(--color-bg, #F6F7FB);
        }

        .actions-card-body {
            padding: 1.25rem 1.5rem;
        }

            .actions-card-body .btn {
                border-radius: 999px;
                padding: 0.4rem 1rem;
                font-weight: 600;
                font-size: 0.85rem;
            }

        .sidebar-card-header {
            padding: 0.75rem 1.5rem;
            border-bottom: 1px solid var(--color-border, #E4E7EF);
            background: var(--color-bg, #F6F7FB);
        }

        .sidebar-card-body {
            padding: 1.25rem 1.5rem;
        }

            .sidebar-card-body .stat-item {
                display: flex;
                justify-content: space-between;
                padding: 0.5rem 0;
                border-bottom: 1px solid var(--color-border, #E4E7EF);
            }

                .sidebar-card-body .stat-item:last-child {
                    border-bottom: none;
                }

            .sidebar-card-body .stat-label {
                color: var(--color-text-400, #94A0B8);
                font-size: 0.85rem;
            }

            .sidebar-card-body .stat-value {
                font-weight: 600;
                color: var(--color-text-900, #0A1628);
                font-size: 0.9rem;
            }

        .status-badge-sm {
            padding: 0.15rem 0.5rem;
            border-radius: 999px;
            font-size: 0.7rem;
            font-weight: 700;
            text-transform: uppercase;
        }

        .team-info {
            text-align: center;
        }

        .team-name {
            font-size: 1.1rem;
            font-weight: 600;
            color: var(--color-text-900, #0A1628);
        }

        .empty-team {
