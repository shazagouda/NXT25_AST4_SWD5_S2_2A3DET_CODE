@model A3DET_CODE.ViewModels.Profile.MyReportsViewModel
@{
    ViewData["Title"] = "My Reports";
}

@section Styles {
    <link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />
    <style>
        .reports-tabs {
            display: flex;
            gap: 1rem;
            margin-bottom: 2rem;
            border-bottom: 1px solid var(--color-border);
        }
        .tab-btn {
            background: none;
            border: none;
            padding: 0.75rem 1.5rem;
            font-weight: 600;
            color: var(--color-text-600);
            cursor: pointer;
            border-bottom: 3px solid transparent;
            transition: all 0.2s ease;
        }
        .tab-btn.active {
            color: var(--color-blue-600);
            border-bottom-color: var(--color-blue-600);
        }
        .tab-content {
            display: none;
        }
        .tab-content.active {
            display: block;
        }
    </style>
}

<div class="profile-container">
    <div class="profile-header">
        <h1><i class="bi bi-flag"></i> My Reports</h1>
        <p class="profile-subtitle">Manage reports you submitted and reports against you</p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success show">
            <span><i class="bi bi-check-circle-fill"></i> @TempData["Success"]</span>
        </div>
    }

    <!-- Tabs -->
    <div class="reports-tabs">
        <button class="tab-btn active" data-tab="submitted" onclick="switchTab('submitted')">
            Reports I Submitted (@Model.SubmittedReports.Count)
        </button>
        <button class="tab-btn" data-tab="received" onclick="switchTab('received')">
            Reports Against Me (@Model.ReceivedReports.Count)
        </button>
    </div>

    <!-- Submitted Reports Tab -->
    <div class="tab-content active" id="tab-submitted">
        @if (!Model.SubmittedReports.Any())
        {
            <div class="card" style="padding: var(--space-6); text-align: center;">
                <p style="font-size: 1.1rem; color: var(--color-text-600);">You haven't submitted any reports yet.</p>
            </div>
        }
        else
        {
            <div class="report-list">
                @foreach (var report in Model.SubmittedReports)
                {
                    <div class="card" style="padding: var(--space-5); margin-bottom: var(--space-4);">
                        <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                            <div>
                                <h4>Report #@report.Id</h4>
                                <p style="font-size: var(--fs-small); color: var(--color-text-600);">
                                    <strong>Reason:</strong> @report.Reason
                                </p>
                                <p style="font-size: var(--fs-small); color: var(--color-text-600);">
                                    <strong>Status:</strong>
                                    <span class="badge @(report.Status == "Pending" ? "badge-amber" : "badge-teal")">
                                        @report.Status
                                    </span>
                                </p>
                                @if (!string.IsNullOrEmpty(report.AdditionalDetails))
                                {
                                    <p style="font-size: var(--fs-small); color: var(--color-text-600);">
                                        <strong>Details:</strong> @report.AdditionalDetails
                                    </p>
                                }
                                <p style="font-size: var(--fs-xs); color: var(--color-text-400);">
                                    Submitted: @report.CreatedAt.ToString("MMM dd, yyyy HH:mm")
                                </p>
                            </div>
                            <div>
                                <span class="badge @(report.IsAnonymous ? "badge-blue" : "badge-amber")">
                                    @(report.IsAnonymous ? "Anonymous" : "Public")
                                </span>
                            </div>
                        </div>
                        <div style="margin-top: var(--space-3); padding-top: var(--space-3); border-top: 1px solid var(--color-border);">
                            <p style="font-size: var(--fs-small); color: var(--color-text-600);">
                                <strong>Reported User:</strong> @report.ReportedUser?.FullName
                            </p>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Received Reports Tab -->
    <div class="tab-content" id="tab-received">
        @if (!Model.ReceivedReports.Any())
        {
            <div class="card" style="padding: var(--space-6); text-align: center;">
                <p style="font-size: 1.1rem; color: var(--color-text-600);">Good job! No one has reported you.</p>
            </div>
        }
        else
        {
            <div class="report-list">
                @foreach (var report in Model.ReceivedReports)
                {
                    <div class="card" style="padding: var(--space-5); margin-bottom: var(--space-4); border-left: 4px solid var(--color-danger);">
                        <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                            <div>
                                <h4>Report #@report.Id Against You</h4>
                                <p style="font-size: var(--fs-small); color: var(--color-text-600);">
                                    <strong>Reason:</strong> @report.Reason
                                </p>
                                <p style="font-size: var(--fs-small); color: var(--color-text-600);">
                                    <strong>Status:</strong>
                                    <span class="badge @(report.Status == "Pending" ? "badge-amber" : "badge-teal")">
                                        @report.Status
                                    </span>
                                </p>
                                @if (!string.IsNullOrEmpty(report.AdditionalDetails))
                                {
                                    <p style="font-size: var(--fs-small); color: var(--color-text-600);">
                                        <strong>Details:</strong> @report.AdditionalDetails
                                    </p>
                                }
                                <p style="font-size: var(--fs-xs); color: var(--color-text-400);">
                                    Received: @report.CreatedAt.ToString("MMM dd, yyyy HH:mm")
                                </p>
                            </div>
                        </div>
                        <div style="margin-top: var(--space-3); padding-top: var(--space-3); border-top: 1px solid var(--color-border);">
                            <p style="font-size: var(--fs-small); color: var(--color-text-600);">
                                <strong>Reported By:</strong> @(report.IsAnonymous ? "Anonymous User" : report.Reporter?.FullName)
                            </p>
                            @if (report.Status == "Resolved" && !string.IsNullOrEmpty(report.ResolutionNote))
                            {
                                <div style="background:#F1F5F9; padding: 1rem; border-radius: 8px; margin-top: 1rem;">
                                    <strong>Admin Resolution:</strong> @report.ResolutionNote
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <div style="margin-top: var(--space-4);">
        <a asp-action="Index" class="btn btn-secondary">← Back to Profile</a>
    </div>
</div>

@section Scripts {
    <script>
        function switchTab(tab) {
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
            document.querySelector(`[data-tab="${tab}"]`).classList.add('active');
            document.getElementById(`tab-${tab}`).classList.add('active');
        }
    </script>
}