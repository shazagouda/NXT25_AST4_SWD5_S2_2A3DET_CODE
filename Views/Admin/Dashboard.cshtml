@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .admin-page { padding: 4rem 1rem; min-height: calc(100vh - 70px); background: #F8FAFC; }
    .admin-header { margin-bottom: 2rem; }
    .admin-header h1 { font-size: 2rem; color: #0A1628; margin: 0; }
    .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem; margin-bottom: 2rem; }
    .stat-card { background: white; border-radius: 12px; padding: 2rem; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); }
    .stat-card h3 { font-size: 1rem; color: #5B6478; margin-top: 0; font-weight: 600; }
    .stat-card .value { font-size: 2.5rem; color: #2F6FED; font-weight: 800; margin: 0.5rem 0 0 0; }
</style>

<div class="admin-page">
    <div class="container">
        <div class="admin-header">
            <h1>System Dashboard</h1>
            <p>Overview of platform metrics and activities.</p>
        </div>

        <div class="stats-grid">
            <div class="stat-card">
                <h3>Total Users</h3>
                <p class="value">@ViewBag.UserCount</p>
            </div>
            <div class="stat-card">
                <h3>Total Projects</h3>
                <p class="value">@ViewBag.TotalProjects</p>
            </div>
            <div class="stat-card" style="border-left: 4px solid var(--color-danger);">
                <h3>Pending Reports</h3>
                <p class="value" style="color: var(--color-danger);">@ViewBag.PendingReports</p>
            </div>
            <div class="stat-card" style="border-left: 4px solid var(--color-purple-600);">
                <h3>Pending Escrows</h3>
                <p class="value" style="color: var(--color-purple-600);">@ViewBag.PendingEscrows</p>
            </div>
        </div>

        <div style="display:flex; gap: 1rem; flex-wrap: wrap;">
            <a asp-action="Reports" class="btn btn-primary">Manage Reports</a>
            <a asp-action="Bookings" class="btn btn-primary" style="background:#2563EB; color:#ffffff; border-color:#2563EB;">Manage Bookings</a>
            <a asp-controller="Wallet" asp-action="AdminTransfers" class="btn btn-primary" style="background:#7C3AED; color:#ffffff; border-color:#7C3AED;">Manage Escrows</a>
            <a asp-action="Users" class="btn btn-secondary">Manage Users</a>
            <a asp-controller="Wallet" asp-action="Index" class="btn btn-secondary">Go to Wallet</a>
        </div>
    </div>
</div>
