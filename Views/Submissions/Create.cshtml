@model A3DET_CODE.ViewModels.Submission.SubmissionViewModel
@{
    ViewData["Title"] = "Submit Work";
}

<div class="submissions-create-page">
    <div class="container py-4">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <!-- Breadcrumb -->
                <nav aria-label="breadcrumb" class="mb-4">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a asp-controller="Projects" asp-action="Index">Projects</a></li>
                        <li class="breadcrumb-item"><a asp-controller="Projects" asp-action="Details" asp-route-id="@Model.ProjectId">@Model.ProjectTitle</a></li>
                        <li class="breadcrumb-item"><a asp-controller="Submissions" asp-action="ProjectSubmissions" asp-route-projectId="@Model.ProjectId">Submissions</a></li>
                        <li class="breadcrumb-item active">Submit Work</li>
                    </ol>
                </nav>

                <div class="card shadow-sm" style="background-color: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: 12px;">
                    <div class="card-header border-bottom-0 pt-4 pb-0 bg-transparent">
                        <h3 class="mb-0"><i class="fa-solid fa-cloud-arrow-up text-warning me-2"></i>Submit Work</h3>
                        <p class="text-muted mt-2">Submit your completed task or project milestone for @Model.ProjectTitle</p>
                    </div>
                    <div class="card-body">
                        <form asp-action="Create" method="post" class="needs-validation" novalidate>
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="ProjectId" />
                            <input type="hidden" asp-for="ProjectTitle" />

                            <div class="row g-4">
                                <div class="col-12">
                                    <div class="form-floating">
                                        <input asp-for="Title" class="form-control" style="background-color: var(--bg-tertiary); border-color: var(--border-color); color: var(--text-primary);" placeholder="Submission Title" required />
                                        <label asp-for="Title" class="text-muted"><i class="fa-solid fa-heading me-2"></i>Submission Title *</label>
                                    </div>
                                    <span asp-validation-for="Title" class="text-danger small mt-1 d-block"></span>
                                </div>

                                <div class="col-12">
                                    <div class="form-floating">
                                        <textarea asp-for="Description" class="form-control" style="background-color: var(--bg-tertiary); border-color: var(--border-color); color: var(--text-primary); height: 120px;" placeholder="Description"></textarea>
                                        <label asp-for="Description" class="text-muted"><i class="fa-solid fa-align-left me-2"></i>Detailed Description</label>
                                    </div>
                                    <span asp-validation-for="Description" class="text-danger small mt-1 d-block"></span>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-floating">
                                        <input asp-for="GitHubUrl" class="form-control" style="background-color: var(--bg-tertiary); border-color: var(--border-color); color: var(--text-primary);" placeholder="GitHub URL" />
                                        <label asp-for="GitHubUrl" class="text-muted"><i class="fa-brands fa-github me-2"></i>Repository URL</label>
                                    </div>
                                    <span asp-validation-for="GitHubUrl" class="text-danger small mt-1 d-block"></span>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-floating">
                                        <input asp-for="DemoUrl" class="form-control" style="background-color: var(--bg-tertiary); border-color: var(--border-color); color: var(--text-primary);" placeholder="Demo URL" />
                                        <label asp-for="DemoUrl" class="text-muted"><i class="fa-solid fa-link me-2"></i>Live Demo URL (Optional)</label>
                                    </div>
                                    <span asp-validation-for="DemoUrl" class="text-danger small mt-1 d-block"></span>
                                </div>

                                <div class="col-12">
                                    <div class="form-floating">
                                        <input asp-for="FileUrl" class="form-control" style="background-color: var(--bg-tertiary); border-color: var(--border-color); color: var(--text-primary);" placeholder="File URL" />
                                        <label asp-for="FileUrl" class="text-muted"><i class="fa-solid fa-file-arrow-up me-2"></i>File/Attachment URL (Optional)</label>
                                    </div>
                                    <span asp-validation-for="FileUrl" class="text-danger small mt-1 d-block"></span>
                                    <div class="form-text mt-1 text-muted small"><i class="fa-solid fa-circle-info me-1"></i>Link to Google Drive, Figma, or Dropbox if applicable.</div>
                                </div>
                            </div>

                            <div class="d-flex justify-content-end gap-3 mt-5 pt-4 border-top" style="border-color: var(--border-color) !important;">
                                <a asp-controller="Submissions" asp-action="ProjectSubmissions" asp-route-projectId="@Model.ProjectId" class="btn btn-outline-secondary px-4 py-2" style="border-radius: 8px;">Cancel</a>
                                <button type="submit" class="btn btn-warning text-dark fw-bold px-4 py-2" style="border-radius: 8px; background: linear-gradient(135deg, #f59e0b, #d97706); border: none; box-shadow: 0 4px 6px rgba(245, 158, 11, 0.2);">
                                    <i class="fa-solid fa-paper-plane me-2"></i>Submit Work
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
