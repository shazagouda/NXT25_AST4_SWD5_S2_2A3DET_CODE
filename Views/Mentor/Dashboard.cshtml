@model A3DET_CODE.ViewModels.Mentor.MentorDashboardViewModel
@{
    ViewData["Title"] = "Mentor Dashboard";
    Layout = "_Layout";
    var profileImageUrl = string.IsNullOrWhiteSpace(Model.Avatar) ? "/images/default-avatar.png" : Model.Avatar;
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/mentors.css" asp-append-version="true" />
}

<div class="dashboard-container">
    <div class="dashboard-header">
        <div class="dashboard-avatar">
            <img src="@profileImageUrl" alt="@Model.FullName profile photo" onerror="this.onerror=null;this.src='/images/default-avatar.png';" />
        </div>
        <div class="dashboard-welcome">
            <h1>Welcome back, @Model.FullName 👨‍🏫</h1>
            <p class="dashboard-subtitle">Guide students and track your impact</p>
        </div>
        <div class="dashboard-actions">
            <a asp-controller="Mentor" asp-action="MySessions" class="btn btn-primary">Manage Sessions</a>
            <a asp-controller="Mentor" asp-action="EditProfile" class="btn btn-secondary">Edit Profile</a>
        </div>
    </div>

    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon blue">👨‍🎓</div>
            <div class="stat-content">
                <div class="stat-number">@Model.ActiveMentees</div>
                <div class="stat-label">Active Mentees</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon purple">📝</div>
            <div class="stat-content">
                <div class="stat-number">@Model.TotalProjects</div>
                <div class="stat-label">Projects</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon amber">👥</div>
            <div class="stat-content">
                <div class="stat-number">@Model.TotalTeams</div>
                <div class="stat-label">Teams</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon gold">⭐</div>
            <div class="stat-content">
                <div class="stat-number">@Model.Rating.ToString("F1")</div>
                <div class="stat-label">Rating</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon cyan">📅</div>
            <div class="stat-content">
                <div class="stat-number">@Model.TotalSessions</div>
                <div class="stat-label">Total Sessions</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon green">📊</div>
            <div class="stat-content">
                <div class="stat-number">@Model.CompletionRateDisplay</div>
                <div class="stat-label">Completion Rate</div>
            </div>
        </div>
    </div>

    <div class="dashboard-grid">
        <div class="card">
            <div class="card-header" style="display:flex;justify-content:space-between;align-items:center;margin-bottom:var(--space-4);">
                <h3 style="margin:0;">Upcoming Sessions</h3>
                <a asp-controller="Mentor" asp-action="MySessions" class="btn btn-ghost btn-sm">View All</a>
            </div>
            @if (Model.UpcomingSessions.Any())
            {
                <div class="activity-list">
                    @foreach (var session in Model.UpcomingSessions)
                    {
                        <div class="activity-item">
                            <span class="activity-icon blue">📅</span>
                            <div class="activity-content">
                                <div class="activity-title">@session.Topic</div>
                                <div class="activity-description">with @session.StudentName · @session.ScheduledDisplay</div>
                            </div>
                            <span class="badge @session.StatusBadge">@session.Status</span>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted">No upcoming sessions.</p>
            }
        </div>

        <div class="card">
            <div class="card-header" style="display:flex;justify-content:space-between;align-items:center;margin-bottom:var(--space-4);">
                <h3 style="margin:0;">Recent Sessions</h3>
                <a asp-controller="Mentor" asp-action="MySessions" class="btn btn-ghost btn-sm">View All</a>
            </div>
            @if (Model.RecentSessions.Any())
            {
                <div class="activity-list">
                    @foreach (var session in Model.RecentSessions)
                    {
                        <div class="activity-item">
                            <span class="activity-icon green">✅</span>
                            <div class="activity-content">
                                <div class="activity-title">@session.Topic</div>
                                <div class="activity-description">with @session.StudentName · @session.ScheduledDisplay</div>
                            </div>
                            <span class="badge badge-teal">Completed</span>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted">No completed sessions yet.</p>
            }
        </div>

        <div class="card" style="grid-column: 1 / -1;">
            <div class="card-header" style="display:flex;justify-content:space-between;align-items:center;margin-bottom:var(--space-4);">
                <h3 style="margin:0;">Active Mentees</h3>
                <a asp-controller="Mentor" asp-action="MyMentees" class="btn btn-ghost btn-sm">View All</a>
            </div>
            @if (Model.ActiveMenteesList.Any())
            {
                <div class="mentor-list">
                    @foreach (var mentee in Model.ActiveMenteesList)
                    {
                        <div class="mentor-item" style="display:flex;align-items:center;gap:var(--space-3);padding:var(--space-3);border-bottom:1px solid var(--color-border);">
                            <div class="mentor-avatar" style="width:40px;height:40px;background:linear-gradient(135deg,#2F6FED,#15C6AE);border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;">
                                @mentee.StudentName.Substring(0, 1).ToUpper()
                            </div>
                            <div class="mentor-info" style="flex:1;">
                                <div class="mentor-name" style="font-weight:600;">@mentee.StudentName</div>
                                <div class="mentor-role" style="font-size:var(--fs-xs);color:var(--color-text-400);">Since @mentee.AssignedDisplay</div>
                            </div>
                            <span class="badge badge-blue">Active</span>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted">No active mentees yet.</p>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}
