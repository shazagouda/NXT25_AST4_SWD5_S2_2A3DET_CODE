@{
    ViewData["Title"] = "About";
    ViewData["Description"] = "A3DET CODE — From Learning to Earning. A unified educational and career platform.";
}

@section Styles {
    <link rel="stylesheet" href="~/css/about.css" asp-append-version="true" />
}

<section class="hero about-hero">
    <div class="container">
        <div class="about-hero-inner reveal">
            <span class="hero-badge">About A3DET CODE</span>
            <h1>From Learning to Earning.</h1>
            <p>
                We built A3DET CODE because graduating with theory and graduating with proof shouldn't be two different things.
                This is a unified educational and career platform that turns learners into job-ready professionals through
                real projects, real teams, and real industry simulation.
            </p>
        </div>
    </div>
</section>

<section class="gap-section">
    <div class="container">
        <div class="gap-grid">
            <div class="gap-text reveal">
                <span class="eyebrow">The Gap We Saw</span>
                <h2>Academic education stops where the industry actually begins.</h2>
                <p>
                    Most graduates leave university with grades, not evidence. They can describe a sorting algorithm but
                    can't show a shipped feature. A3DET CODE exists to close that exact gap — bridging academic learning
                    and the practical requirements of the software industry, with a direct pathway from learning to employment.
                </p>
            </div>
            <div class="gap-cards">
                <div class="gap-card reveal">
                    <h4>📐 Practical, project-based learning</h4>
                    <p>Mirroring real industry workflows instead of isolated assignments.</p>
                </div>
                <div class="gap-card reveal">
                    <h4>📊 Continuous, merit-based evaluation</h4>
                    <p>Tracking and validating progress with real scoring, not assumptions.</p>
                </div>
                <div class="gap-card reveal">
                    <h4>📁 Professional portfolio building</h4>
                    <p>Aligned with what the market is actually hiring for right now.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="stages-section">
    <div class="container">
        <div class="section-head reveal">
            <span class="eyebrow">How We're Structured</span>
            <h2>Three stages. One continuous track.</h2>
            <p>Every learner moves through the same progressive system — each stage builds directly on the one before it.</p>
        </div>
        <div class="stages-panel reveal">
            <div class="stage-track">
                <div class="stage-node is-complete">
                    <span class="stage-dot"></span>
                    <span class="stage-label">Level 0 — Discover</span>
                </div>
                <span class="stage-connector is-filled"></span>
                <div class="stage-node is-active">
                    <span class="stage-dot"></span>
                    <span class="stage-label">Level 1 — Experience</span>
                </div>
                <span class="stage-connector"></span>
                <div class="stage-node">
                    <span class="stage-dot"></span>
                    <span class="stage-label">Paid Mode</span>
                </div>
            </div>
            <div class="stage-cards">
                <div class="stage-card reveal">
                    <span class="stage-card-num">STAGE 01</span>
                    <h4>Discovery Phase</h4>
                    <p>Career guidance and a personality-based technical track assessment — no prior experience required.</p>
                </div>
                <div class="stage-card reveal">
                    <span class="stage-card-num">STAGE 02</span>
                    <h4>Experience Phase</h4>
                    <p>Team-based training and real-world project simulation, from planning through delivery.</p>
                </div>
                <div class="stage-card reveal">
                    <span class="stage-card-num">STAGE 03</span>
                    <h4>Paid Mode &amp; Industry Integration</h4>
                    <p>Professional mentorship, company engagement, and paid project execution.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="pillars-section">
    <div class="container">
        <div class="section-head reveal">
            <span class="eyebrow">What We Deliver</span>
            <h2>Five pillars, one value proposition</h2>
        </div>
        <div class="pillars-grid">
            <div class="pillar-card-modern reveal">
                <div class="pillar-icon blue">01</div>
                <h4>Real-World Experience</h4>
                <p>Users build genuine skills through structured, simulated industry projects.</p>
                <span class="pillar-number">01</span>
            </div>
            <div class="pillar-card-modern reveal">
                <div class="pillar-icon teal">02</div>
                <h4>Strong Portfolio Development</h4>
                <p>Automated, evidence-based portfolios that eliminate the experience paradox for new graduates.</p>
                <span class="pillar-number">02</span>
            </div>
            <div class="pillar-card-modern reveal">
                <div class="pillar-icon amber">03</div>
                <h4>Internal Job Market</h4>
                <p>An active marketplace connecting verified talent with companies that are actually hiring.</p>
                <span class="pillar-number">03</span>
            </div>
            <div class="pillar-card-modern reveal">
                <div class="pillar-icon blue">04</div>
                <h4>Fair Evaluation System</h4>
                <p>Multi-dimensional, merit-based assessments for transparent, unbiased recognition.</p>
                <span class="pillar-number">04</span>
            </div>
            <div class="pillar-card-modern reveal">
                <div class="pillar-icon teal">05</div>
                <h4>Direct Education-to-Employment Link</h4>
                <p>Shortening the real distance between learning something and getting paid for it.</p>
                <span class="pillar-number">05</span>
            </div>
            <div class="pillar-card-modern reveal" style="background:var(--color-navy-900);border:none;color:#fff;">
                <div class="pillar-icon" style="background:rgba(255,255,255,0.1);color:#fff;">★</div>
                <h4 style="color:#fff;">Built for learners who ship.</h4>
                <p style="color:var(--color-text-400);">Not another course platform — a place where progress is something you can point to.</p>
                <span class="pillar-number" style="color:var(--color-text-400);">06</span>
            </div>
        </div>
    </div>
</section>

<section class="stats-section">
    <div class="container">
        <div class="stats-band reveal">
            <div class="stats-grid">
                <div class="stat-item">
                    <div class="stat-value" data-counter="10">0</div>
                    <div class="stat-label">Technical Tracks</div>
                </div>
                <div class="stat-item">
                    <div class="stat-value" data-counter="12400">0</div>
                    <div class="stat-label">Learners Onboarded</div>
                </div>
                <div class="stat-item">
                    <div class="stat-value" data-counter="860">0</div>
                    <div class="stat-label">Projects Delivered</div>
                </div>
                <div class="stat-item">
                    <div class="stat-value" data-counter="140">0</div>
                    <div class="stat-label">Hiring Companies</div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="roles-section">
    <div class="container">
        <div class="section-head reveal">
            <span class="eyebrow">Who We Serve</span>
            <h2>One platform, three roles</h2>
        </div>
        <div class="roles-grid">
            <div class="role-card-modern reveal">
                <div class="role-icon">🎓</div>
                <span class="badge blue">Student</span>
                <h4>Learn it, build it, prove it.</h4>
                <p>Take the assessment, join a track, build real projects with a team, and walk away with a portfolio that speaks for itself.</p>
            </div>
            <div class="role-card-modern reveal">
                <div class="role-icon">👨‍🏫</div>
                <span class="badge teal">Mentor</span>
                <h4>Guide the next wave.</h4>
                <p>Review real project work, run mentorship sessions, and get ranked on a public leaderboard based on the impact you actually have.</p>
            </div>
            <div class="role-card-modern reveal">
                <div class="role-icon">🏢</div>
                <span class="badge amber">Company</span>
                <h4>Hire from verified work, not just resumes.</h4>
                <p>Browse portfolios, post paid project briefs, and hire individuals or full teams based on evaluated, real performance.</p>
            </div>
        </div>
    </div>
</section>

<section class="cta-section">
    <div class="container">
        <div class="cta-band reveal">
            <h2>Ready to be part of it?</h2>
            <p>Whether you're learning, mentoring, or hiring — there's a track for you.</p>
            <div class="cta-buttons">
                <a asp-controller="Account" asp-action="SignUp" class="btn btn-primary">Create an Account</a>
                <a asp-controller="ContactUs" asp-action="Index" class="btn btn-secondary" style="background:transparent;color:#fff;border-color:rgba(255,255,255,0.25);">Contact Us</a>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/about.js" asp-append-version="true"></script>
}