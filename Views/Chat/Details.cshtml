@model A3DET_CODE.ViewModels.Chat.ChatDetailsViewModel
@{
    ViewData["Title"] = Model.GroupName;
}

<!DOCTYPE html>
<html lang="ar" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>A3DET CODE | @Model.GroupName</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
            /* أنسخ نفس الـ CSS من Index.cshtml هنا (لأنه مكرر للتصميم) */
            :root {
                --teal-600: #0d9488;
                --teal-500: #14b8a6;
                --teal-400: #2dd4bf;
                --blue-600: #2563eb;
                --navy-900: #0f2942;
                --navy-800: #16324a;
                --ink: #0f172a;
                --muted: #64748b;
                --line: #e5edf3;
                --bg-page: #f3f8fb;
                --bg-hero-a: #eaf3fb;
                --bg-hero-b: #dce9f7;
                --card: #ffffff;
                --bubble-out: #0d9488;
                --bubble-in: #f1f5f9;
                --success: #22c55e;
                --radius-lg: 18px;
                --radius-md: 12px;
                --radius-full: 999px;
                --shadow-sm: 0 1px 2px rgba(15, 41, 66, .06);
                --shadow-md: 0 8px 24px rgba(15, 41, 66, .08);
            }

            * {
                box-sizing: border-box;
            }

            html, body {
                height: 100%;
            }

            body {
                margin: 0;
                font-family: 'Inter', system-ui, sans-serif;
                background: var(--bg-page);
                color: var(--ink);
                -webkit-font-smoothing: antialiased;
            }
            /* Navbar (نفس الموجود في Index) */
            .navbar {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 14px 40px;
                background: linear-gradient(180deg, var(--bg-hero-a), var(--bg-hero-b) 260%);
                border-bottom: 1px solid var(--line);
            }

            .navbar-left {
                display: flex;
                align-items: center;
                gap: 36px;
            }

            .brand {
                display: flex;
                align-items: center;
                gap: 10px;
                text-decoration: none;
                color: inherit;
            }

            .brand-mark {
                width: 36px;
                height: 36px;
                border-radius: 10px;
                background: linear-gradient(135deg, var(--teal-500), var(--blue-600));
                color: #fff;
                font-weight: 800;
                font-size: 13px;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .brand-name {
                font-weight: 800;
                font-size: 17px;
            }

                .brand-name span {
                    color: var(--teal-600);
                }

            .nav-links {
                display: flex;
                align-items: center;
                gap: 26px;
            }

                .nav-links a {
                    text-decoration: none;
                    color: var(--muted);
                    font-weight: 600;
                    font-size: 14.5px;
                    padding-bottom: 6px;
                    border-bottom: 2px solid transparent;
                    transition: color .15s ease, border-color .15s ease;
                }

                    .nav-links a:hover {
                        color: var(--navy-900);
                    }

                    .nav-links a.active {
                        color: var(--navy-900);
                        border-color: var(--teal-500);
                    }

                    .nav-links a.highlight {
                        color: var(--teal-600);
                    }

            .navbar-right {
                display: flex;
                align-items: center;
                gap: 14px;
            }

            .icon-btn {
                width: 38px;
                height: 38px;
                border-radius: var(--radius-full);
                background: #fff;
                border: 1px solid var(--line);
                display: flex;
                align-items: center;
                justify-content: center;
                cursor: pointer;
                position: relative;
                color: var(--navy-900);
                transition: box-shadow .15s ease;
            }

                .icon-btn:hover {
                    box-shadow: var(--shadow-sm);
                }

            .icon-dot {
                position: absolute;
                top: 6px;
                right: 7px;
                width: 7px;
                height: 7px;
                border-radius: 50%;
                background: #ef4444;
                border: 1.5px solid #fff;
            }

            .avatar-btn {
                width: 38px;
                height: 38px;
                border-radius: 50%;
                background: linear-gradient(135deg, var(--teal-500), var(--blue-600));
                color: #fff;
                font-weight: 700;
                font-size: 14px;
                display: flex;
                align-items: center;
                justify-content: center;
                cursor: pointer;
                border: none;
            }

            .logout-link {
                color: var(--navy-900);
                font-weight: 600;
                font-size: 14.5px;
                text-decoration: none;
            }

            /* Chat Window Styles */
            .chat-window {
                background: var(--card);
                border: 1px solid var(--line);
                border-radius: var(--radius-lg);
                box-shadow: var(--shadow-sm);
                display: flex;
                flex-direction: column;
                overflow: hidden;
                height: calc(100vh - 180px);
                max-width: 1200px;
                margin: 26px auto 40px;
            }

            .chat-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 16px 22px;
                border-bottom: 1px solid var(--line);
            }

            .chat-header-left {
                display: flex;
                align-items: center;
                gap: 12px;
            }

            .chat-header-name {
                font-weight: 800;
                font-size: 15.5px;
                color: var(--ink);
            }

            .chat-header-sub {
                font-size: 12.5px;
                color: var(--muted);
                display: flex;
                align-items: center;
                gap: 6px;
            }

                .chat-header-sub .dot {
                    width: 7px;
                    height: 7px;
                    border-radius: 50%;
                    background: var(--success);
                }

            .conv-avatar {
                width: 42px;
                height: 42px;
                border-radius: 50%;
                flex: none;
                display: flex;
                align-items: center;
                justify-content: center;
                color: #fff;
                font-weight: 700;
                font-size: 14px;
                position: relative;
            }

                .conv-avatar.group {
                    border-radius: 14px;
                }

                .conv-avatar .status-dot {
                    position: absolute;
                    bottom: -1px;
                    right: -1px;
                    width: 11px;
                    height: 11px;
                    border-radius: 50%;
                    background: var(--success);
                    border: 2px solid #fff;
                }

            .messages {
                flex: 1;
                overflow-y: auto;
                padding: 26px 26px 10px;
                display: flex;
                flex-direction: column;
                gap: 14px;
                background: radial-gradient(circle at 10% 0%, rgba(13, 148, 136, .03), transparent 40%), var(--card);
            }

            .day-divider {
                align-self: center;
                font-size: 11.5px;
                color: var(--muted);
                font-weight: 600;
                background: #f4f8fa;
                padding: 4px 12px;
                border-radius: var(--radius-full);
                margin: 6px 0;
            }

            .msg-row {
                display: flex;
                gap: 10px;
                max-width: 68%;
            }

                .msg-row.out {
                    align-self: flex-end;
                    flex-direction: row-reverse;
                }

            .msg-avatar {
                width: 30px;
                height: 30px;
                border-radius: 50%;
                flex: none;
                display: flex;
                align-items: center;
                justify-content: center;
                color: #fff;
                font-weight: 700;
                font-size: 11.5px;
            }

            .msg-bubble-wrap {
                display: flex;
                flex-direction: column;
                gap: 3px;
            }

            .msg-sender {
                font-size: 11.5px;
                font-weight: 700;
                color: var(--teal-600);
                padding: 0 4px;
            }

            .msg-row.out .msg-sender {
                display: none;
            }

            .msg-bubble {
                padding: 10px 14px;
                border-radius: 16px;
                font-size: 13.8px;
                line-height: 1.5;
                box-shadow: var(--shadow-sm);
            }

            .msg-row.in .msg-bubble {
                background: var(--bubble-in);
                color: var(--ink);
                border-bottom-left-radius: 4px;
            }

            .msg-row.out .msg-bubble {
                background: var(--bubble-out);
                color: #fff;
                border-bottom-right-radius: 4px;
            }

            .msg-time {
                font-size: 10.5px;
                color: var(--muted);
                padding: 0 4px;
            }

            .msg-row.out .msg-time {
                text-align: right;
            }

            .composer {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 16px 20px;
                border-top: 1px solid var(--line);
                background: #fff;
            }

            .composer-input-wrap {
                flex: 1;
                display: flex;
                align-items: center;
                gap: 8px;
                background: #f4f8fa;
                border: 1px solid var(--line);
                border-radius: var(--radius-full);
                padding: 6px 8px 6px 16px;
            }

                .composer-input-wrap input {
                    flex: 1;
                    border: none;
                    background: transparent;
                    outline: none;
                    font-size: 13.8px;
                    font-family: inherit;
                    color: var(--ink);
                }

            .attach-btn {
                width: 32px;
                height: 32px;
                border-radius: 50%;
                border: none;
                background: transparent;
                color: var(--muted);
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .send-btn {
                width: 42px;
                height: 42px;
                border-radius: 50%;
                border: none;
                flex: none;
                background: linear-gradient(135deg, var(--teal-500), var(--blue-600));
                color: #fff;
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: center;
                box-shadow: var(--shadow-sm);
                transition: transform .12s ease;
            }

                .send-btn:hover {
                    transform: scale(1.05);
                }
          

                .nav-links {
                    display: none;
                }

                .chat-window {
                    height: 80vh;
                    margin: 10px;
                }
            }

                .nav-links {
                    display: none;
                }

                .chat-window {
                    height: 80vh;
                    margin: 10px;
                }
            }
    </style>
</head>
<body>

    

    <div class="chat-window" style="height: calc(100vh - 170px); max-width: 1200px; margin: 20px auto 40px;">
        <div class="chat-header">
            <div class="chat-header-left">
                <div class="conv-avatar @(Model.IsGroup ? "group" : "")" style="background: @Model.AvatarColor">
                    @Model.AvatarLetter
                    @if (Model.IsOnline)
                    {
                        <span class="status-dot"></span>
                    }
                </div>
                <div>
                    <div class="chat-header-name">@Model.GroupName</div>
                    <div class="chat-header-sub">
                        @if (Model.IsGroup)
                        {
                            <span>فريق عمل</span>
                        }
                        else
                        {
                            @if (Model.IsOnline)
                            {
                                <span class="dot"></span> <span>متصل الآن</span>
                            }
                            else
                            {
                                <span>غير متصل</span>
                            }
                        }
                    </div>
                </div>
            </div>
            <div>
                <a href="/Chat" class="icon-btn" title="رجوع للقائمة">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7" /></svg>
                </a>
            </div>
        </div>

        <div class="messages" id="messagesArea">
            <div class="day-divider">اليوم</div>
            @foreach (var msg in Model.Messages)
            {
                <div class="msg-row @(msg.IsMine ? "out" : "in")">
                    <div class="msg-avatar" style="background: @(msg.IsMine ? "linear-gradient(135deg,#0d9488,#2563eb)" : "#94a3b8")">
                        @msg.SenderName.Substring(0, 1).ToUpper()
                    </div>
                    <div class="msg-bubble-wrap">
                        <div class="msg-sender">@msg.SenderName</div>
                        <div class="msg-bubble">@msg.Content</div>
                        <div class="msg-time">@msg.TimeDisplay</div>
                    </div>
                </div>
            }
        </div>

        <div class="composer">
            <button class="attach-btn" title="إرفاق ملف">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.44 11.05l-9.19 9.19a5 5 0 01-7.07-7.07l9.19-9.19a3.5 3.5 0 014.95 4.95l-9.2 9.19a2 2 0 01-2.83-2.83l8.49-8.48" /></svg>
            </button>
            <div class="composer-input-wrap">
                <input type="text" id="messageInput" placeholder="اكتب رسالة...">
            </div>
            <button class="send-btn" id="sendBtn" title="إرسال">
                <svg width="17" height="17" viewBox="0 0 22 22" fill="none" stroke="white" stroke-width="2.2"><path d="M22 2L11 13" /><path d="M22 2l-7 20-4-9-9-4z" /></svg>
            </button>
        </div>
    </div>

    @section Scripts {
        <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
        <script>
            const groupId = @Model.GroupId;
            const currentUserId = '@Model.CurrentUserId';
            const messagesArea = document.getElementById('messagesArea');

            const connection = new signalR.HubConnectionBuilder()
            .withUrl("/chatHub")
            .build();

            connection.start()
            .then(() => {
            console.log("✅ SignalR متصل");
            connection.invoke("JoinGroup", groupId)
            .catch(err => console.error("❌ فشل الانضمام للمجموعة", err));
            })
            .catch(err => console.error("❌ فشل اتصال SignalR", err));

            connection.on("ReceiveMessage", (message) => {
            const isMine = message.senderId === currentUserId;
            const html = `
            <div class="msg-row ${isMine ? 'out' : 'in'}">
            <div class="msg-avatar" style="background: ${isMine ? 'linear-gradient(135deg,#0d9488,#2563eb)' : '#94a3b8'}">
            ${message.senderName.charAt(0).toUpperCase()}
            </div>
            <div class="msg-bubble-wrap">
            <div class="msg-sender">${message.senderName}</div>
            <div class="msg-bubble">${message.content}</div>
            <div class="msg-time">${new Date(message.sentAt).toLocaleTimeString()}</div>
            </div>
            </div>
            `;
            messagesArea.insertAdjacentHTML('beforeend', html);
            messagesArea.scrollTop = messagesArea.scrollHeight;
            });

            function sendMessage() {
            const input = document.getElementById('messageInput');
            const content = input.value.trim();
            if (!content) return;

            connection.invoke("SendMessage", groupId, content)
            .then(() => {
            input.value = '';
            input.focus();
            })
            .catch(err => console.error("❌ فشل الإرسال", err));
            }

            document.getElementById('sendBtn').addEventListener('click', sendMessage);
            document.getElementById('messageInput').addEventListener('keydown', (e) => {
            if (e.key === 'Enter') {
            e.preventDefault();
            sendMessage();
            }
            });

            messagesArea.scrollTop = messagesArea.scrollHeight;
        </script>
    }
</body>
</html>