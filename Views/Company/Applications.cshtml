@model IEnumerable<A3DET_CODE.Models.Application>
@{
    ViewData["Title"] = "Applications";
}

<div class="container py-4">
    <h2 class="mb-4">Project Applications</h2>
    <div class="row g-4">
        @foreach (var application in Model)
        {
            <div class="col-12">
                <div class="card shadow-sm border-0">
                    <div class="card-body d-flex justify-content-between align-items-start flex-wrap gap-3">
                        <div>
                            <h5 class="card-title mb-1">@application.Applicant?.FullName</h5>
                            <p class="text-muted mb-1">Applied to: @application.Project?.Title</p>
                            <p class="mb-2">@application.CoverLetter</p>
                            <span class="badge bg-info text-dark">@application.Status</span>
                        </div>
                        <div class="d-flex gap-2">
                            <form asp-action="Hire" method="post">
                                <input type="hidden" name="applicationId" value="@application.Id" />
                                <input type="hidden" name="decision" value="Accept" />
                                <button type="submit" class="btn btn-success btn-sm">Accept</button>
                            </form>
                            <form asp-action="Hire" method="post">
                                <input type="hidden" name="applicationId" value="@application.Id" />
                                <input type="hidden" name="decision" value="Reject" />
                                <button type="submit" class="btn btn-outline-danger btn-sm">Reject</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
