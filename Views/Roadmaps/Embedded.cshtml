@{
    ViewData["Title"] = "Embedded Track";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/tracks/Style/style.css" asp-append-version="true" />
}

<!-- HERO -->
<section class="hero-section" id="hero">
    <div class="hero-grid-bg"></div>
    <div class="container">
        <div class="row min-vh-100 align-items-center">
            <div class="col-12 col-lg-8">
                <div class="hero-tag mb-3" data-aos="fade-up">
                    <i class="bi bi-cpu-fill"></i> Beginner's Guide to Embedded Systems
                </div>
                <h1 class="hero-title" data-aos="fade-up" data-aos-delay="100">
                    Everything You Need<br />
                    to Know About
                    <span class="highlight-text"> Embedded</span>
                </h1>
                <p class="hero-subtitle" data-aos="fade-up" data-aos-delay="200">
                    From your first blinking LED to programming a real Microcontroller — a clear, simple guide without complexity.
                </p>
                <div class="hero-actions d-flex flex-wrap gap-3 mt-5" data-aos="fade-up" data-aos-delay="300">
                    <a href="#what-is" class="btn-primary-custom">
                        Start the Journey <i class="bi bi-arrow-left ms-2"></i>
                    </a>
                    <a href="#comparison" class="btn-secondary-custom">
                        Compare Platforms & Tools
                    </a>
                </div>
            </div>

            <!-- Hero code block -->
            <div class="col-12 col-lg-4 d-none d-lg-block">
                <div class="hero-code-block" data-aos="fade-left" data-aos-delay="400">
                    <div class="code-header">
                        <span class="dot red"></span>
                        <span class="dot yellow"></span>
                        <span class="dot green"></span>
                        <span class="code-filename">main.c</span>
                    </div>
                    <div class="code-body" id="heroCodeBlock">
                        <div class="code-line"><span class="kw">#include</span> <span class="str">&lt;avr/io.h&gt;</span></div>
                        <div class="code-line"><span class="kw">#include</span> <span class="str">&lt;util/delay.h&gt;</span></div>
                        <div class="code-line mt-1"><span class="kw">int</span> <span class="fn">main</span>(<span class="kw">void</span>) {</div>
                        <div class="code-line pl-2"><span class="var">DDRB</span> |= (<span class="fn">1</span> &lt;&lt; <span class="var">PB5</span>);</div>
                        <div class="code-line pl-2"><span class="kw">while</span>(<span class="fn">1</span>) {</div>
                        <div class="code-line pl-3"><span class="var">PORTB</span> ^= (<span class="fn">1</span> &lt;&lt; <span class="var">PB5</span>);</div>
                        <div class="code-line pl-3"><span class="fn">_delay_ms</span>(<span class="fn">500</span>);</div>
                        <div class="code-line pl-2">}</div>
                        <div class="code-line">}</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="hero-scroll-hint">
        <div class="scroll-mouse"><div class="scroll-wheel"></div></div>
        <span>Scroll Down</span>
    </div>
</section>

<!-- WHAT IS EMBEDDED -->
<section class="section-block" id="what-is">
    <div class="container">
        <div class="section-header text-center mb-5" data-aos="fade-up">
            <span class="section-tag">The Basics</span>
            <h2 class="section-title">What is Embedded Systems?</h2>
            <p class="section-subtitle">
                Embedded Systems are the code that runs inside devices — not on a computer. The refrigerator, microwave, car, smartwatch — they all have code written by an Embedded Engineer.
            </p>
        </div>

        <div class="analogy-card mb-5" data-aos="fade-up">
            <div class="analogy-icon"><i class="bi bi-motherboard-fill"></i></div>
            <div class="analogy-content">
                <h4>Think of it Like This</h4>
                <p>
                    If regular programming is like writing a message on paper — Embedded is like carving the words into stone.
                    <strong>Every byte matters, every millisecond counts, and the electricity itself is in your calculations.</strong>
                    This is the track where your code directly controls the physical world.
                </p>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-12 col-md-4" data-aos="fade-up" data-aos-delay="0">
                <div class="pillar-card" data-pillar="hw">
                    <div class="pillar-icon"><i class="bi bi-motherboard-fill"></i></div>
                    <div class="pillar-number">01</div>
                    <h3 class="pillar-title">Hardware Basics</h3>
                    <p class="pillar-desc">You need to understand basic electricity — Voltage, Current, Resistance. GPIO, ADC, UART, SPI, and I2C are your gateway to communicating with the real world.</p>
                    <div class="pillar-tag">Know Your Hardware</div>
                </div>
            </div>
            <div class="col-12 col-md-4" data-aos="fade-up" data-aos-delay="100">
                <div class="pillar-card" data-pillar="c">
                    <div class="pillar-icon"><i class="bi bi-code-square"></i></div>
                    <div class="pillar-number">02</div>
                    <h3 class="pillar-title">C Programming</h3>
                    <p class="pillar-desc">C is the language of Embedded. It gives you direct control over Memory and Hardware. Pointers, Bit Manipulation, and the Memory Map aren't optional — they're the foundation.</p>
                    <div class="pillar-tag">C is King</div>
                </div>
            </div>
            <div class="col-12 col-md-4" data-aos="fade-up" data-aos-delay="200">
                <div class="pillar-card" data-pillar="rtos">
                    <div class="pillar-icon"><i class="bi bi-clock-history"></i></div>
                    <div class="pillar-number">03</div>
                    <h3 class="pillar-title">Real-Time Systems</h3>
                    <p class="pillar-desc">Real-Time doesn't mean fast — it means <strong>at the exact right time</strong>. Timing Constraints, Interrupts, and RTOS are what make a car's braking system work.</p>
                    <div class="pillar-tag">Timing is Everything</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- EMBEDDED ECOSYSTEM INTRO -->
<section class="section-block section-dark" id="frameworks-intro">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-12 col-lg-6" data-aos="fade-right">
                <span class="section-tag light">Core Concept</span>
                <h2 class="section-title light">Microcontroller vs Microprocessor?</h2>
                <p class="section-subtitle light">
                    The first question in Embedded. A Microcontroller like Arduino and STM32 — has CPU, Memory, and Peripherals all in one chip. A Microprocessor like the one in Raspberry Pi — much more powerful but requires external components.
                </p>
                <p class="section-subtitle light">
                    <strong>For beginners: Start with Arduino.</strong> Once you understand the concepts — move to STM32 or ESP32 and you'll feel the real difference.
                </p>
                <div class="benefits-list mt-4">
                    <div class="benefit-item"><i class="bi bi-check-lg"></i> Arduino — The ideal starting point, easiest environment</div>
                    <div class="benefit-item"><i class="bi bi-check-lg"></i> STM32 — The real pro in industry</div>
                    <div class="benefit-item"><i class="bi bi-check-lg"></i> ESP32 — IoT and WiFi at the lowest cost</div>
                    <div class="benefit-item"><i class="bi bi-check-lg"></i> Raspberry Pi — When you need Linux on Hardware</div>
                    <div class="benefit-item"><i class="bi bi-check-lg"></i> RISC-V — The open-source future</div>
                </div>
            </div>
            <div class="col-12 col-lg-6" data-aos="fade-left">
                <div class="framework-visual">
                    <div class="fv-center">
                        <i class="bi bi-cpu-fill"></i>
                        <span>MCU</span>
                    </div>
                    <div class="fv-orbit">
                        <div class="fv-satellite" style="--i:0"><span class="fw-arduino"><i class="bi bi-lightning-fill"></i></span></div>
                        <div class="fv-satellite" style="--i:1"><span class="fw-stm32"><i class="bi bi-cpu"></i></span></div>
                        <div class="fv-satellite" style="--i:2"><span class="fw-esp32"><i class="bi bi-wifi"></i></span></div>
                        <div class="fv-satellite" style="--i:3"><span class="fw-rpi"><i class="bi bi-pie-chart-fill"></i></span></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- PLATFORMS DEEP DIVE -->
<section class="section-block" id="frameworks">
    <div class="container">
        <div class="section-header text-center mb-5" data-aos="fade-up">
            <span class="section-tag">Platforms & Tools</span>
            <h2 class="section-title">Most Popular Embedded Platforms in Detail</h2>
            <p class="section-subtitle">Learn about each platform — its strengths, who's behind it, and when to use it.</p>
        </div>

        <div class="fw-tabs-wrapper" data-aos="fade-up">
            <div class="fw-tabs d-flex gap-2 flex-wrap mb-4" id="fwTabs">
                <button class="fw-tab active" data-fw="arduino">
                    <i class="bi bi-lightning-fill"></i> Arduino
                </button>
                <button class="fw-tab" data-fw="stm32">
                    <i class="bi bi-cpu"></i> STM32
                </button>
                <button class="fw-tab" data-fw="esp32">
                    <i class="bi bi-wifi"></i> ESP32
                </button>
                <button class="fw-tab" data-fw="rpi">
                    <i class="bi bi-pie-chart-fill"></i> Raspberry Pi
                </button>
                <button class="fw-tab" data-fw="rtos">
                    <i class="bi bi-clock-history"></i> FreeRTOS
                </button>
            </div>
            <div class="fw-panel" id="fwPanel"></div>
        </div>
    </div>
</section>

<!-- COMPARISON TABLE -->
<section class="section-block section-light-alt" id="comparison">
    <div class="container">
        <div class="section-header text-center mb-5" data-aos="fade-up">
            <span class="section-tag">Comparison</span>
            <h2 class="section-title">Comprehensive Platform Comparison</h2>
            <p class="section-subtitle">A clear table to help you see the differences at a glance.</p>
        </div>
        <div class="table-wrapper" data-aos="fade-up">
            <div class="table-responsive">
                <table class="comparison-table w-100">
                    <thead>
                        <tr>
                            <th>Metric</th>
                            <th><i class="bi bi-lightning-fill"></i> Arduino</th>
                            <th><i class="bi bi-cpu"></i> STM32</th>
                            <th><i class="bi bi-wifi"></i> ESP32</th>
                            <th><i class="bi bi-pie-chart-fill"></i> Raspberry Pi</th>
                            <th><i class="bi bi-clock-history"></i> FreeRTOS</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="criterion">Ease of Start</td>
                            <td><span class="level easy">Very Easy</span></td>
                            <td><span class="level hard">Hard</span></td>
                            <td><span class="level medium">Medium</span></td>
                            <td><span class="level easy">Easy</span></td>
                            <td><span class="level hard">Hard</span></td>
                        </tr>
                        <tr>
                            <td class="criterion">Performance</td>
                            <td><div class="perf-bar" data-perf="30"></div></td>
                            <td><div class="perf-bar" data-perf="90"></div></td>
                            <td><div class="perf-bar" data-perf="75"></div></td>
                            <td><div class="perf-bar" data-perf="95"></div></td>
                            <td><div class="perf-bar" data-perf="85"></div></td>
                        </tr>
                        <tr>
                            <td class="criterion">Industry Use</td>
                            <td><span class="level medium">Prototyping</span></td>
                            <td><span class="level easy">Essential</span></td>
                            <td><span class="level easy">IoT Excellent</span></td>
                            <td><span class="level medium">Linux Embedded</span></td>
                            <td><span class="level easy">Essential</span></td>
                        </tr>
                        <tr>
                            <td class="criterion">Cost</td>
                            <td><span class="stars">★★★★★</span></td>
                            <td><span class="stars">★★★★☆</span></td>
                            <td><span class="stars">★★★★★</span></td>
                            <td><span class="stars">★★★★☆</span></td>
                            <td><span class="stars">★★★★★</span></td>
                        </tr>
                        <tr>
                            <td class="criterion">Primary Function</td>
                            <td>Rapid Prototyping</td>
                            <td>Industrial & Automotive</td>
                            <td>IoT & Wireless</td>
                            <td>Embedded Linux</td>
                            <td>Real-Time Scheduling</td>
                        </tr>
                        <tr>
                            <td class="criterion">Start With It When?</td>
                            <td>Day One</td>
                            <td>After Arduino</td>
                            <td>Need WiFi/BT</td>
                            <td>Need Linux</td>
                            <td>After STM32</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

<!-- QUIZ -->
<section class="section-block section-dark" id="quiz">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-8">
                <div class="section-header text-center mb-5" data-aos="fade-up">
                    <span class="section-tag light">Discover Yourself</span>
                    <h2 class="section-title light">Which Platform Should You Start With?</h2>
                    <p class="section-subtitle light">Answer 3 questions and we'll suggest the best fit.</p>
                </div>
                <div class="quiz-card" id="quizCard" data-aos="fade-up">
                    <div class="quiz-progress-bar"><div class="quiz-progress-fill" id="quizProgressFill"></div></div>
                    <div class="quiz-step-indicator" id="quizStepIndicator">Question 1 of 3</div>
                    <div class="quiz-content" id="quizContent"></div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ROADMAP -->
<section class="section-block" id="roadmap">
    <div class="container">
        <div class="section-header text-center mb-5" data-aos="fade-up">
            <span class="section-tag">Roadmap</span>
            <h2 class="section-title">Where Do You Start?</h2>
            <p class="section-subtitle">The right steps, in the right order.</p>
        </div>
        <div class="roadmap-timeline" id="roadmapTimeline"></div>
    </div>
</section>

@section Scripts {
    <script src="~/tracks/Embedded/app.js" asp-append-version="true"></script>
}