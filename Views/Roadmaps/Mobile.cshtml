@{
    ViewData["Title"] = "Mobile Track";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/tracks/Style/style.css" asp-append-version="true" />
}

<!-- HERO -->
<section class="hero-section" id="hero">
    <div class="hero-grid-bg"></div>
    <div class="container">
        <div class="row min-vh-100 align-items-center">
            <div class="col-12 col-lg-8">
                <div class="hero-tag mb-3" data-aos="fade-up">
                    <i class="bi bi-phone-fill"></i> Beginner's Guide to Mobile Development
                </div>
                <h1 class="hero-title" data-aos="fade-up" data-aos-delay="100">
                    Everything You Need<br />
                    to Know About
                    <span class="highlight-text"> Mobile Dev</span>
                </h1>
                <p class="hero-subtitle" data-aos="fade-up" data-aos-delay="200">
                    From your first screen to choosing the right Framework and publishing your app — a clear, simple guide without complexity.
                </p>
                <div class="hero-actions d-flex flex-wrap gap-3 mt-5" data-aos="fade-up" data-aos-delay="300">
                    <a href="#what-is" class="btn-primary-custom">
                        Start the Journey <i class="bi bi-arrow-left ms-2"></i>
                    </a>
                    <a href="#comparison" class="btn-secondary-custom">
                        Compare Frameworks
                    </a>
                </div>
            </div>

            <!-- Hero code block -->
            <div class="col-12 col-lg-4 d-none d-lg-block">
                <div class="hero-code-block" data-aos="fade-left" data-aos-delay="400">
                    <div class="code-header">
                        <span class="dot red"></span>
                        <span class="dot yellow"></span>
                        <span class="dot green"></span>
                        <span class="code-filename">HomeScreen.dart</span>
                    </div>
                    <div class="code-body" id="heroCodeBlock">
                        <div class="code-line"><span class="kw">class</span> <span class="var">HomeScreen</span> <span class="kw">extends</span> <span class="fn">StatelessWidget</span> {</div>
                        <div class="code-line pl-2"><span class="prop">@@override</span></div>
                        <div class="code-line pl-2"><span class="fn">Widget</span> <span class="method">build</span>(<span class="var">context</span>) {</div>
                        <div class="code-line pl-3"><span class="kw">return</span> <span class="fn">Scaffold</span>(</div>
                        <div class="code-line pl-4"><span class="prop">appBar</span>: <span class="fn">AppBar</span>(</div>
                        <div class="code-line pl-5"><span class="prop">title</span>: <span class="fn">Text</span>(<span class="str">'Hello'</span>),</div>
                        <div class="code-line pl-4">),</div>
                        <div class="code-line pl-4"><span class="prop">body</span>: <span class="fn">Center</span>(</div>
                        <div class="code-line pl-5"><span class="prop">child</span>: <span class="fn">Text</span>(<span class="str">'Your App Here'</span>),</div>
                        <div class="code-line pl-4">),</div>
                        <div class="code-line pl-3">);</div>
                        <div class="code-line pl-2">}</div>
                        <div class="code-line">}</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="hero-scroll-hint">
        <div class="scroll-mouse"><div class="scroll-wheel"></div></div>
        <span>Scroll Down</span>
    </div>
</section>

<!-- WHAT IS MOBILE DEV -->
<section class="section-block" id="what-is">
    <div class="container">
        <div class="section-header text-center mb-5" data-aos="fade-up">
            <span class="section-tag">The Basics</span>
            <h2 class="section-title">What is Mobile Development?</h2>
            <p class="section-subtitle">
                Mobile Dev is building applications that run in people's hands. 7 billion people have mobile phones — the app you build reaches them all without needing to open a computer.
            </p>
        </div>

        <div class="analogy-card mb-5" data-aos="fade-up">
            <div class="analogy-icon"><i class="bi bi-shop-window"></i></div>
            <div class="analogy-content">
                <h4>Think of it Like This</h4>
                <p>
                    The App Store and Play Store are like <strong>the biggest mall in the world</strong> — open 24/7, with billions of customers, and your app could reach all of them.
                    The difference between Mobile Dev and other tracks is that your product is <strong>literally in the user's hand</strong> — that's both responsibility and opportunity at the same time.
                </p>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-12 col-md-4" data-aos="fade-up" data-aos-delay="0">
                <div class="pillar-card" data-pillar="native">
                    <div class="pillar-icon"><i class="bi bi-phone-fill"></i></div>
                    <div class="pillar-number">01</div>
                    <h3 class="pillar-title">Native Development</h3>
                    <p class="pillar-desc">Each Platform has its own language — Swift for iOS and Kotlin for Android. The highest performance and full access to all device features. The choice when performance is your top priority.</p>
                    <div class="pillar-tag">Maximum Performance</div>
                </div>
            </div>
            <div class="col-12 col-md-4" data-aos="fade-up" data-aos-delay="100">
                <div class="pillar-card" data-pillar="cross">
                    <div class="pillar-icon"><i class="bi bi-intersect"></i></div>
                    <div class="pillar-number">02</div>
                    <h3 class="pillar-title">Cross-Platform</h3>
                    <p class="pillar-desc">One codebase that runs on both iOS and Android. Flutter and React Native are the most popular. Faster development and lower cost — the smart choice for most projects.</p>
                    <div class="pillar-tag">Write Once, Run Anywhere</div>
                </div>
            </div>
            <div class="col-12 col-md-4" data-aos="fade-up" data-aos-delay="200">
                <div class="pillar-card" data-pillar="ux">
                    <div class="pillar-icon"><i class="bi bi-hand-index-thumb-fill"></i></div>
                    <div class="pillar-number">03</div>
                    <h3 class="pillar-title">Mobile UX</h3>
                    <p class="pillar-desc">Users swipe, tap, and rotate the screen. Touch interactions, gestures, and accessibility aren't details — they're the core of the mobile experience.</p>
                    <div class="pillar-tag">Thumb-Friendly Design</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- MOBILE ECOSYSTEM INTRO -->
<section class="section-block section-dark" id="frameworks-intro">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-12 col-lg-6" data-aos="fade-right">
                <span class="section-tag light">Core Concept</span>
                <h2 class="section-title light">Native vs Cross-Platform?</h2>
                <p class="section-subtitle light">
                    The first question you'll face in Mobile Dev. The answer isn't one-size-fits-all — it depends on your project, budget, and goals.
                </p>
                <p class="section-subtitle light">
                    <strong>Cross-Platform</strong> like Flutter and React Native have reached a level where 90% of projects don't need separate Native tracks. <strong>Until you know you need Native — start Cross-Platform.</strong>
                </p>
                <div class="benefits-list mt-4">
                    <div class="benefit-item"><i class="bi bi-check-lg"></i> Flutter — Fastest growth, most beautiful UI, strongest performance</div>
                    <div class="benefit-item"><i class="bi bi-check-lg"></i> React Native — If you already know JavaScript</div>
                    <div class="benefit-item"><i class="bi bi-check-lg"></i> Swift — If iOS is your only target</div>
                    <div class="benefit-item"><i class="bi bi-check-lg"></i> Kotlin — If Android is your only target</div>
                    <div class="benefit-item"><i class="bi bi-check-lg"></i> .NET MAUI — If you know C#</div>
                </div>
            </div>
            <div class="col-12 col-lg-6" data-aos="fade-left">
                <div class="framework-visual">
                    <div class="fv-center">
                        <i class="bi bi-phone-fill"></i>
                        <span>Mobile</span>
                    </div>
                    <div class="fv-orbit">
                        <div class="fv-satellite" style="--i:0"><span class="fw-flutter"><i class="bi bi-phone-landscape-fill"></i></span></div>
                        <div class="fv-satellite" style="--i:1"><span class="fw-rn"><i class="bi bi-phone-fill"></i></span></div>
                        <div class="fv-satellite" style="--i:2"><span class="fw-swift"><i class="bi bi-apple"></i></span></div>
                        <div class="fv-satellite" style="--i:3"><span class="fw-kotlin"><i class="bi bi-android2"></i></span></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- FRAMEWORKS DEEP DIVE -->
<section class="section-block" id="frameworks">
    <div class="container">
        <div class="section-header text-center mb-5" data-aos="fade-up">
            <span class="section-tag">Tools & Frameworks</span>
            <h2 class="section-title">Most Popular Mobile Dev Frameworks in Detail</h2>
            <p class="section-subtitle">Learn about each Framework — its strengths, who's behind it, and when to use it.</p>
        </div>

        <div class="fw-tabs-wrapper" data-aos="fade-up">
            <div class="fw-tabs d-flex gap-2 flex-wrap mb-4" id="fwTabs">
                <button class="fw-tab active" data-fw="flutter">
                    <i class="bi bi-phone-landscape-fill"></i> Flutter
                </button>
                <button class="fw-tab" data-fw="rn">
                    <i class="bi bi-phone-fill"></i> React Native
                </button>
                <button class="fw-tab" data-fw="swift">
                    <i class="bi bi-apple"></i> Swift
                </button>
                <button class="fw-tab" data-fw="kotlin">
                    <i class="bi bi-android2"></i> Kotlin
                </button>
                <button class="fw-tab" data-fw="maui">
                    <i class="bi bi-microsoft"></i> .NET MAUI
                </button>
            </div>
            <div class="fw-panel" id="fwPanel"></div>
        </div>
    </div>
</section>

<!-- COMPARISON TABLE -->
<section class="section-block section-light-alt" id="comparison">
    <div class="container">
        <div class="section-header text-center mb-5" data-aos="fade-up">
            <span class="section-tag">Comparison</span>
            <h2 class="section-title">Comprehensive Framework Comparison</h2>
            <p class="section-subtitle">A clear table to help you see the differences at a glance.</p>
        </div>
        <div class="table-wrapper" data-aos="fade-up">
            <div class="table-responsive">
                <table class="comparison-table w-100">
                    <thead>
                        <tr>
                            <th>Metric</th>
                            <th><i class="bi bi-phone-landscape-fill"></i> Flutter</th>
                            <th><i class="bi bi-phone-fill"></i> React Native</th>
                            <th><i class="bi bi-apple"></i> Swift</th>
                            <th><i class="bi bi-android2"></i> Kotlin</th>
                            <th><i class="bi bi-microsoft"></i> .NET MAUI</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="criterion">Ease of Start</td>
                            <td><span class="level medium">Medium</span></td>
                            <td><span class="level easy">Easy if you know JS</span></td>
                            <td><span class="level medium">Medium</span></td>
                            <td><span class="level medium">Medium</span></td>
                            <td><span class="level easy">Easy if you know C#</span></td>
                        </tr>
                        <tr>
                            <td class="criterion">Performance</td>
                            <td><div class="perf-bar" data-perf="92"></div></td>
                            <td><div class="perf-bar" data-perf="78"></div></td>
                            <td><div class="perf-bar" data-perf="99"></div></td>
                            <td><div class="perf-bar" data-perf="99"></div></td>
                            <td><div class="perf-bar" data-perf="80"></div></td>
                        </tr>
                        <tr>
                            <td class="criterion">Platforms</td>
                            <td><span class="level easy">iOS + Android + Web</span></td>
                            <td><span class="level easy">iOS + Android</span></td>
                            <td><span class="level hard">iOS Only</span></td>
                            <td><span class="level hard">Android Only</span></td>
                            <td><span class="level easy">iOS + Android + Desktop</span></td>
                        </tr>
                        <tr>
                            <td class="criterion">Job Opportunities</td>
                            <td><span class="stars">★★★★★</span></td>
                            <td><span class="stars">★★★★☆</span></td>
                            <td><span class="stars">★★★★☆</span></td>
                            <td><span class="stars">★★★★☆</span></td>
                            <td><span class="stars">★★★☆☆</span></td>
                        </tr>
                        <tr>
                            <td class="criterion">Backed By</td>
                            <td>Google</td>
                            <td>Meta</td>
                            <td>Apple</td>
                            <td>JetBrains + Google</td>
                            <td>Microsoft</td>
                        </tr>
                        <tr>
                            <td class="criterion">Start With It When?</td>
                            <td>Day One</td>
                            <td>Know React? Start here</td>
                            <td>iOS is your goal</td>
                            <td>Android is your goal</td>
                            <td>Coming from .NET</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

<!-- QUIZ -->
<section class="section-block section-dark" id="quiz">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-8">
                <div class="section-header text-center mb-5" data-aos="fade-up">
                    <span class="section-tag light">Discover Yourself</span>
                    <h2 class="section-title light">Which Framework Fits You?</h2>
                    <p class="section-subtitle light">Answer 3 questions and we'll suggest the best fit.</p>
                </div>
                <div class="quiz-card" id="quizCard" data-aos="fade-up">
                    <div class="quiz-progress-bar"><div class="quiz-progress-fill" id="quizProgressFill"></div></div>
                    <div class="quiz-step-indicator" id="quizStepIndicator">Question 1 of 3</div>
                    <div class="quiz-content" id="quizContent"></div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ROADMAP -->
<section class="section-block" id="roadmap">
    <div class="container">
        <div class="section-header text-center mb-5" data-aos="fade-up">
            <span class="section-tag">Roadmap</span>
            <h2 class="section-title">Where Do You Start?</h2>
            <p class="section-subtitle">The right steps, in the right order.</p>
        </div>
        <div class="roadmap-timeline" id="roadmapTimeline"></div>
    </div>
</section>

@section Scripts {
    <script src="~/tracks/Mobile/app.js" asp-append-version="true"></script>
}