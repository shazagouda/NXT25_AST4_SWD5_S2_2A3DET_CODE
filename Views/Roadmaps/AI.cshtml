@{
    ViewData["Title"] = "AI Track";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/tracks/Style/style.css" asp-append-version="true" />
}

<!-- HERO -->
<section class="hero-section" id="hero">
    <div class="hero-grid-bg"></div>
    <div class="container">
        <div class="row min-vh-100 align-items-center">
            <div class="col-12 col-lg-8">
                <div class="hero-tag mb-3" data-aos="fade-up">
                    <i class="bi bi-robot"></i> Beginner's Guide to AI / Machine Learning
                </div>
                <h1 class="hero-title" data-aos="fade-up" data-aos-delay="100">
                    Everything You Need<br />
                    to Know About
                    <span class="highlight-text"> AI / ML</span>
                </h1>
                <p class="hero-subtitle" data-aos="fade-up" data-aos-delay="200">
                    From your first Model to understanding how machines learn — a clear, simple guide without complexity.
                </p>
                <div class="hero-actions d-flex flex-wrap gap-3 mt-5" data-aos="fade-up" data-aos-delay="300">
                    <a href="#what-is" class="btn-primary-custom">
                        Start the Journey <i class="bi bi-arrow-left ms-2"></i>
                    </a>
                    <a href="#comparison" class="btn-secondary-custom">
                        Compare Tools & Libraries
                    </a>
                </div>
            </div>
            <div class="col-12 col-lg-4 d-none d-lg-block">
                <div class="hero-code-block" data-aos="fade-left" data-aos-delay="400">
                    <div class="code-header">
                        <span class="dot red"></span>
                        <span class="dot yellow"></span>
                        <span class="dot green"></span>
                        <span class="code-filename">train_model.py</span>
                    </div>
                    <div class="code-body" id="heroCodeBlock">
                        <div class="code-line"><span class="kw">import</span> <span class="var">torch</span></div>
                        <div class="code-line"><span class="kw">from</span> <span class="var">transformers</span> <span class="kw">import</span> <span class="fn">AutoModel</span></div>
                        <div class="code-line mt-1"><span class="var">model</span> = <span class="fn">AutoModel</span>.<span class="method">from_pretrained</span>(</div>
                        <div class="code-line pl-3"><span class="str">'bert-base-uncased'</span></div>
                        <div class="code-line">)</div>
                        <div class="code-line mt-1"><span class="var">loss</span> = <span class="var">model</span>.<span class="method">train</span>(<span class="var">data</span>)</div>
                        <div class="code-line"><span class="fn">print</span>(<span class="str">f'Loss: </span>{<span class="var">loss</span>}<span class="str">'</span>)</div>
                        <div class="code-line mt-1"><span class="comment"># The machine is learning from you</span></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="hero-scroll-hint">
        <div class="scroll-mouse"><div class="scroll-wheel"></div></div>
        <span>Scroll Down</span>
    </div>
</section>

<!-- WHAT IS AI/ML -->
<section class="section-block" id="what-is">
    <div class="container">
        <div class="section-header text-center mb-5" data-aos="fade-up">
            <span class="section-tag">The Basics</span>
            <h2 class="section-title">What's the Difference Between AI, ML, and Deep Learning?</h2>
            <p class="section-subtitle">
                Many people confuse them — but they're actually like nested circles. AI is the big idea, ML is a way to achieve it, and Deep Learning is the most powerful one in the middle.
            </p>
        </div>

        <div class="analogy-card mb-5" data-aos="fade-up">
            <div class="analogy-icon"><i class="bi bi-lightbulb-fill"></i></div>
            <div class="analogy-content">
                <h4>Think of it Like This</h4>
                <p>
                    <strong>AI</strong> is the dream of machines thinking like humans.
                    <strong>ML</strong> is when you give it data instead of writing rules, and it learns the rules on its own.
                    <strong>Deep Learning</strong> is ML but with massive neural networks — that's what's behind ChatGPT and everything you hear about.
                </p>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-12 col-md-4" data-aos="fade-up" data-aos-delay="0">
                <div class="pillar-card" data-pillar="ml">
                    <div class="pillar-icon"><i class="bi bi-gear-wide-connected"></i></div>
                    <div class="pillar-number">01</div>
                    <h3 class="pillar-title">Machine Learning</h3>
                    <p class="pillar-desc">Instead of writing rules manually, you give it examples and it learns from them. Regression, Classification, Clustering — all classic ML that works without neural networks.</p>
                    <div class="pillar-tag">Learn from Data</div>
                </div>
            </div>
            <div class="col-12 col-md-4" data-aos="fade-up" data-aos-delay="100">
                <div class="pillar-card" data-pillar="dl">
                    <div class="pillar-icon"><i class="bi bi-diagram-3-fill"></i></div>
                    <div class="pillar-number">02</div>
                    <h3 class="pillar-title">Deep Learning</h3>
                    <p class="pillar-desc">Artificial neural networks that mimic the human brain. They learn features on their own from raw data. Behind every recognized image and understood text.</p>
                    <div class="pillar-tag">Neural Networks</div>
                </div>
            </div>
            <div class="col-12 col-md-4" data-aos="fade-up" data-aos-delay="200">
                <div class="pillar-card" data-pillar="genai">
                    <div class="pillar-icon"><i class="bi bi-stars"></i></div>
                    <div class="pillar-number">03</div>
                    <h3 class="pillar-title">Generative AI</h3>
                    <p class="pillar-desc">The new generation — not just understanding, but creating. Text, images, code, music. LLMs like GPT and Claude, and Diffusion Models like Stable Diffusion are all here.</p>
                    <div class="pillar-tag">Create, Don't Just Predict</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ML WORKFLOW INTRO -->
<section class="section-block section-dark" id="frameworks-intro">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-12 col-lg-6" data-aos="fade-right">
                <span class="section-tag light">Core Concept</span>
                <h2 class="section-title light">The ML Pipeline</h2>
                <p class="section-subtitle light">
                    Every ML project goes through the same stages. You don't skip steps — each step builds on the previous one. Understanding the Pipeline is more important than memorizing any framework.
                </p>
                <p class="section-subtitle light">
                    From <strong>collecting data</strong> to <strong>cleaning it</strong> to <strong>building the model</strong> to <strong>evaluating it</strong> to <strong>deploying it in Production</strong>.
                </p>
                <div class="benefits-list mt-4">
                    <div class="benefit-item"><i class="bi bi-check-lg"></i> Data Collection &amp; Cleaning — 80% of the time</div>
                    <div class="benefit-item"><i class="bi bi-check-lg"></i> Feature Engineering — the real art</div>
                    <div class="benefit-item"><i class="bi bi-check-lg"></i> Model Training &amp; Tuning</div>
                    <div class="benefit-item"><i class="bi bi-check-lg"></i> Evaluation — not just Accuracy</div>
                    <div class="benefit-item"><i class="bi bi-check-lg"></i> Deployment — MLOps &amp; Production</div>
                </div>
            </div>
            <div class="col-12 col-lg-6" data-aos="fade-left">
                <div class="framework-visual">
                    <div class="fv-center">
                        <i class="bi bi-robot"></i>
                        <span>AI / ML</span>
                    </div>
                    <div class="fv-orbit">
                        <div class="fv-satellite" style="--i:0"><span class="fw-torch"><i class="bi bi-fire"></i></span></div>
                        <div class="fv-satellite" style="--i:1"><span class="fw-tf"><i class="bi bi-lightning-fill"></i></span></div>
                        <div class="fv-satellite" style="--i:2"><span class="fw-sklearn"><i class="bi bi-gear-fill"></i></span></div>
                        <div class="fv-satellite" style="--i:3"><span class="fw-hf"><i class="bi bi-emoji-smile-fill"></i></span></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- FRAMEWORKS DEEP DIVE -->
<section class="section-block" id="frameworks">
    <div class="container">
        <div class="section-header text-center mb-5" data-aos="fade-up">
            <span class="section-tag">Tools & Libraries</span>
            <h2 class="section-title">Most Popular AI/ML Tools in Detail</h2>
            <p class="section-subtitle">Learn about each tool — its function, strengths, and when to use it.</p>
        </div>

        <div class="fw-tabs-wrapper" data-aos="fade-up">
            <div class="fw-tabs d-flex gap-2 flex-wrap mb-4" id="fwTabs">
                <button class="fw-tab active" data-fw="pytorch">
                    <i class="bi bi-fire"></i> PyTorch
                </button>
                <button class="fw-tab" data-fw="tensorflow">
                    <i class="bi bi-lightning-fill"></i> TensorFlow
                </button>
                <button class="fw-tab" data-fw="sklearn">
                    <i class="bi bi-gear-fill"></i> Scikit-learn
                </button>
                <button class="fw-tab" data-fw="huggingface">
                    <i class="bi bi-emoji-smile-fill"></i> Hugging Face
                </button>
                <button class="fw-tab" data-fw="langchain">
                    <i class="bi bi-link-45deg"></i> LangChain
                </button>
            </div>
            <div class="fw-panel" id="fwPanel"></div>
        </div>
    </div>
</section>

<!-- COMPARISON TABLE -->
<section class="section-block section-light-alt" id="comparison">
    <div class="container">
        <div class="section-header text-center mb-5" data-aos="fade-up">
            <span class="section-tag">Comparison</span>
            <h2 class="section-title">Comprehensive Tool Comparison</h2>
            <p class="section-subtitle">A clear table to help you see the differences at a glance.</p>
        </div>
        <div class="table-wrapper" data-aos="fade-up">
            <div class="table-responsive">
                <table class="comparison-table w-100">
                    <thead>
                        <tr>
                            <th>Metric</th>
                            <th><i class="bi bi-fire"></i> PyTorch</th>
                            <th><i class="bi bi-lightning-fill"></i> TensorFlow</th>
                            <th><i class="bi bi-gear-fill"></i> Scikit-learn</th>
                            <th><i class="bi bi-emoji-smile-fill"></i> Hugging Face</th>
                            <th><i class="bi bi-link-45deg"></i> LangChain</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="criterion">Learning Curve</td>
                            <td><span class="level medium">Medium</span></td>
                            <td><span class="level medium">Medium</span></td>
                            <td><span class="level easy">Easy</span></td>
                            <td><span class="level easy">Easy</span></td>
                            <td><span class="level medium">Medium</span></td>
                        </tr>
                        <tr>
                            <td class="criterion">Research Popularity</td>
                            <td><div class="perf-bar" data-perf="95"></div></td>
                            <td><div class="perf-bar" data-perf="60"></div></td>
                            <td><div class="perf-bar" data-perf="70"></div></td>
                            <td><div class="perf-bar" data-perf="88"></div></td>
                            <td><div class="perf-bar" data-perf="55"></div></td>
                        </tr>
                        <tr>
                            <td class="criterion">Job Opportunities</td>
                            <td><span class="level easy">Excellent</span></td>
                            <td><span class="level easy">Excellent</span></td>
                            <td><span class="level easy">Essential</span></td>
                            <td><span class="level easy">Excellent</span></td>
                            <td><span class="level medium">Growing</span></td>
                        </tr>
                        <tr>
                            <td class="criterion">Community</td>
                            <td><span class="stars">★★★★★</span></td>
                            <td><span class="stars">★★★★☆</span></td>
                            <td><span class="stars">★★★★★</span></td>
                            <td><span class="stars">★★★★★</span></td>
                            <td><span class="stars">★★★☆☆</span></td>
                        </tr>
                        <tr>
                            <td class="criterion">Primary Use</td>
                            <td>Deep Learning & Research</td>
                            <td>Production & Mobile</td>
                            <td>Classical ML</td>
                            <td>LLMs & Transformers</td>
                            <td>LLM Applications</td>
                        </tr>
                        <tr>
                            <td class="criterion">Start With It When?</td>
                            <td>After Scikit-learn</td>
                            <td>Alternative to PyTorch for Prod</td>
                            <td>Day One</td>
                            <td>With your first LLM project</td>
                            <td>After Hugging Face</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

<!-- QUIZ -->
<section class="section-block section-dark" id="quiz">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-8">
                <div class="section-header text-center mb-5" data-aos="fade-up">
                    <span class="section-tag light">Discover Yourself</span>
                    <h2 class="section-title light">Which AI Field Fits You?</h2>
                    <p class="section-subtitle light">Answer 3 questions and we'll suggest the best fit.</p>
                </div>
                <div class="quiz-card" id="quizCard" data-aos="fade-up">
                    <div class="quiz-progress-bar"><div class="quiz-progress-fill" id="quizProgressFill"></div></div>
                    <div class="quiz-step-indicator" id="quizStepIndicator">Question 1 of 3</div>
                    <div class="quiz-content" id="quizContent"></div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ROADMAP -->
<section class="section-block" id="roadmap">
    <div class="container">
        <div class="section-header text-center mb-5" data-aos="fade-up">
            <span class="section-tag">Roadmap</span>
            <h2 class="section-title">Where Do You Start?</h2>
            <p class="section-subtitle">The right steps, in the right order.</p>
        </div>
        <div class="roadmap-timeline" id="roadmapTimeline"></div>
    </div>
</section>

@section Scripts {
    <script src="~/tracks/AI/app.js" asp-append-version="true"></script>
}