@{
    ViewData["Title"] = "Backend Track";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/tracks/Style/style.css" asp-append-version="true" />
}

<!-- HERO -->
<section class="hero-section" id="hero">
    <div class="hero-grid-bg"></div>
    <div class="container">
        <div class="row min-vh-100 align-items-center">
            <div class="col-12 col-lg-8">
                <div class="hero-tag mb-3" data-aos="fade-up">
                    <i class="fa-solid fa-server"></i>
                    <span data-i18n="hero.tag">Beginner's Guide to Backend</span>
                </div>
                <h1 class="hero-title" data-aos="fade-up" data-aos-delay="100">
                    <span data-i18n="hero.title1">Everything You Need</span><br />
                    <span data-i18n="hero.title2">to Know About</span>
                    <span class="highlight-text"> Backend</span>
                </h1>
                <p class="hero-subtitle" data-aos="fade-up" data-aos-delay="200" data-i18n="hero.sub">
                    From understanding the Server and Database to choosing the right language and Framework — a clear, simple guide without complexity.
                </p>
                <div class="hero-actions d-flex flex-wrap gap-3 mt-5" data-aos="fade-up" data-aos-delay="300">
                    <a href="#what-is" class="btn-primary-custom">
                        <span data-i18n="hero.cta1">Start the Journey</span>
                        <i class="fa-solid fa-arrow-left ms-2"></i>
                    </a>
                    <a href="#comparison" class="btn-secondary-custom" data-i18n="hero.cta2">Compare Technologies</a>
                </div>
            </div>
            <div class="col-12 col-lg-4 d-none d-lg-block">
                <div class="hero-code-block" data-aos="fade-left" data-aos-delay="400">
                    <div class="code-header">
                        <span class="dot red"></span><span class="dot yellow"></span><span class="dot green"></span>
                        <span class="code-filename">server.js</span>
                    </div>
                    <div class="code-body" id="heroCodeBlock">
                        <div class="code-line"><span class="kw">const</span> <span class="var">express</span> = <span class="fn">require</span>(<span class="str">'express'</span>);</div>
                        <div class="code-line"><span class="kw">const</span> <span class="var">app</span> = <span class="fn">express</span>();</div>
                        <div class="code-line mt-2"><span class="var">app</span>.<span class="method">get</span>(<span class="str" data-i18n="code.route">'/api/hello'</span>, (<span class="var">req</span>, <span class="var">res</span>) => {</div>
                        <div class="code-line pl-2"><span class="var">res</span>.<span class="method">json</span>({ <span class="prop">msg</span>: <span class="str" data-i18n="code.msg">"Hello Backend! 🚀"</span> });</div>
                        <div class="code-line">});</div>
                        <div class="code-line mt-2"><span class="var">app</span>.<span class="method">listen</span>(<span class="bool">3000</span>);</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="hero-scroll-hint">
        <div class="scroll-mouse"><div class="scroll-wheel"></div></div>
        <span data-i18n="hero.scroll">Scroll Down</span>
    </div>
</section>

<!-- WHAT IS BACKEND -->
<section class="section-block" id="what-is">
    <div class="container">
        <div class="section-header text-center mb-5" data-aos="fade-up">
            <span class="section-tag" data-i18n="what.tag">The Basics</span>
            <h2 class="section-title" data-i18n="what.title">What is Backend?</h2>
            <p class="section-subtitle" data-i18n="what.sub">Backend is the part the user doesn't see — but it's what makes everything work. Data, security, logic, the Database. Simply put: it's the kitchen that cooks everything.</p>
        </div>

        <!-- Analogy -->
        <div class="analogy-card mb-5" data-aos="fade-up">
            <div class="analogy-icon"><i class="fa-solid fa-kitchen-set"></i></div>
            <div class="analogy-content">
                <h4 data-i18n="what.analogy.title">Think of it Like This</h4>
                <p data-i18n="what.analogy.body">A restaurant has a <strong>dining area (Frontend)</strong> that customers see. But behind it is a <strong>kitchen (Backend)</strong> — where food is prepared, recipes are stored in the Database, and customer identity is verified. Without the kitchen, there's no food. You're the Chef!</p>
            </div>
        </div>

        <!-- 3 Pillars -->
        <div class="row g-4">
            <div class="col-12 col-md-4" data-aos="fade-up" data-aos-delay="0">
                <div class="pillar-card" data-pillar="server">
                    <div class="pillar-icon"><i class="fa-solid fa-server"></i></div>
                    <div class="pillar-number">01</div>
                    <h3 class="pillar-title">Server</h3>
                    <p class="pillar-desc" data-i18n="what.server">The computer running 24/7, receiving requests from users and responding to them. It runs your code.</p>
                    <div class="pillar-tag">Compute</div>
                </div>
            </div>
            <div class="col-12 col-md-4" data-aos="fade-up" data-aos-delay="100">
                <div class="pillar-card" data-pillar="api">
                    <div class="pillar-icon"><i class="fa-solid fa-plug"></i></div>
                    <div class="pillar-number">02</div>
                    <h3 class="pillar-title">API</h3>
                    <p class="pillar-desc" data-i18n="what.api">The bridge between Frontend and Backend. It defines how they exchange data in an organized, agreed-upon way.</p>
                    <div class="pillar-tag">Interface</div>
                </div>
            </div>
            <div class="col-12 col-md-4" data-aos="fade-up" data-aos-delay="200">
                <div class="pillar-card" data-pillar="db">
                    <div class="pillar-icon"><i class="fa-solid fa-database"></i></div>
                    <div class="pillar-number">03</div>
                    <h3 class="pillar-title">Database</h3>
                    <p class="pillar-desc" data-i18n="what.db">The place to store data in an organized way — users, products, orders. Without a Database, there's no memory.</p>
                    <div class="pillar-tag">Storage</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- FRAMEWORK INTRO (dark section) -->
<section class="section-block" id="frameworks-intro">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-12 col-lg-6" data-aos="fade-right">
                <span class="section-tag light" data-i18n="fwintro.tag">The Concept</span>
                <h2 class="section-title light" data-i18n="fwintro.title">Why Learn Backend?</h2>
                <p class="section-subtitle light" data-i18n="fwintro.sub1">Frontend deals with the user, but <strong>Backend deals with real data</strong> — registration, payments, security, and complex Logic.</p>
                <p class="section-subtitle light" data-i18n="fwintro.sub2">With a <strong>strong Backend</strong>, you can build anything — from a small API to a massive Platform like Netflix or Uber.</p>
                <div class="benefits-list mt-4">
                    <div class="benefit-item"><i class="fa-solid fa-check"></i> <span data-i18n="fwintro.b1">Full Control Over Data and Logic</span></div>
                    <div class="benefit-item"><i class="fa-solid fa-check"></i> <span data-i18n="fwintro.b2">Higher Salary Than Frontend in Most Markets</span></div>
                    <div class="benefit-item"><i class="fa-solid fa-check"></i> <span data-i18n="fwintro.b3">Consistent Demand in Every Company Without Exception</span></div>
                    <div class="benefit-item"><i class="fa-solid fa-check"></i> <span data-i18n="fwintro.b4">Opens the Door to Full-Stack and DevOps</span></div>
                </div>
            </div>
            <div class="col-12 col-lg-6" data-aos="fade-left">
                <div class="framework-visual">
                    <div class="fv-center">
                        <i class="fa-solid fa-server"></i>
                        <span>Backend</span>
                    </div>
                    <div class="fv-orbit">
                        <div class="fv-satellite" style="--i:0"><span style="color:#68a063"><i class="fa-brands fa-node-js"></i></span></div>
                        <div class="fv-satellite" style="--i:1"><span style="color:#3776ab"><i class="fa-brands fa-python"></i></span></div>
                        <div class="fv-satellite" style="--i:2"><span style="color:#b07219"><i class="fa-brands fa-java"></i></span></div>
                        <div class="fv-satellite" style="--i:3"><span style="color:#512bd4"><i class="fa-solid fa-hashtag"></i></span></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- FRAMEWORKS / LANGUAGES -->
<section class="section-block" id="frameworks">
    <div class="container">
        <div class="section-header text-center mb-5" data-aos="fade-up">
            <span class="section-tag" data-i18n="fw.tag">Technologies</span>
            <h2 class="section-title" data-i18n="fw.title">Most Popular Backend Languages & Frameworks</h2>
            <p class="section-subtitle" data-i18n="fw.sub">Learn about each technology — who uses it, its strengths, and when to choose it.</p>
        </div>
        <div class="fw-tabs-wrapper" data-aos="fade-up">
            <div class="fw-tabs d-flex gap-2 flex-wrap mb-4" id="fwTabs">
                <button class="fw-tab active" data-fw="nodejs"><i class="fa-brands fa-node-js"></i> Node.js</button>
                <button class="fw-tab" data-fw="python"><i class="fa-brands fa-python"></i> Python</button>
                <button class="fw-tab" data-fw="java"><i class="fa-brands fa-java"></i> Java</button>
                <button class="fw-tab" data-fw="dotnet"><i class="fa-solid fa-hashtag"></i> .NET</button>
                <button class="fw-tab" data-fw="go"><i class="fa-solid fa-g"></i> Go</button>
            </div>
            <div class="fw-panel" id="fwPanel"></div>
        </div>
    </div>
</section>

<!-- COMPARISON TABLE -->
<section class="section-block section-light-alt" id="comparison">
    <div class="container">
        <div class="section-header text-center mb-5" data-aos="fade-up">
            <span class="section-tag" data-i18n="cmp.tag">Comparison</span>
            <h2 class="section-title" data-i18n="cmp.title">Comprehensive Technology Comparison</h2>
            <p class="section-subtitle" data-i18n="cmp.sub">A clear table to help you see the differences at a glance.</p>
        </div>
        <div class="table-wrapper" data-aos="fade-up">
            <div class="table-responsive">
                <table class="comparison-table w-100">
                    <thead>
                        <tr>
                            <th data-i18n="cmp.criterion">Metric</th>
                            <th><i class="fa-brands fa-node-js"></i> Node.js</th>
                            <th><i class="fa-brands fa-python"></i> Python</th>
                            <th><i class="fa-brands fa-java"></i> Java</th>
                            <th><i class="fa-solid fa-hashtag"></i> .NET</th>
                            <th><i class="fa-solid fa-g"></i> Go</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="criterion" data-i18n="cmp.diff">Learning Curve</td>
                            <td><span class="level easy" data-i18n="l.easy">Easy</span></td>
                            <td><span class="level easy" data-i18n="l.easy">Easy</span></td>
                            <td><span class="level hard" data-i18n="l.hard">Hard</span></td>
                            <td><span class="level medium" data-i18n="l.med">Medium</span></td>
                            <td><span class="level medium" data-i18n="l.med">Medium</span></td>
                        </tr>
                        <tr>
                            <td class="criterion" data-i18n="cmp.perf">Performance</td>
                            <td><div class="perf-bar" data-perf="85"></div></td>
                            <td><div class="perf-bar" data-perf="75"></div></td>
                            <td><div class="perf-bar" data-perf="92"></div></td>
                            <td><div class="perf-bar" data-perf="90"></div></td>
                            <td><div class="perf-bar" data-perf="98"></div></td>
                        </tr>
                        <tr>
                            <td class="criterion" data-i18n="cmp.community">Community</td>
                            <td><span class="stars">★★★★★</span></td>
                            <td><span class="stars">★★★★★</span></td>
                            <td><span class="stars">★★★★☆</span></td>
                            <td><span class="stars">★★★★☆</span></td>
                            <td><span class="stars">★★★☆☆</span></td>
                        </tr>
                        <tr>
                            <td class="criterion" data-i18n="cmp.jobs">Job Opportunities</td>
                            <td><span class="level easy" data-i18n="l.great">Excellent</span></td>
                            <td><span class="level easy" data-i18n="l.great">Excellent</span></td>
                            <td><span class="level medium" data-i18n="l.good">Good</span></td>
                            <td><span class="level medium" data-i18n="l.good">Good</span></td>
                            <td><span class="level medium" data-i18n="l.good">Good</span></td>
                        </tr>
                        <tr>
                            <td class="criterion" data-i18n="cmp.companies">Companies</td>
                            <td>Netflix, LinkedIn</td>
                            <td>Instagram, Spotify</td>
                            <td>Amazon, LinkedIn</td>
                            <td>Microsoft, Stack Overflow</td>
                            <td>Google, Uber</td>
                        </tr>
                        <tr>
                            <td class="criterion" data-i18n="cmp.for">Best For</td>
                            <td data-i18n="cmp.node">APIs, Real-time</td>
                            <td data-i18n="cmp.python">AI, Data, Web</td>
                            <td data-i18n="cmp.java">Enterprise, Android</td>
                            <td data-i18n="cmp.dotnet">Windows, Enterprise</td>
                            <td data-i18n="cmp.go">Microservices, Cloud</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

<!-- QUIZ -->
<section class="section-block" id="quiz">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-8">
                <div class="section-header text-center mb-5" data-aos="fade-up">
                    <span class="section-tag light" data-i18n="quiz.tag">Discover Yourself</span>
                    <h2 class="section-title light" data-i18n="quiz.title">Which Backend Language Fits You?</h2>
                    <p class="section-subtitle light" data-i18n="quiz.sub">Answer 3 questions and we'll suggest the best fit.</p>
                </div>
                <div class="quiz-card" id="quizCard" data-aos="fade-up">
                    <div class="quiz-progress-bar"><div class="quiz-progress-fill" id="quizProgressFill"></div></div>
                    <div class="quiz-step-indicator" id="quizStepIndicator"></div>
                    <div class="quiz-content" id="quizContent"></div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ROADMAP -->
<section class="section-block" id="roadmap">
    <div class="container">
        <div class="section-header text-center mb-5" data-aos="fade-up">
            <span class="section-tag" data-i18n="road.tag">Roadmap</span>
            <h2 class="section-title" data-i18n="road.title">Where Do You Start Backend?</h2>
            <p class="section-subtitle" data-i18n="road.sub">The right steps, in the right order — from zero to pro.</p>
        </div>
        <div class="roadmap-timeline" id="roadmapTimeline"></div>
    </div>
</section>

@section Scripts {
    <script src="~/tracks/Backend/app.js" asp-append-version="true"></script>
}