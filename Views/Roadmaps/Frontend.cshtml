@{
    ViewData["Title"] = "Frontend Track";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/tracks/Style/style.css" asp-append-version="true" />
}

<section class="hero-section" id="hero">
    <div class="hero-grid-bg"></div>
    <div class="container">
        <div class="row min-vh-100 align-items-center">
            <div class="col-12 col-lg-8">
                <div class="hero-tag mb-3" data-aos="fade-up">
                    <i class="fa-solid fa-code"></i>
                    <span data-i18n="hero.tag">Beginner's Guide to Frontend</span>
                </div>
                <h1 class="hero-title" data-aos="fade-up" data-aos-delay="100">
                    <span data-i18n="hero.title1">Everything You Need</span><br />
                    <span data-i18n="hero.title2">to Know About</span>
                    <span class="highlight-text"> Frontend</span>
                </h1>
                <p class="hero-subtitle" data-aos="fade-up" data-aos-delay="200" data-i18n="hero.sub">
                    From your first line of code to choosing the right Framework — a clear, simple guide without complexity.
                </p>
                <div class="hero-actions d-flex flex-wrap gap-3 mt-5" data-aos="fade-up" data-aos-delay="300">
                    <a href="#what-is" class="btn-primary-custom">
                        <span data-i18n="hero.cta1">Start the Journey</span> <i class="fa-solid fa-arrow-left ms-2"></i>
                    </a>
                    <a href="#comparison" class="btn-secondary-custom" data-i18n="hero.cta2">Compare Frameworks</a>
                </div>
            </div>
            <div class="col-12 col-lg-4 d-none d-lg-block">
                <div class="hero-code-block" data-aos="fade-left" data-aos-delay="400">
                    <div class="code-header">
                        <span class="dot red"></span><span class="dot yellow"></span><span class="dot green"></span>
                        <span class="code-filename">hello-world.js</span>
                    </div>
                    <div class="code-body" id="heroCodeBlock">
                        <div class="code-line"><span class="kw">const</span> <span class="var">developer</span> = {</div>
                        <div class="code-line pl-2"><span class="prop">name</span>: <span class="str" data-i18n="code.name">"You"</span>,</div>
                        <div class="code-line pl-2"><span class="prop">goal</span>: <span class="str" data-i18n="code.goal">"Build Amazing Websites"</span>,</div>
                        <div class="code-line pl-2"><span class="prop">level</span>: <span class="str">"beginner"</span>,</div>
                        <div class="code-line pl-2"><span class="prop">ready</span>: <span class="bool">true</span></div>
                        <div class="code-line">};</div>
                        <div class="code-line mt-2"><span class="fn">console</span>.<span class="method">log</span>(<span class="str" data-i18n="code.log">"Let's start! 🚀"</span>);</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="hero-scroll-hint">
        <div class="scroll-mouse"><div class="scroll-wheel"></div></div>
        <span data-i18n="hero.scroll">Scroll Down</span>
    </div>
</section>

<section class="section-block" id="what-is">
    <div class="container">
        <div class="section-header text-center mb-5" data-aos="fade-up">
            <span class="section-tag" data-i18n="what.tag">The Basics</span>
            <h2 class="section-title" data-i18n="what.title">What is Frontend?</h2>
            <p class="section-subtitle" data-i18n="what.sub">Frontend is everything the user sees and interacts with on a website or application — buttons, colors, animations, text. Simply put: it's the beautiful face of the Web.</p>
        </div>
        <div class="analogy-card mb-5" data-aos="fade-up">
            <div class="analogy-icon"><i class="fa-solid fa-utensils"></i></div>
            <div class="analogy-content">
                <h4 data-i18n="what.analogy.title">Think of it Like This</h4>
                <p data-i18n="what.analogy.body">A restaurant has a <strong>kitchen (Backend)</strong> where food is prepared — the customer doesn't see it. And it has a <strong>dining area (Frontend)</strong> — the design, menu, tables, and presentation. That's what directly impacts the customer's experience. You're working in the dining area!</p>
            </div>
        </div>
        <div class="row g-4">
            <div class="col-12 col-md-4" data-aos="fade-up" data-aos-delay="0">
                <div class="pillar-card" data-pillar="html">
                    <div class="pillar-icon"><i class="fa-brands fa-html5"></i></div>
                    <div class="pillar-number">01</div>
                    <h3 class="pillar-title">HTML</h3>
                    <p class="pillar-desc" data-i18n="what.html">The skeleton of the page. Defines structure and content — text, images, buttons. Without it, there's no page.</p>
                    <div class="pillar-tag">Structure</div>
                </div>
            </div>
            <div class="col-12 col-md-4" data-aos="fade-up" data-aos-delay="100">
                <div class="pillar-card" data-pillar="css">
                    <div class="pillar-icon"><i class="fa-brands fa-css3-alt"></i></div>
                    <div class="pillar-number">02</div>
                    <h3 class="pillar-title">CSS</h3>
                    <p class="pillar-desc" data-i18n="what.css">Responsible for form and beauty. Colors, sizing, spacing, animations — CSS transforms the structure into a masterpiece.</p>
                    <div class="pillar-tag">Style</div>
                </div>
            </div>
            <div class="col-12 col-md-4" data-aos="fade-up" data-aos-delay="200">
                <div class="pillar-card" data-pillar="js">
                    <div class="pillar-icon"><i class="fa-brands fa-js"></i></div>
                    <div class="pillar-number">03</div>
                    <h3 class="pillar-title">JavaScript</h3>
                    <p class="pillar-desc" data-i18n="what.js">The soul that makes everything move. User interaction, data fetching, complex animations — all JS.</p>
                    <div class="pillar-tag">Behavior</div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section-block" id="frameworks-intro">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-12 col-lg-6" data-aos="fade-right">
                <span class="section-tag light" data-i18n="fwintro.tag">The Concept</span>
                <h2 class="section-title light" data-i18n="fwintro.title">What is a Framework?</h2>
                <p class="section-subtitle light" data-i18n="fwintro.sub1">Imagine you're building a house. You can build everything from scratch — or you can take <strong>ready-made, organized materials</strong> and build faster and better.</p>
                <p class="section-subtitle light" data-i18n="fwintro.sub2">A <strong>Framework</strong> is those ready-made tools and materials. It saves you time and effort, and lets you focus on building the product.</p>
                <div class="benefits-list mt-4">
                    <div class="benefit-item"><i class="fa-solid fa-check"></i> <span data-i18n="fwintro.b1">Organized and Reusable Code</span></div>
                    <div class="benefit-item"><i class="fa-solid fa-check"></i> <span data-i18n="fwintro.b2">Faster and Better Performance</span></div>
                    <div class="benefit-item"><i class="fa-solid fa-check"></i> <span data-i18n="fwintro.b3">Huge Community to Help You</span></div>
                    <div class="benefit-item"><i class="fa-solid fa-check"></i> <span data-i18n="fwintro.b4">Ready Solutions for Common Problems</span></div>
                </div>
            </div>
            <div class="col-12 col-lg-6" data-aos="fade-left">
                <div class="framework-visual">
                    <div class="fv-center"><i class="fa-brands fa-js"></i><span>JavaScript</span></div>
                    <div class="fv-orbit">
                        <div class="fv-satellite" style="--i:0"><span class="fw-react"><i class="fa-brands fa-react"></i></span></div>
                        <div class="fv-satellite" style="--i:1"><span class="fw-vue"><i class="fa-brands fa-vuejs"></i></span></div>
                        <div class="fv-satellite" style="--i:2"><span class="fw-angular"><i class="fa-brands fa-angular"></i></span></div>
                        <div class="fv-satellite" style="--i:3"><span class="fw-svelte"><i class="fa-solid fa-fire"></i></span></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section-block" id="frameworks">
    <div class="container">
        <div class="section-header text-center mb-5" data-aos="fade-up">
            <span class="section-tag" data-i18n="fw.tag">Frameworks</span>
            <h2 class="section-title" data-i18n="fw.title">Most Popular Frameworks in Detail</h2>
            <p class="section-subtitle" data-i18n="fw.sub">Learn about each Framework — who made it, its strengths, and when to use it.</p>
        </div>
        <div class="fw-tabs-wrapper" data-aos="fade-up">
            <div class="fw-tabs d-flex gap-2 flex-wrap mb-4" id="fwTabs">
                <button class="fw-tab active" data-fw="react"><i class="fa-brands fa-react"></i> React</button>
                <button class="fw-tab" data-fw="vue"><i class="fa-brands fa-vuejs"></i> Vue</button>
                <button class="fw-tab" data-fw="angular"><i class="fa-brands fa-angular"></i> Angular</button>
                <button class="fw-tab" data-fw="svelte"><i class="fa-solid fa-fire-flame-curved"></i> Svelte</button>
                <button class="fw-tab" data-fw="nextjs"><i class="fa-solid fa-n"></i> Next.js</button>
            </div>
            <div class="fw-panel" id="fwPanel"></div>
        </div>
    </div>
</section>

<section class="section-block section-light-alt" id="comparison">
    <div class="container">
        <div class="section-header text-center mb-5" data-aos="fade-up">
            <span class="section-tag" data-i18n="cmp.tag">Comparison</span>
            <h2 class="section-title" data-i18n="cmp.title">Comprehensive Framework Comparison</h2>
            <p class="section-subtitle" data-i18n="cmp.sub">A clear table to help you see the differences at a glance.</p>
        </div>
        <div class="table-wrapper" data-aos="fade-up">
            <div class="table-responsive">
                <table class="comparison-table w-100">
                    <thead>
                        <tr>
                            <th data-i18n="cmp.criterion">Metric</th>
                            <th><i class="fa-brands fa-react"></i> React</th>
                            <th><i class="fa-brands fa-vuejs"></i> Vue</th>
                            <th><i class="fa-brands fa-angular"></i> Angular</th>
                            <th><i class="fa-solid fa-fire-flame-curved"></i> Svelte</th>
                            <th><i class="fa-solid fa-n"></i> Next.js</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="criterion" data-i18n="cmp.diff">Learning Curve</td>
                            <td><span class="level medium" data-i18n="l.med">Medium</span></td>
                            <td><span class="level easy" data-i18n="l.easy">Easy</span></td>
                            <td><span class="level hard" data-i18n="l.hard">Hard</span></td>
                            <td><span class="level easy" data-i18n="l.easy">Easy</span></td>
                            <td><span class="level medium" data-i18n="l.med">Medium</span></td>
                        </tr>
                        <tr>
                            <td class="criterion" data-i18n="cmp.perf">Performance</td>
                            <td><div class="perf-bar" data-perf="88"></div></td>
                            <td><div class="perf-bar" data-perf="90"></div></td>
                            <td><div class="perf-bar" data-perf="82"></div></td>
                            <td><div class="perf-bar" data-perf="98"></div></td>
                            <td><div class="perf-bar" data-perf="92"></div></td>
                        </tr>
                        <tr>
                            <td class="criterion" data-i18n="cmp.community">Community</td>
                            <td><span class="stars">★★★★★</span></td>
                            <td><span class="stars">★★★★☆</span></td>
                            <td><span class="stars">★★★★☆</span></td>
                            <td><span class="stars">★★★☆☆</span></td>
                            <td><span class="stars">★★★★★</span></td>
                        </tr>
                        <tr>
                            <td class="criterion" data-i18n="cmp.jobs">Job Opportunities</td>
                            <td><span class="level easy" data-i18n="l.great">Excellent</span></td>
                            <td><span class="level medium" data-i18n="l.good">Good</span></td>
                            <td><span class="level medium" data-i18n="l.good">Good</span></td>
                            <td><span class="level hard" data-i18n="l.limited">Limited</span></td>
                            <td><span class="level easy" data-i18n="l.great">Excellent</span></td>
                        </tr>
                        <tr>
                            <td class="criterion" data-i18n="cmp.companies">Companies Using It</td>
                            <td>Meta, Airbnb</td>
                            <td>Alibaba, GitLab</td>
                            <td>Google, IBM</td>
                            <td>NYT, Spotify</td>
                            <td>TikTok, Twitch</td>
                        </tr>
                        <tr>
                            <td class="criterion" data-i18n="cmp.for">Best For</td>
                            <td data-i18n="cmp.react">SPAs, Large Apps</td>
                            <td data-i18n="cmp.vue">Beginners, Medium Apps</td>
                            <td data-i18n="cmp.angular">Enterprise</td>
                            <td data-i18n="cmp.svelte">Fast + Lightweight</td>
                            <td data-i18n="cmp.next">Full-stack</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

<section class="section-block" id="quiz">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-8">
                <div class="section-header text-center mb-5" data-aos="fade-up">
                    <span class="section-tag light" data-i18n="quiz.tag">Discover Yourself</span>
                    <h2 class="section-title light" data-i18n="quiz.title">Which Framework Fits You?</h2>
                    <p class="section-subtitle light" data-i18n="quiz.sub">Answer 3 questions and we'll suggest the best fit.</p>
                </div>
                <div class="quiz-card" id="quizCard" data-aos="fade-up">
                    <div class="quiz-progress-bar"><div class="quiz-progress-fill" id="quizProgressFill"></div></div>
                    <div class="quiz-step-indicator" id="quizStepIndicator"></div>
                    <div class="quiz-content" id="quizContent"></div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section-block" id="roadmap">
    <div class="container">
        <div class="section-header text-center mb-5" data-aos="fade-up">
            <span class="section-tag" data-i18n="road.tag">Roadmap</span>
            <h2 class="section-title" data-i18n="road.title">Where Do You Start?</h2>
            <p class="section-subtitle" data-i18n="road.sub">The right steps, in the right order.</p>
        </div>
        <div class="roadmap-timeline" id="roadmapTimeline"></div>
    </div>
</section>

@section Scripts {
    <script src="~/tracks/Frontend/app.js" asp-append-version="true"></script>
}