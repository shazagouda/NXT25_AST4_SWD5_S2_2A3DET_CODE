@{
    ViewData["Title"] = "DevOps Track";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/tracks/Style/style.css" asp-append-version="true" />
}

<!-- HERO -->
<section class="hero-section" id="hero">
    <div class="hero-grid-bg"></div>
    <div class="container">
        <div class="row min-vh-100 align-items-center">
            <div class="col-12 col-lg-8">
                <div class="hero-tag mb-3" data-aos="fade-up">
                    <i class="fa-solid fa-infinity"></i> Beginner's Guide to DevOps
                </div>
                <h1 class="hero-title" data-aos="fade-up" data-aos-delay="100">
                    Everything You Need<br />
                    to Know About
                    <span class="highlight-text"> DevOps</span>
                </h1>
                <p class="hero-subtitle" data-aos="fade-up" data-aos-delay="200">
                    From your first Container to building a complete Pipeline — a clear, simple guide without complexity.
                </p>
                <div class="hero-actions d-flex flex-wrap gap-3 mt-5" data-aos="fade-up" data-aos-delay="300">
                    <a href="#what-is" class="btn-primary-custom">
                        Start the Journey <i class="fa-solid fa-arrow-left ms-2"></i>
                    </a>
                    <a href="#comparison" class="btn-secondary-custom">
                        Compare Tools
                    </a>
                </div>
            </div>
            <div class="col-12 col-lg-4 d-none d-lg-block">
                <div class="hero-code-block" data-aos="fade-left" data-aos-delay="400">
                    <div class="code-header">
                        <span class="dot red"></span>
                        <span class="dot yellow"></span>
                        <span class="dot green"></span>
                        <span class="code-filename">pipeline.yml</span>
                    </div>
                    <div class="code-body" id="heroCodeBlock">
                        <div class="code-line"><span class="prop">name</span>: <span class="str">Deploy to Production</span></div>
                        <div class="code-line"><span class="prop">on</span>: [<span class="str">push</span>]</div>
                        <div class="code-line mt-1"><span class="prop">jobs</span>:</div>
                        <div class="code-line pl-2"><span class="prop">build</span>:</div>
                        <div class="code-line pl-3"><span class="prop">runs-on</span>: <span class="str">ubuntu-latest</span></div>
                        <div class="code-line pl-3"><span class="prop">steps</span>:</div>
                        <div class="code-line pl-4"><span class="kw">- run</span>: <span class="fn">docker build</span> <span class="str">.</span></div>
                        <div class="code-line pl-4"><span class="kw">- run</span>: <span class="fn">docker push</span></div>
                        <div class="code-line pl-4"><span class="kw">- run</span>: <span class="fn">kubectl apply</span></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="hero-scroll-hint">
        <div class="scroll-mouse"><div class="scroll-wheel"></div></div>
        <span>Scroll Down</span>
    </div>
</section>

<!-- WHAT IS DEVOPS -->
<section class="section-block" id="what-is">
    <div class="container">
        <div class="section-header text-center mb-5" data-aos="fade-up">
            <span class="section-tag">The Basics</span>
            <h2 class="section-title">What is DevOps?</h2>
            <p class="section-subtitle">
                DevOps isn't a tool or a language — it's a culture that brings together Development and Operations. Its goal is to deliver code to users quickly, securely, and continuously without losing sleep.
            </p>
        </div>

        <div class="analogy-card mb-5" data-aos="fade-up">
            <div class="analogy-icon"><i class="fa-solid fa-conveyor-belt"></i></div>
            <div class="analogy-content">
                <h4>Think of it Like This</h4>
                <p>
                    Imagine a car factory. Engineers design, workers produce — but if there's no <strong>organized production line (Pipeline)</strong>, everything stays chaotic and slow.
                    DevOps is what builds <strong>the automated production line</strong> — from code to user with one click. 🚀
                </p>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-12 col-md-4" data-aos="fade-up" data-aos-delay="0">
                <div class="pillar-card" data-pillar="ci">
                    <div class="pillar-icon"><i class="fa-solid fa-rotate"></i></div>
                    <div class="pillar-number">01</div>
                    <h3 class="pillar-title">CI/CD</h3>
                    <p class="pillar-desc">Continuous Integration and Delivery — every Push runs Tests automatically, and every Merge does a Deploy. No manual intervention. This is the heart of DevOps.</p>
                    <div class="pillar-tag">Automate Everything</div>
                </div>
            </div>
            <div class="col-12 col-md-4" data-aos="fade-up" data-aos-delay="100">
                <div class="pillar-card" data-pillar="containers">
                    <div class="pillar-icon"><i class="fa-brands fa-docker"></i></div>
                    <div class="pillar-number">02</div>
                    <h3 class="pillar-title">Containers</h3>
                    <p class="pillar-desc">Docker packages the application and all its dependencies into a sealed box — it runs the same on any device or server. "It works on my machine" becomes a thing of the past.</p>
                    <div class="pillar-tag">Ship Anywhere</div>
                </div>
            </div>
            <div class="col-12 col-md-4" data-aos="fade-up" data-aos-delay="200">
                <div class="pillar-card" data-pillar="infra">
                    <div class="pillar-icon"><i class="fa-solid fa-cloud"></i></div>
                    <div class="pillar-number">03</div>
                    <h3 class="pillar-title">Infrastructure as Code</h3>
                    <p class="pillar-desc">Instead of setting up servers by hand from the Console, you write code that does it automatically. Terraform and Ansible make the infrastructure repeatable.</p>
                    <div class="pillar-tag">Code Your Cloud</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- DEVOPS LOOP INTRO -->
<section class="section-block section-dark" id="frameworks-intro">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-12 col-lg-6" data-aos="fade-right">
                <span class="section-tag light">Core Concept</span>
                <h2 class="section-title light">The Infinite DevOps Loop</h2>
                <p class="section-subtitle light">
                    DevOps isn't a straight line — it's a continuous loop. Plan, Code, Build, Test, Release, Deploy, Operate, Monitor — and you loop back to the start.
                </p>
                <p class="section-subtitle light">
                    Each cycle makes you faster and safer. The goal isn't just speed — the goal is <strong>reliability with speed together.</strong>
                </p>
                <div class="benefits-list mt-4">
                    <div class="benefit-item"><i class="fa-solid fa-check"></i> Faster Delivery — Deploy every day, not every month</div>
                    <div class="benefit-item"><i class="fa-solid fa-check"></i> Less Risk — Small, frequent changes are safer</div>
                    <div class="benefit-item"><i class="fa-solid fa-check"></i> Better Quality — Automated Tests in every Deploy</div>
                    <div class="benefit-item"><i class="fa-solid fa-check"></i> Full Visibility — Monitoring in everything</div>
                </div>
            </div>
            <div class="col-12 col-lg-6" data-aos="fade-left">
                <div class="framework-visual">
                    <div class="fv-center">
                        <i class="fa-solid fa-infinity"></i>
                        <span>DevOps</span>
                    </div>
                    <div class="fv-orbit">
                        <div class="fv-satellite" style="--i:0"><span class="fw-docker"><i class="fa-brands fa-docker"></i></span></div>
                        <div class="fv-satellite" style="--i:1"><span class="fw-k8s"><i class="fa-solid fa-dharmachakra"></i></span></div>
                        <div class="fv-satellite" style="--i:2"><span class="fw-terraform"><i class="fa-solid fa-cube"></i></span></div>
                        <div class="fv-satellite" style="--i:3"><span class="fw-github"><i class="fa-brands fa-github"></i></span></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- TOOLS DEEP DIVE -->
<section class="section-block" id="frameworks">
    <div class="container">
        <div class="section-header text-center mb-5" data-aos="fade-up">
            <span class="section-tag">Core Tools</span>
            <h2 class="section-title">Most Popular DevOps Tools in Detail</h2>
            <p class="section-subtitle">Learn about each tool — its function, who's behind it, and when to use it.</p>
        </div>

        <div class="fw-tabs-wrapper" data-aos="fade-up">
            <div class="fw-tabs d-flex gap-2 flex-wrap mb-4" id="fwTabs">
                <button class="fw-tab active" data-fw="docker">
                    <i class="fa-brands fa-docker"></i> Docker
                </button>
                <button class="fw-tab" data-fw="k8s">
                    <i class="fa-solid fa-dharmachakra"></i> Kubernetes
                </button>
                <button class="fw-tab" data-fw="cicd">
                    <i class="fa-brands fa-github"></i> CI/CD
                </button>
                <button class="fw-tab" data-fw="terraform">
                    <i class="fa-solid fa-cube"></i> Terraform
                </button>
                <button class="fw-tab" data-fw="monitoring">
                    <i class="fa-solid fa-chart-line"></i> Monitoring
                </button>
            </div>
            <div class="fw-panel" id="fwPanel"></div>
        </div>
    </div>
</section>

<!-- COMPARISON TABLE -->
