                            <td>Monitoring & Alerting</td>
                        </tr>
                        <tr>
                            <td class="criterion">Start With It When?</td>
                            <td>Day One</td>
                            <td>After Docker</td>
                            <td>Day One</td>
                            <td>After Cloud basics</td>
                            <td>With your first real Deploy</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

<!-- QUIZ -->
<section class="section-block section-dark" id="quiz">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-8">
                <div class="section-header text-center mb-5" data-aos="fade-up">
                    <span class="section-tag light">Discover Yourself</span>
                    <h2 class="section-title light">Which DevOps Tool Should You Start With?</h2>
                    <p class="section-subtitle light">Answer 3 questions and we'll suggest the best fit.</p>
                </div>
